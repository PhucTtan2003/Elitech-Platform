@{
    ViewData["Title"] = "📡 Elitech Realtime Monitor";
    var deviceGuids = (ViewBag.DeviceGuids as string) ?? "";
}

<style>
    :root {
        --rt-bg: #f5f5f7;
        --rt-ink: #0f172a;
        --rt-muted: #64748b;
        --rt-muted2: #94a3b8;
        --rt-line: rgba(148, 163, 184, .22);
        --rt-line2: rgba(255, 255, 255, .14);
        --rt-dark: #05070d;
        --rt-dark2: #10131c;
        --rt-dark3: #1d1f29;
        --rt-orange: #f58220;
        --rt-orange2: #ffb25b;
        --rt-blue: #2563eb;
        --rt-sky: #38bdf8;
        --rt-ok: #22c55e;
        --rt-warn: #f59e0b;
        --rt-bad: #ef4444;
        --rt-card: rgba(255, 255, 255, .86);
        --rt-shadow: 0 22px 70px rgba(15, 23, 42, .12);
        --rt-shadow2: 0 12px 34px rgba(15, 23, 42, .08);
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        max-width: 100%;
        overflow-x: hidden;
    }

    body {
        background: radial-gradient(900px 420px at 10% -5%, rgba(245,130,32,.16), transparent 58%), radial-gradient(920px 460px at 90% 0%, rgba(37,99,235,.15), transparent 62%), linear-gradient(180deg, #fbfbfd 0%, #f5f5f7 40%, #eef3fb 100%) !important;
        color: var(--rt-ink);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    }

    .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    .muted {
        color: var(--rt-muted);
    }

    .hide {
        display: none !important;
    }

    .rtx {
        position: relative;
        max-width: 1640px;
        margin: 0 auto;
        padding: 22px 18px 34px;
    }

    .rtx-hero {
        position: relative;
        min-height: 430px;
        overflow: hidden;
        border-radius: 38px;
        padding: 38px;
        color: #fff;
        background: radial-gradient(800px 360px at 82% 0%, rgba(245,130,32,.36), transparent 52%), radial-gradient(760px 420px at 6% 4%, rgba(56,189,248,.22), transparent 58%), linear-gradient(135deg, #05070d 0%, #10131c 45%, #071226 100%);
        border: 1px solid rgba(255,255,255,.12);
        box-shadow: 0 34px 100px rgba(5,7,13,.34);
    }

        .rtx-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 48px 48px;
            opacity: .36;
            pointer-events: none;
            mask-image: linear-gradient(90deg, #000, transparent 88%);
        }

        .rtx-hero::after {
            content: "";
            position: absolute;
            right: -170px;
            top: -190px;
            width: 520px;
            height: 520px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,.18);
            box-shadow: inset 0 0 0 28px rgba(255,255,255,.035), inset 0 0 0 72px rgba(255,255,255,.02), 0 0 80px rgba(245,130,32,.18);
            pointer-events: none;
        }

    .rtx-hero-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(360px, .72fr);
        gap: 28px;
        align-items: center;
    }

    .rtx-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 9px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.16);
        color: rgba(255,255,255,.88);
        font-size: .76rem;
        font-weight: 1000;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

        .rtx-kicker i {
            color: var(--rt-orange2);
        }

    .rtx-title {
        margin: 20px 0 0;
        max-width: 850px;
        font-size: clamp(3rem, 5vw, 5.8rem);
        line-height: .92;
        letter-spacing: -.075em;
        font-weight: 1000;
    }

        .rtx-title span {
            background: linear-gradient(90deg, #fff 0%, #dbeafe 34%, #ffb25b 76%, #f58220 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .rtx-sub {
        margin-top: 18px;
        max-width: 790px;
        color: rgba(226,232,240,.82);
        font-size: 1rem;
        line-height: 1.7;
        font-weight: 720;
    }

    .rtx-live-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 40px;
        padding: 0 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.16);
        color: rgba(255,255,255,.86);
        font-size: .82rem;
        font-weight: 1000;
        white-space: nowrap;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #94a3b8;
        box-shadow: 0 0 0 6px rgba(148,163,184,.13);
    }

        .dot.ok {
            background: var(--rt-ok);
            box-shadow: 0 0 0 6px rgba(34,197,94,.16);
        }

        .dot.warn {
            background: var(--rt-warn);
            box-shadow: 0 0 0 6px rgba(245,158,11,.14);
        }

        .dot.bad {
            background: var(--rt-bad);
            box-shadow: 0 0 0 6px rgba(239,68,68,.14);
        }

    .rtx-console {
        position: relative;
        overflow: hidden;
        border-radius: 34px;
        padding: 22px;
        min-height: 350px;
        background: radial-gradient(280px 160px at 82% 0%, rgba(245,130,32,.28), transparent 65%), linear-gradient(180deg, rgba(255,255,255,.13), rgba(255,255,255,.06));
        border: 1px solid rgba(255,255,255,.18);
        box-shadow: 0 24px 70px rgba(0,0,0,.30);
    }

        .rtx-console::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.05) 1px, transparent 1px);
            background-size: 34px 34px;
            opacity: .34;
            pointer-events: none;
        }

    .rtx-console-in {
        position: relative;
        z-index: 2;
    }

    .rtx-console-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
    }

    .rtx-console-title {
        color: #fff;
        font-size: 1.35rem;
        font-weight: 1000;
        letter-spacing: -.045em;
        line-height: 1.1;
    }

    .rtx-console-sub {
        margin-top: 7px;
        color: rgba(226,232,240,.70);
        font-weight: 760;
        font-size: .84rem;
    }

    .rtx-console-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 11px;
        border-radius: 999px;
        color: #fff;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.15);
        font-size: .78rem;
        font-weight: 1000;
        white-space: nowrap;
    }

    .rtx-bars {
        height: 132px;
        margin-top: 26px;
        display: flex;
        align-items: end;
        gap: 11px;
    }

    .rtx-bar {
        flex: 1;
        min-width: 16px;
        border-radius: 999px 999px 12px 12px;
        background: linear-gradient(180deg, #dbeafe, rgba(37,99,235,.35));
        box-shadow: 0 0 26px rgba(56,189,248,.16);
    }

        .rtx-bar:nth-child(3),
        .rtx-bar:nth-child(6) {
            background: linear-gradient(180deg, #ffb25b, rgba(245,130,32,.42));
            box-shadow: 0 0 26px rgba(245,130,32,.18);
        }

    .rtx-console-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-top: 18px;
    }

    .rtx-mini {
        min-height: 82px;
        border-radius: 22px;
        padding: 13px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.14);
    }

        .rtx-mini b {
            display: block;
            color: #fff;
            font-size: 1.08rem;
            line-height: 1;
            font-weight: 1000;
        }

        .rtx-mini span {
            display: block;
            margin-top: 8px;
            color: rgba(226,232,240,.72);
            font-size: .74rem;
            line-height: 1.26;
            font-weight: 760;
        }

    .rtx-kpis {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        margin-top: 16px;
    }

    .rtx-kpi {
        position: relative;
        overflow: hidden;
        min-height: 142px;
        border-radius: 28px;
        padding: 20px;
        background: rgba(255,255,255,.88);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: var(--rt-shadow2);
    }

        .rtx-kpi::after {
            content: "";
            position: absolute;
            right: -70px;
            bottom: -78px;
            width: 160px;
            height: 160px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(37,99,235,.17), transparent 70%);
        }

        .rtx-kpi.warn::after {
            background: radial-gradient(circle, rgba(245,130,32,.21), transparent 70%);
        }

        .rtx-kpi.ok::after {
            background: radial-gradient(circle, rgba(34,197,94,.18), transparent 70%);
        }

        .rtx-kpi.bad::after {
            background: radial-gradient(circle, rgba(239,68,68,.18), transparent 70%);
        }

        .rtx-kpi .k {
            position: relative;
            z-index: 2;
            color: var(--rt-muted);
            font-size: .72rem;
            font-weight: 1000;
            letter-spacing: .13em;
            text-transform: uppercase;
        }

        .rtx-kpi .v {
            position: relative;
            z-index: 2;
            margin-top: 12px;
            color: var(--rt-ink);
            font-size: 2.2rem;
            line-height: 1;
            font-weight: 1000;
            letter-spacing: -.055em;
        }

        .rtx-kpi .s {
            position: relative;
            z-index: 2;
            margin-top: 9px;
            color: var(--rt-muted2);
            font-size: .78rem;
            font-weight: 800;
        }

    .panel {
        margin-top: 18px;
        overflow: hidden;
        border-radius: 34px;
        background: rgba(255,255,255,.88);
        border: 1px solid rgba(255,255,255,.76);
        box-shadow: var(--rt-shadow);
    }

    .panel-hd {
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
        background: radial-gradient(500px 180px at 100% 0%, rgba(245,130,32,.16), transparent 58%), linear-gradient(180deg, rgba(255,255,255,.95), rgba(248,250,252,.88));
        border-bottom: 1px solid rgba(226,232,240,.90);
    }

        .panel-hd b {
            display: block;
            color: var(--rt-ink);
            font-size: 1.2rem;
            line-height: 1.15;
            font-weight: 1000;
            letter-spacing: -.04em;
        }

    .sub {
        margin-top: 6px;
        color: var(--rt-muted);
        font-size: .88rem;
        line-height: 1.48;
        font-weight: 760;
    }

    .meta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        color: var(--rt-muted);
        font-weight: 900;
        font-size: .84rem;
    }

    .body {
        padding: 20px;
    }

    .tools {
        display: grid;
        grid-template-columns: minmax(240px, 1.45fr) repeat(4, minmax(150px, .75fr)) auto auto;
        gap: 12px;
        align-items: end;
    }

    .field {
        display: grid;
        gap: 7px;
    }

        .field label {
            color: var(--rt-muted);
            font-size: .70rem;
            letter-spacing: .13em;
            text-transform: uppercase;
            font-weight: 1000;
        }

    .input,
    .select,
    .guidbox {
        width: 100%;
        border: 1px solid rgba(148,163,184,.28);
        background: #fff;
        border-radius: 18px;
        min-height: 46px;
        padding: 0 14px;
        color: var(--rt-ink);
        font-weight: 900;
        outline: none;
        box-shadow: 0 10px 22px rgba(15,23,42,.04);
        transition: .16s ease;
    }

        .input:focus,
        .select:focus,
        .guidbox:focus {
            border-color: rgba(245,130,32,.62);
            box-shadow: 0 0 0 4px rgba(245,130,32,.12);
        }

    .guidbox {
        height: 92px;
        resize: vertical;
        padding: 12px 14px;
        line-height: 1.42;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: .78rem;
    }

    .btn {
        min-height: 46px;
        border: 1px solid rgba(148,163,184,.28);
        background: #fff;
        color: var(--rt-ink);
        padding: 0 15px;
        border-radius: 18px;
        font-weight: 1000;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(15,23,42,.06);
        white-space: nowrap;
        transition: .16s ease;
    }

        .btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(15,23,42,.10);
        }

        .btn.primary {
            border-color: transparent;
            background: linear-gradient(135deg, var(--rt-orange), var(--rt-orange2));
            color: #111827;
        }

        .btn.ghost {
            border-color: rgba(245,130,32,.40);
            color: #a94d0e;
            background: rgba(255,255,255,.92);
        }

        .btn:disabled {
            opacity: .52;
            cursor: not-allowed;
            transform: none;
        }

    .guid-panel {
        margin-top: 14px;
        border-radius: 24px;
        border: 1px solid rgba(226,232,240,.95);
        background: radial-gradient(420px 160px at 100% 0%, rgba(37,99,235,.07), transparent 60%), #f8fafc;
        padding: 15px;
    }

        .guid-panel summary {
            cursor: pointer;
            color: #334155;
            font-size: .9rem;
            font-weight: 1000;
        }

    .viewbar {
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        padding: 6px;
        border-radius: 999px;
        background: #f1f5f9;
        border: 1px solid rgba(226,232,240,.95);
    }

    .tab {
        min-height: 38px;
        padding: 0 14px;
        border-radius: 999px;
        border: 0;
        background: transparent;
        color: #475569;
        font-size: .84rem;
        font-weight: 1000;
        cursor: pointer;
        transition: .14s ease;
    }

        .tab.active {
            background: #fff;
            color: #111827;
            box-shadow: 0 10px 22px rgba(15,23,42,.08);
        }

    .content {
        margin-top: 14px;
    }

    .empty {
        padding: 28px !important;
        border-radius: 24px;
        background: #f8fafc;
        border: 1px solid rgba(226,232,240,.95);
        color: var(--rt-muted) !important;
        font-weight: 900;
        text-align: center;
    }

    .table-wrap {
        overflow: auto;
        border-radius: 26px;
        border: 1px solid rgba(226,232,240,.95);
        background: #fff;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
    }

    .table {
        width: 100%;
        min-width: 1120px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table th {
            position: sticky;
            top: 0;
            z-index: 1;
            padding: 14px 13px;
            text-align: left;
            background: #f8fafc;
            color: #64748b;
            font-size: .68rem;
            letter-spacing: .13em;
            text-transform: uppercase;
            font-weight: 1000;
            border-bottom: 1px solid rgba(226,232,240,.95);
            white-space: nowrap;
        }

        .table td {
            padding: 13px;
            border-bottom: 1px solid rgba(226,232,240,.78);
            color: var(--rt-ink);
            font-size: .86rem;
            font-weight: 850;
            white-space: nowrap;
            vertical-align: middle;
        }

        .table tbody tr:hover td {
            background: #fff7ed;
        }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        padding: 7px 10px;
        font-weight: 1000;
        font-size: .74rem;
        border: 1px solid transparent;
    }

        .status::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #cbd5e1;
        }

        .status.ok {
            color: #047857;
            background: #ecfdf5;
            border-color: rgba(16,185,129,.25);
        }

            .status.ok::before {
                background: var(--rt-ok);
            }

        .status.warn {
            color: #92400e;
            background: #fffbeb;
            border-color: rgba(245,158,11,.28);
        }

            .status.warn::before {
                background: var(--rt-warn);
            }

        .status.alarm {
            color: #991b1b;
            background: #fef2f2;
            border-color: rgba(239,68,68,.25);
        }

            .status.alarm::before {
                background: var(--rt-bad);
            }

        .status.nodata {
            color: #475569;
            background: #f1f5f9;
            border-color: rgba(148,163,184,.30);
        }

            .status.nodata::before {
                background: #94a3b8;
            }

    .v-bad {
        color: #b91c1c;
    }

    .v-good {
        color: #047857;
    }

    .v-warn {
        color: #92400e;
    }

    .compact-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 12px;
    }

    .compact-card {
        border-radius: 26px;
        border: 1px solid rgba(226,232,240,.95);
        background: #fff;
        box-shadow: var(--rt-shadow2);
        padding: 16px;
        min-width: 0;
        transition: .16s ease;
    }

        .compact-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 38px rgba(15,23,42,.12);
        }

    .cc-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }

    .cc-name {
        max-width: 165px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--rt-ink);
        font-weight: 1000;
        line-height: 1.16;
    }

    .cc-guid {
        margin-top: 5px;
        color: var(--rt-muted);
        font-size: .72rem;
        font-weight: 900;
        overflow-wrap: anywhere;
    }

    .cc-values {
        margin-top: 14px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
    }

    .tile {
        border-radius: 18px;
        border: 1px solid rgba(148,163,184,.18);
        background: #f8fafc;
        padding: 10px;
    }

        .tile .k {
            color: var(--rt-muted);
            font-size: .64rem;
            text-transform: uppercase;
            font-weight: 1000;
            letter-spacing: .13em;
        }

        .tile .v {
            margin-top: 6px;
            color: var(--rt-ink);
            font-size: .98rem;
            line-height: 1.35;
            font-weight: 1000;
        }

    .full-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 14px;
    }

    .full-card {
        overflow: hidden;
        border-radius: 28px;
        border: 1px solid rgba(226,232,240,.95);
        background: #fff;
        box-shadow: var(--rt-shadow2);
        transition: .16s ease;
    }

        .full-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 38px rgba(15,23,42,.12);
        }

    .fc-head {
        padding: 17px;
        border-bottom: 1px solid rgba(226,232,240,.9);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        background: radial-gradient(340px 130px at 100% 0%, rgba(245,130,32,.09), transparent 60%), #fff;
    }

    .fc-name {
        color: var(--rt-ink);
        font-size: 1.04rem;
        line-height: 1.16;
        font-weight: 1000;
    }

    .fc-guid {
        margin-top: 6px;
        color: var(--rt-muted);
        font-size: .76rem;
        font-weight: 900;
        overflow-wrap: anywhere;
    }

    .fc-body {
        padding: 17px;
        display: grid;
        gap: 11px;
    }

    .sensor-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .sensor {
        border-radius: 19px;
        border: 1px solid rgba(148,163,184,.18);
        background: #f8fafc;
        padding: 12px;
    }

        .sensor .k {
            color: var(--rt-muted);
            font-size: .64rem;
            text-transform: uppercase;
            font-weight: 1000;
            letter-spacing: .13em;
        }

        .sensor .v {
            margin-top: 7px;
            color: var(--rt-ink);
            font-size: 1.05rem;
            line-height: 1.32;
            font-weight: 1000;
        }

    .fc-foot {
        border-top: 1px solid rgba(226,232,240,.9);
        padding: 12px 17px;
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        color: var(--rt-muted);
        font-size: .78rem;
        font-weight: 900;
        background: #fbfdff;
    }

    .pager {
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .pager-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    @@media (max-width: 1280px) {
        .rtx-hero-grid {
