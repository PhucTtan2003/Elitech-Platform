    function mergeMissingDevices(rows, requestedGuids, missingGuids) { rows = Array.isArray(rows) ? rows : []; const returned = new Set(rows.map(x => normGuid(x.deviceGuid)).filter(Boolean)); const missing = (Array.isArray(missingGuids) && missingGuids.length ? missingGuids : (requestedGuids || []).filter(g => !returned.has(normGuid(g)))); return [...rows, ...missing.filter(g => !returned.has(normGuid(g))).map(g => ({ deviceGuid: g, deviceName: "Thiết bị chưa có realtime", __missingRealtime: true }))]; }
