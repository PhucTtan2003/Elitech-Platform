<div class="rtx">
    <section class="rtx-hero">
        <div class="rtx-hero-grid">
            <div>
                <div class="rtx-kicker">
                    <i class="bi bi-broadcast-pin"></i>
                    Elitech Realtime Command
                </div>

                <h1 class="rtx-title">
                    Theo dõi thiết bị <span>Realtime</span>
                </h1>

                <div class="rtx-sub">
                    Dashboard realtime dành cho Admin: load nhanh danh sách thiết bị, lọc trạng thái,
                    tìm theo tên/GUID, chuyển Table - Compact - Full Cards và xuất CSV khi cần đối soát dữ liệu.
                </div>

                <div class="rtx-live-row">
                    <span class="pill"><span class="dot ok"></span> Live polling</span>
                    <span class="pill"><span class="dot warn"></span> 200+ devices ready</span>
                    <span class="pill"><i class="bi bi-clock-history"></i> <span id="lastUpdateTop">—</span></span>
                </div>
            </div>

            <div class="rtx-console">
                <div class="rtx-console-in">
                    <div class="rtx-console-head">
                        <div>
                            <div class="rtx-console-title">Cloud Signal Deck</div>
                            <div class="rtx-console-sub">Temperature • Humidity • Power • Signal</div>
                        </div>
                        <div class="rtx-console-badge"><span class="dot ok"></span> Online</div>
                    </div>

                    <div class="rtx-bars" aria-hidden="true">
                        <div class="rtx-bar" style="height:43%;"></div>
                        <div class="rtx-bar" style="height:72%;"></div>
                        <div class="rtx-bar" style="height:58%;"></div>
                        <div class="rtx-bar" style="height:91%;"></div>
                        <div class="rtx-bar" style="height:65%;"></div>
                        <div class="rtx-bar" style="height:80%;"></div>
                        <div class="rtx-bar" style="height:50%;"></div>
                    </div>

                    <div class="rtx-console-grid">
                        <div class="rtx-mini"><b>Table</b><span>View nhanh cho nhiều thiết bị</span></div>
                        <div class="rtx-mini"><b>Cards</b><span>Xem thông số trực quan</span></div>
                        <div class="rtx-mini"><b>Filter</b><span>Ưu tiên alarm và no data</span></div>
                        <div class="rtx-mini"><b>CSV</b><span>Xuất dữ liệu kiểm tra</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="rtx-kpis">
        <div class="rtx-kpi"><div class="k">Tổng thiết bị</div><div class="v" id="kpiTotal">0</div><div class="s">sau khi load realtime</div></div>
        <div class="rtx-kpi ok"><div class="k">OK</div><div class="v" id="kpiOk">0</div><div class="s">trong ngưỡng demo</div></div>
        <div class="rtx-kpi warn"><div class="k">Alarm/Warn</div><div class="v" id="kpiAlarm">0</div><div class="s">vượt ngưỡng demo</div></div>
        <div class="rtx-kpi bad"><div class="k">No data</div><div class="v" id="kpiNoData">0</div><div class="s">Elitech chưa trả data</div></div>
        <div class="rtx-kpi"><div class="k">Đang hiển thị</div><div class="v" id="kpiFiltered">0</div><div class="s">sau lọc/tìm kiếm</div></div>
    </section>

    <section class="panel">
        <div class="panel-hd">
            <div>
                <b>Control Panel</b>
                <div class="sub">Mặc định dùng danh sách thiết bị từ quyền user/admin. Chỉ nhập GUID khi cần override nhanh.</div>
            </div>
            <div class="meta">
                <span>Interval: <span class="mono" id="tickSec">—</span></span>
                <span>•</span>
                <span>Page: <span class="mono" id="pageInfoTop">—</span></span>
            </div>
        </div>

        <div class="body">
            <form id="realtimeForm">
                <div class="tools">
                    <div class="field">
                        <label>Tìm thiết bị</label>
                        <input id="searchInput" type="search" class="input" placeholder="Tên, GUID, địa chỉ..." autocomplete="off" />
                    </div>

                    <div class="field">
                        <label>Trạng thái</label>
                        <select id="statusFilter" class="select">
                            <option value="all">Tất cả</option>
                            <option value="alarm">Alarm</option>
                            <option value="warn">Warn</option>
                            <option value="ok">OK</option>
                            <option value="nodata">No data</option>
                        </select>
                    </div>

                    <div class="field">
                        <label>Sắp xếp</label>
                        <select id="sortBy" class="select">
                            <option value="status">Alarm trước</option>
                            <option value="name">Tên A-Z</option>
                            <option value="temp_desc">Nhiệt cao nhất</option>
                            <option value="last_desc">Mới cập nhật</option>
                        </select>
                    </div>

                    <div class="field">
                        <label>Page size</label>
                        <select id="pageSize" class="select">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="200">200</option>
                        </select>
                    </div>

                    <div class="field">
                        <label>View</label>
                        <select id="viewMode" class="select">
                            <option value="table">Table nhanh</option>
                            <option value="compact">Compact card</option>
                            <option value="full">Full card</option>
                        </select>
                    </div>

                    <button class="btn primary" type="submit"><i class="bi bi-download"></i> Load</button>
                    <button class="btn ghost" type="button" id="btnExport"><i class="bi bi-filetype-csv"></i> CSV</button>
                </div>

                <details class="guid-panel">
                    <summary>GUID nguồn / override thủ công</summary>
                    <div style="margin-top:12px;display:grid;gap:9px;">
                        <textarea id="guidInput" name="deviceGuids" class="guidbox" placeholder="GUID1,GUID2,GUID3...">@deviceGuids</textarea>
                        <div class="meta">Đang dùng <span class="mono" id="guidCount">0</span> GUID từ ViewBag/query. Để trống rồi Load sẽ gọi API realtime theo quyền user/admin.</div>
                    </div>
                </details>
            </form>

            <div class="viewbar">
                <div class="tabs">
                    <button class="tab active" type="button" data-mode="table"><i class="bi bi-table"></i> Table</button>
                    <button class="tab" type="button" data-mode="compact"><i class="bi bi-grid-3x3-gap"></i> Compact</button>
                    <button class="tab" type="button" data-mode="full"><i class="bi bi-card-list"></i> Full cards</button>
                </div>
                <div class="meta" id="resultMeta">Chưa có dữ liệu</div>
            </div>

            <div class="content">
                <div id="tableView" class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Thiết bị</th>
                                <th>GUID</th>
                                <th>Temp</th>
                                <th>Hum</th>
                                <th>Power</th>
                                <th>Signal</th>
                                <th>Last session</th>
                                <th>Address</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <tr><td colspan="9" class="empty">Chưa có dữ liệu…</td></tr>
                        </tbody>
                    </table>
                </div>

                <div id="compactView" class="compact-grid hide"></div>
                <div id="fullView" class="full-grid hide"></div>
            </div>

            <div class="pager">
                <div class="meta" id="pageInfo">—</div>
                <div class="pager-actions">
                    <button class="btn" type="button" id="btnFirst">Đầu</button>
                    <button class="btn" type="button" id="btnPrev">Trước</button>
                    <button class="btn" type="button" id="btnNext">Sau</button>
                    <button class="btn" type="button" id="btnLast">Cuối</button>
                    <button class="btn ghost" type="button" id="btnRefresh"><i class="bi bi-arrow-repeat"></i> Refresh</button>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    const initialDeviceGuids = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(deviceGuids));
    const qs = new URLSearchParams(window.location.search);
    const els = {
        guidInput: document.getElementById("guidInput"), guidCount: document.getElementById("guidCount"), searchInput: document.getElementById("searchInput"), statusFilter: document.getElementById("statusFilter"), sortBy: document.getElementById("sortBy"), pageSize: document.getElementById("pageSize"), viewMode: document.getElementById("viewMode"), form: document.getElementById("realtimeForm"),
        tableView: document.getElementById("tableView"), tableBody: document.getElementById("tableBody"), compactView: document.getElementById("compactView"), fullView: document.getElementById("fullView"),
        kpiTotal: document.getElementById("kpiTotal"), kpiOk: document.getElementById("kpiOk"), kpiAlarm: document.getElementById("kpiAlarm"), kpiNoData: document.getElementById("kpiNoData"), kpiFiltered: document.getElementById("kpiFiltered"),
        resultMeta: document.getElementById("resultMeta"), pageInfo: document.getElementById("pageInfo"), pageInfoTop: document.getElementById("pageInfoTop"), lastUpdateTop: document.getElementById("lastUpdateTop"), tickSec: document.getElementById("tickSec"),
        btnExport: document.getElementById("btnExport"), btnRefresh: document.getElementById("btnRefresh"), btnFirst: document.getElementById("btnFirst"), btnPrev: document.getElementById("btnPrev"), btnNext: document.getElementById("btnNext"), btnLast: document.getElementById("btnLast")
