    function currentGuidString() { return (els.guidInput?.value || "").trim(); }
    function updateGuidCount() { els.guidCount.textContent = String(splitGuidString(currentGuidString()).length); }
    function getTotalPages() { return Math.max(1, Math.ceil(state.filtered.length / state.pageSize)); }
    function getPageRows() { const start = (state.page - 1) * state.pageSize; return state.filtered.slice(start, start + state.pageSize); }

    function tempHtml(r) { const vals = [r.tmp1, r.tmp2, r.tmp3, r.tmp4].map((raw, i) => ({ raw, v: asNumber(raw), label: `T${i + 1}` })).filter(x => x.v !== null); if (!vals.length) return `<span class="muted">—</span>`; return vals.map(x => `<span class="${x.v < 2 || x.v > 8 ? "v-bad" : "v-good"}">${x.label}: ${esc(fmt(x.raw))}</span>`).join(" · "); }
