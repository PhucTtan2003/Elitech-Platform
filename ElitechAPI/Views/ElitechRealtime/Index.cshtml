    function renderPager() { const tp = getTotalPages(); const start = state.filtered.length ? ((state.page - 1) * state.pageSize + 1) : 0; const end = Math.min(state.page * state.pageSize, state.filtered.length); const text = `${start}-${end} / ${state.filtered.length} thiết bị • Trang ${state.page}/${tp}`; els.pageInfo.textContent = text; els.pageInfoTop.textContent = `${state.page}/${tp}`; els.resultMeta.textContent = `${state.filtered.length} kết quả sau lọc • tổng ${state.rows.length}`; els.btnFirst.disabled = state.page <= 1; els.btnPrev.disabled = state.page <= 1; els.btnNext.disabled = state.page >= tp; els.btnLast.disabled = state.page >= tp; }
    function renderViewsVisibility() { els.tableView.classList.toggle("hide", state.view !== "table"); els.compactView.classList.toggle("hide", state.view !== "compact"); els.fullView.classList.toggle("hide", state.view !== "full"); document.querySelectorAll(".tab").forEach(b => b.classList.toggle("active", b.dataset.mode === state.view)); if (els.viewMode.value !== state.view) els.viewMode.value = state.view; }

    function renderTable(rows) { if (!rows.length) { els.tableBody.innerHTML = `<tr><td colspan="9" class="empty">Không có dữ liệu phù hợp.</td></tr>`; return; } els.tableBody.innerHTML = rows.map(x => `<tr><td><span class="status ${esc(x.__status)}">${statusLabel(x.__status)}</span></td><td>${esc(x.__name)}</td><td><span class="mono">${esc(x.__guid)}</span></td><td>${tempHtml(x)}</td><td>${humHtml(x)}</td><td><span class="mono">${esc(fmt(x.power))}</span></td><td><span class="mono">${esc(fmt(x.signal))}</span></td><td><span class="mono">${esc(tsSecToLocal(x.lastSessionTime))}</span></td><td>${esc(fmt(x.address))}</td></tr>`).join(""); }
    function renderCompact(rows) { if (!rows.length) { els.compactView.innerHTML = `<div class="empty">Không có dữ liệu phù hợp.</div>`; return; } els.compactView.innerHTML = rows.map(x => `<article class="compact-card"><div class="cc-top"><div style="min-width:0"><div class="cc-name">${esc(x.__name)}</div><div class="cc-guid mono">${esc(x.__guid)}</div></div><span class="status ${esc(x.__status)}">${statusLabel(x.__status)}</span></div><div class="cc-values"><div class="tile"><div class="k">Temp</div><div class="v">${tempHtml(x)}</div></div><div class="tile"><div class="k">Hum</div><div class="v">${humHtml(x)}</div></div><div class="tile"><div class="k">Power</div><div class="v mono">${esc(fmt(x.power))}</div></div><div class="tile"><div class="k">Signal</div><div class="v mono">${esc(fmt(x.signal))}</div></div></div></article>`).join(""); }
