    function toCsv(rows) { const header = ["status", "deviceName", "deviceGuid", "tmp1", "tmp2", "tmp3", "tmp4", "hum1", "hum2", "power", "signal", "address", "lastSessionTime"]; const lines = [header.join(",")]; (rows || []).forEach(x => { const vals = header.map(k => { let v = k === "status" ? x.__status : x?.[k]; if (k === "lastSessionTime") v = tsSecToLocal(v); const s = v == null ? "" : String(v); return `"${s.replaceAll('"', '""')}"`; }); lines.push(vals.join(",")); }); return lines.join("\n"); }
