    function debounce(fn, delay) { let t = null; return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), delay); }; }

    els.pageSize.value = String(state.pageSize); els.viewMode.value = state.view; els.guidInput.value = qs.get("deviceGuids") ?? initialDeviceGuids ?? ""; updateGuidCount();
    els.form.addEventListener("submit", e => { e.preventDefault(); loadOnce(); });
    els.searchInput.addEventListener("input", debounce(() => { state.page = 1; applyFilters(); }, 180));
    els.statusFilter.addEventListener("change", () => { state.page = 1; applyFilters(); });
    els.sortBy.addEventListener("change", () => { state.page = 1; applyFilters(); });
    els.pageSize.addEventListener("change", () => { state.pageSize = Number(els.pageSize.value || "25"); localStorage.setItem("elitechRealtime.pageSize", String(state.pageSize)); state.page = 1; applyFilters(); });
    els.viewMode.addEventListener("change", () => setView(els.viewMode.value));
    document.querySelectorAll(".tab").forEach(btn => btn.addEventListener("click", () => setView(btn.dataset.mode)));
    els.guidInput.addEventListener("input", updateGuidCount);
    els.btnFirst.addEventListener("click", () => { state.page = 1; renderAll(); });
    els.btnPrev.addEventListener("click", () => { state.page = Math.max(1, state.page - 1); renderAll(); });
    els.btnNext.addEventListener("click", () => { state.page = Math.min(getTotalPages(), state.page + 1); renderAll(); });
    els.btnLast.addEventListener("click", () => { state.page = getTotalPages(); renderAll(); });
    els.btnRefresh.addEventListener("click", loadOnce); els.btnExport.addEventListener("click", exportCsv);
    const INTERVAL_MS = 180000; els.tickSec.textContent = `${INTERVAL_MS / 1000}s`; renderViewsVisibility(); loadOnce(); const timer = setInterval(loadOnce, INTERVAL_MS); window.addEventListener("beforeunload", () => clearInterval(timer));
</script>
