<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {

    // ===== INIT CONFIG =====
    window.__ELITECH_HISTORY__ = {
    isAdmin: @((isAdmin) ? "true" : "false"),
    baseUrl: '@Url.Content("~/")'
    };

    const alarmBox = document.getElementById("alarmBox");

    // 🔊 SOUND
    const alarmSound = new Audio("https://actions.google.com/sounds/v1/alarms/alarm_clock.ogg");

    function checkAlarm(temp){
    const threshold = 30;

    if(temp > threshold){
    if(alarmBox){
    alarmBox.style.display = "block";
    alarmBox.classList.add("blink");
    }
    alarmSound.play().catch(()=>{});
    }else{
    if(alarmBox){
    alarmBox.style.display = "none";
    alarmBox.classList.remove("blink");
    }
    }
    }

    // ===== HOOK DATA (ALARM) =====
    (function(){
    const oldPush = Array.prototype.push;

    Array.prototype.push = function(...args){
    args.forEach(v=>{
    if(typeof v === "number"){
    checkAlarm(v);
    }
    });
    return oldPush.apply(this,args);
    };
    })();

    // ===== RANGE DEFAULT (24H) =====
    const fromDate = document.getElementById("fromDate");
    const toDate = document.getElementById("toDate");

    if(fromDate && toDate){
    const now = new Date();
    const before = new Date();
    before.setHours(now.getHours() - 24);

    fromDate.value = before.toISOString().slice(0,16);
    toDate.value = now.toISOString().slice(0,16);
    }

    // ===== LOAD DATA =====
    async function loadHistory(){

    const deviceSelect = document.getElementById("deviceSelect");
    const deviceGuid = deviceSelect ? deviceSelect.value : null;

    const from = fromDate ? fromDate.value : null;
    const to = toDate ? toDate.value : null;

    if(!deviceGuid){
    alert("Chọn thiết bị!");
    return;
    }

    let url = `/api/elitech/history?deviceGuid=${deviceGuid}`;

    if(from && to){
    url += `&from=${from}&to=${to}`;
    }

    console.log("CALL API:", url);

    try{
    const res = await fetch(url);

    if(!res.ok){
    throw new Error("API lỗi");
    }

    const json = await res.json();

    const data = json.data || [];

    console.log("DATA:", data);

    // 👉 bạn đã có sẵn
    renderChart(data);
    renderTable(data);

    }catch(err){
    console.error(err);
    alert("Không load được dữ liệu");
    }
    }

    // ===== BUTTON FILTER =====
    const btnFilter = document.getElementById("btnFilter");
    if(btnFilter){
    btnFilter.addEventListener("click", () => {
    loadHistory();
    });
    }

    // ===== QUICK RANGE =====
    window.quickRange = function(hours){
    const now = new Date();
    const before = new Date();

    before.setHours(now.getHours() - hours);

    fromDate.value = before.toISOString().slice(0,16);
    toDate.value = now.toISOString().slice(0,16);

    loadHistory();
    }

    // ===== EXPORT PDF =====
    const btnPdf = document.getElementById("btnExportPdf");

    if(btnPdf){
    btnPdf.addEventListener("click", async () => {

    console.log("CLICK PDF");

    const canvas = document.getElementById("chartTemp");
    if(!canvas){
    alert("Không tìm thấy chart");
    return;
    }

    await new Promise(r => setTimeout(r, 300));

    const chartImage = canvas.toDataURL("image/png");

    const table = document.getElementById("tbl");
    if(!table){
    alert("Không tìm thấy bảng");
    return;
    }

    const tableHtml = table.outerHTML;

    const from = fromDate ? fromDate.value : null;
    const to = toDate ? toDate.value : null;

    try{
    const res = await fetch("/export/pdf", {
    method: "POST",
    headers: {
    "Content-Type": "application/json"
    },
    body: JSON.stringify({
    chartImage,
    tableHtml,
    from,
    to
    })
    });

    if(!res.ok){
    throw new Error("API lỗi");
    }

    const blob = await res.blob();
    const url = window.URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;
    a.download = "Elitech Report.pdf";
    a.click();

    }catch(err){
    console.error(err);
    alert("Xuất PDF thất bại");
    }
    });
    }

    // ===== AUTO LOAD FIRST =====
    loadHistory();

    });
</script>
<script src="~/js/elitech-history.js" asp-append-version="true"></script>
