    /* ===== Device list modes: vertical / horizontal / grid / compact ===== */
    .device-toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 10px;
        margin-bottom: 12px;
    }

    .device-mode-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }

    .device-mode-group {
        display: inline-flex;
        gap: 8px;
        padding: 6px;
        border-radius: 18px;
        background: rgba(248,250,252,.92);
        border: 1px solid rgba(148,163,184,.18);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
    }

    .device-mode-btn {
        min-height: 34px;
        border: 1px solid transparent;
        border-radius: 14px;
        background: transparent;
        color: #475569;
        font-weight: 950;
        font-size: .78rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 0 10px;
        cursor: pointer;
        transition: transform .14s ease, background .14s ease, color .14s ease, border-color .14s ease, box-shadow .14s ease;
        white-space: nowrap;
    }

        .device-mode-btn:hover,
        .device-mode-btn.is-active {
            transform: translateY(-1px);
            color: #0f172a;
            background: #fff;
            border-color: rgba(37,99,235,.18);
            box-shadow: 0 10px 20px rgba(15,23,42,.07);
