<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>
    let _toastSeq = 0;
    let _toastReceived = 0;

    function escapeHtml(s) {
        return (s ?? "").toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function toneToDot(level) {
        const s = (level || "").toLowerCase();
        if (s === "high" || s === "bad" || s === "error") return "bad";
        if (s === "warn" || s === "warning") return "warn";
        return "ok";
    }

    function fmtToastTime(ts) {
        if (!ts) return new Date().toLocaleString();
        const n = Number(ts);
        if (!Number.isFinite(n)) return new Date().toLocaleString();
        return new Date(n > 3000000000 ? n : n * 1000).toLocaleString();
    }

    function updateToastMetric() {
        const c = document.getElementById("toastCount");
        const m = document.getElementById("metricToasts");
        if (c) c.textContent = String(_toastReceived);
        if (m) m.textContent = String(_toastReceived);
    }


    /* =========================================================
       USER PAGE ALARM SOUND FIX
       Lý do: trang User nhận SignalR alert.toast riêng, nhưng code cũ chỉ show toast
       và không gọi audio. Khối này phát /sounds/alarm.mp3 khi có alert.toast.
       ========================================================= */
    const _userAlarmAudio = new Audio('/sounds/alarm.mp3');
    _userAlarmAudio.preload = 'auto';
    _userAlarmAudio.volume = 0.88;

    let _userAlarmUnlocked = false;
    let _userAlarmPending = false;

    function ensureUserAlarmUnlockButton() {
        let btn = document.getElementById('userAlarmUnlockBtn');
        if (btn) return btn;

        btn = document.createElement('button');
        btn.id = 'userAlarmUnlockBtn';
        btn.type = 'button';
        btn.innerHTML = '<i class="bi bi-volume-up-fill"></i><span>Bật âm thanh cảnh báo</span>';
        btn.style.cssText = 'position:fixed;left:18px;bottom:18px;z-index:100000;min-height:46px;padding:0 16px;border-radius:999px;border:1px solid rgba(255,255,255,.20);background:linear-gradient(135deg,#f58220,#ffb25b);color:#111827;font-weight:1000;box-shadow:0 18px 44px rgba(15,23,42,.24);display:none;align-items:center;gap:9px;cursor:pointer;';
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            unlockUserAlarmAudio();
        });
        document.body.appendChild(btn);
        return btn;
    }

    function showUserAlarmUnlockButton() {
        ensureUserAlarmUnlockButton().style.display = 'inline-flex';
    }

    function hideUserAlarmUnlockButton() {
        const btn = document.getElementById('userAlarmUnlockBtn');
        if (btn) btn.style.display = 'none';
    }

    async function unlockUserAlarmAudio() {
        if (_userAlarmUnlocked) return;

        try {
            await _userAlarmAudio.play();
            _userAlarmAudio.pause();
            _userAlarmAudio.currentTime = 0;
            _userAlarmUnlocked = true;
            hideUserAlarmUnlockButton();

            if (_userAlarmPending) {
                _userAlarmPending = false;
                playUserAlarmSound();
            }
        } catch (err) {
            _userAlarmUnlocked = false;
            showUserAlarmUnlockButton();
            console.warn('User alarm audio blocked:', err);
        }
    }

    function playUserAlarmSound() {
        if (!_userAlarmUnlocked) {
            _userAlarmPending = true;
            showUserAlarmUnlockButton();
            unlockUserAlarmAudio();
            return;
        }

        try {
            _userAlarmAudio.pause();
            _userAlarmAudio.currentTime = 0;
            const promise = _userAlarmAudio.play();
            if (promise && typeof promise.catch === 'function') {
                promise.catch(err => {
                    _userAlarmUnlocked = false;
                    _userAlarmPending = true;
                    showUserAlarmUnlockButton();
                    console.warn('User alarm play blocked:', err);
                });
            }

            setTimeout(() => {
                try {
                    _userAlarmAudio.pause();
                    _userAlarmAudio.currentTime = 0;
                } catch { }
            }, 7500);
        } catch { }
    }

    window.addEventListener('pointerdown', unlockUserAlarmAudio, { passive: true });
    window.addEventListener('keydown', unlockUserAlarmAudio);
    window.addEventListener('touchstart', unlockUserAlarmAudio, { passive: true });

    function showToast(payload) {
        const wrap = document.getElementById("toastWrap");
        if (!wrap) return;

        _toastReceived++;
        updateToastMetric();
        playUserAlarmSound();

        const id = "t" + (++_toastSeq);
        const dot = toneToDot(payload?.level);
        const title = payload?.title || "Cảnh báo";
        const msg = payload?.message || "";
        const device = payload?.deviceName || payload?.deviceGuid || "";
        const time = fmtToastTime(payload?.ts);

        const el = document.createElement("div");
        el.className = "toast";
        el.id = id;
        el.innerHTML = `
            <div class="hd">
            <div class="title">
            <span class="t-dot ${dot}"></span>
            <span>${escapeHtml(title)}</span>
            </div>
            <button class="close" title="Close">×</button>
            </div>
            <div class="bd">
            ${escapeHtml(msg)}
            <div class="meta">
            <span>${escapeHtml(device)}</span>
            <span>${escapeHtml(time)}</span>
            </div>
            </div>
            `;

        el.querySelector(".close").addEventListener("click", () => removeToast(id));
        wrap.prepend(el);

        setTimeout(() => removeToast(id), 6500);

        while (wrap.children.length > 4) {
            wrap.removeChild(wrap.lastElementChild);
        }
    }

    function removeToast(id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.style.opacity = "0";
        el.style.transform = "translateY(-6px)";
        setTimeout(() => el.remove(), 160);
    }

    let _hub = null;
    let _srConnectedAt = null;

    function setSrState(text, tone) {
        const t = (tone || "").toLowerCase();

        const stateEl = document.getElementById("srState");
        if (stateEl) stateEl.textContent = text;

        const badge = document.getElementById("srBadge");
        const bar = document.getElementById("srBarFill");
        const since = document.getElementById("srSince");

        if (badge) {
            badge.classList.remove("sr-ok", "sr-warn", "sr-bad");
            badge.classList.add(t === "ok" ? "sr-ok" : t === "bad" ? "sr-bad" : "sr-warn");
        }

        if (bar) {
            bar.style.opacity = (t === "ok") ? ".88" : ".95";
            bar.style.filter = (t === "bad") ? "saturate(1.2)" : "none";
        }

        if (t === "ok") {
            if (!_srConnectedAt) _srConnectedAt = Date.now();
        } else {
            _srConnectedAt = null;
        }

        if (since) {
            if (!_srConnectedAt) {
                since.textContent = "—";
            } else {
                const sec = Math.floor((Date.now() - _srConnectedAt) / 1000);
                since.textContent = sec < 60 ? `${sec}s` : `${Math.floor(sec / 60)}m ${sec % 60}s`;
            }
        }
    }

    setInterval(() => {
        const badge = document.getElementById("srBadge");
        if (!badge) return;

        if (badge.classList.contains("sr-ok")) {
            setSrState(document.getElementById("srState")?.textContent || "Live connected", "ok");
        }
    }, 1000);

    async function startHub() {
        if (_hub) return;

        _hub = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/alarm")
            .withAutomaticReconnect()
            .build();

        _hub.onreconnecting(() => setSrState("Reconnecting…", "warn"));
        _hub.onreconnected(() => setSrState("Live connected", "ok"));
        _hub.onclose(() => setSrState("Disconnected", "bad"));
        _hub.on("alert.toast", (payload) => showToast(payload));

        await _hub.start();
        setSrState("Live connected", "ok");
    }

    (function initSignalR() {
        startHub().catch(() => setSrState("Disconnected", "bad"));
    })();

    (function commonActions() {
        const btnRefresh = document.getElementById("btnRefresh");
        const btnClearToasts = document.getElementById("btnClearToasts");
        const toastWrap = document.getElementById("toastWrap");

        if (btnRefresh) btnRefresh.addEventListener("click", () => location.reload());

        if (btnClearToasts && toastWrap) {
            btnClearToasts.addEventListener("click", () => {
                toastWrap.innerHTML = "";
                _toastReceived = 0;
                updateToastMetric();
            });
        }
    })();

    (function deviceDashboard() {
        const devices = window.__USER_DEVICES__ || [];
        const sel = document.getElementById("rtDeviceSelect");
        const host = document.getElementById("rtCardHost");
        const last = document.getElementById("rtLastUpdate");
        const btn = document.getElementById("rtRefreshBtn");
        const metricDevices = document.getElementById("metricDevices");
        const metricPreview = document.getElementById("metricPreview");
        const metricNow = document.getElementById("metricNow");
        const deviceListHost = document.getElementById("deviceListHost");
        const deviceSearch = document.getElementById("deviceSearch");
        const deviceListCount = document.getElementById("deviceListCount");
        const deviceViewButtons = Array.from(document.querySelectorAll("[data-device-view]"));
        const deviceScrollHint = document.getElementById("deviceScrollHint");
        const activeDeviceName = document.getElementById("activeDeviceName");
        const activeDeviceGuid = document.getElementById("activeDeviceGuid");

        function toItem(d) {
            const guid = (d?.deviceGuid || d?.DeviceGuid || d?.guid || d?.Guid || "").toString().trim();
            const name = (d?.deviceName || d?.DeviceName || d?.name || d?.Name || "Device").toString().trim();
            return { guid, name };
        }

        const items = devices
            .map(toItem)
            .filter(x => x.guid)
            .filter((x, idx, arr) => arr.findIndex(y => y.guid.toUpperCase() === x.guid.toUpperCase()) === idx);

        if (metricDevices) metricDevices.textContent = String(items.length);
        if (deviceListCount) deviceListCount.textContent = `${items.length} thiết bị`;

        let deviceListMode = localStorage.getItem("elitechDeviceListMode") || "vertical";
        const modeText = {
            vertical: "Đang xem dạng cuộn dọc. Phù hợp khi cần xem chi tiết từng thiết bị.",
            horizontal: "Đang xem dạng cuộn ngang. Kéo ngang để lướt nhanh nhiều thiết bị.",
            grid: "Đang xem dạng lưới. Phù hợp khi có nhiều thiết bị và màn hình rộng.",
            compact: "Đang xem dạng gọn. Phù hợp khi có 50-200+ thiết bị."
        };

        function applyDeviceListMode() {
            if (!deviceListHost) return;

            const allowed = ["vertical", "horizontal", "grid", "compact"];
            if (!allowed.includes(deviceListMode)) deviceListMode = "vertical";

            deviceListHost.classList.remove("is-vertical", "is-horizontal", "is-grid", "is-compact");
            deviceListHost.classList.add("is-" + deviceListMode);

            deviceViewButtons.forEach(btn => {
                btn.classList.toggle("is-active", btn.getAttribute("data-device-view") === deviceListMode);
            });

            if (deviceScrollHint) {
                deviceScrollHint.textContent = modeText[deviceListMode] || modeText.vertical;
            }
        }

        function setDeviceListMode(mode) {
            deviceListMode = mode || "vertical";
            localStorage.setItem("elitechDeviceListMode", deviceListMode);
            applyDeviceListMode();
            renderDeviceList();
        }

        deviceViewButtons.forEach(btn => {
            btn.addEventListener("click", () => setDeviceListMode(btn.getAttribute("data-device-view") || "vertical"));
        });

        function filteredItems() {
            const q = (deviceSearch?.value || "").trim().toLowerCase();
            if (!q) return items;

            return items.filter(x =>
                x.name.toLowerCase().includes(q) ||
                x.guid.toLowerCase().includes(q)
            );
        }

        function markActiveDevice(guid) {
            document.querySelectorAll(".device-item").forEach(el => {
                const active = (el.getAttribute("data-guid") || "") === guid;
                el.classList.toggle("active", active);
                el.classList.toggle("is-active", active);

                if (active && deviceListMode === "horizontal") {
                    setTimeout(() => el.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" }), 60);
                }
            });
        }

        function renderDeviceList() {
            if (!deviceListHost) return;

            const rows = filteredItems();

            if (deviceListCount) deviceListCount.textContent = `${rows.length}/${items.length} thiết bị`;

            if (items.length === 0) {
                deviceListHost.innerHTML = `<div class="ud-rt-empty">Tài khoản chưa được gán thiết bị nào.</div>`;
                return;
            }

            if (rows.length === 0) {
                deviceListHost.innerHTML = `<div class="ud-rt-empty">Không tìm thấy thiết bị phù hợp.</div>`;
                return;
            }

            applyDeviceListMode();

            const currentGuid = (sel?.value || "").trim();

            deviceListHost.innerHTML = rows.map((x, idx) => {
                const isActive = currentGuid === x.guid;
                const tag = isActive ? "Đang chọn" : (idx === 0 ? "Mặc định" : "Chọn");

                return `
            <button type="button" class="device-item ${isActive ? "active is-active" : ""}" data-guid="${escapeHtml(x.guid)}" data-name="${escapeHtml(x.name)}">
            <div class="device-item-main">
            <div class="device-item-name">${escapeHtml(x.name)}</div>
            <div class="device-item-guid">${escapeHtml(x.guid)}</div>
            </div>
            <span class="device-item-tag">${tag}</span>
            </button>
            `;
            }).join("");

            deviceListHost.querySelectorAll(".device-item").forEach(button => {
                button.addEventListener("click", () => {
                    if (sel) sel.value = button.getAttribute("data-guid") || "";
                    load();
                });
            });
        }

        function asNumber(x) {
            if (x === 0) return 0;
            if (x === null || x === undefined) return null;
            const m = String(x).match(/-?\d+(\.\d+)?/);
            return m ? parseFloat(m[0]) : null;
        }

        function fmt(x) {
            const s = (x === null || x === undefined) ? "" : String(x).trim();
            return s ? s : "—";
        }

        function pick(obj, ...names) {
            for (const n of names) {
                if (obj && obj[n] !== undefined && obj[n] !== null) return obj[n];
            }
            return null;
        }

        function normalizeRow(row) {
            if (!row) return null;

            return {
                ...row,
                deviceGuid: pick(row, "deviceGuid", "DeviceGuid", "guid", "Guid", "GUID"),
                deviceName: pick(row, "deviceName", "DeviceName", "name", "Name"),
                tmp1: pick(row, "tmp1", "Tmp1", "TMP1"),
                tmp2: pick(row, "tmp2", "Tmp2", "TMP2"),
                tmp3: pick(row, "tmp3", "Tmp3", "TMP3"),
                tmp4: pick(row, "tmp4", "Tmp4", "TMP4"),
                hum1: pick(row, "hum1", "Hum1", "HUM1"),
                hum2: pick(row, "hum2", "Hum2", "HUM2"),
                power: pick(row, "power", "Power"),
                signal: pick(row, "signal", "Signal"),
                address: pick(row, "address", "Address"),
                position: pick(row, "position", "Position"),
                lastSessionTime: pick(row, "lastSessionTime", "LastSessionTime"),
                alarmState: pick(row, "alarmState", "AlarmState") === true,
                warnState: pick(row, "warnState", "WarnState") === true,
                waybillState: pick(row, "waybillState", "WaybillState")
            };
        }

        function tsSecToLocal(sec) {
            if (!sec) return "—";
            const n = Number(sec);
            if (!Number.isFinite(n) || n <= 0) return "—";
            const d = new Date(n > 3000000000 ? n : n * 1000);
            return Number.isNaN(d.getTime()) ? "—" : d.toLocaleString();
        }

        function statusFromRow(row) {
            const temps = [row?.tmp1, row?.tmp2, row?.tmp3, row?.tmp4].map(asNumber).filter(v => v !== null);
            const hums = [row?.hum1, row?.hum2].map(asNumber).filter(v => v !== null);

            const badT = temps.some(v => v < 2 || v > 8);
            const badH = hums.some(v => v < 30 || v > 70);

            if (row?.alarmState || badT || badH) return { label: "ALARM", cls: "rt-bad" };
            if (row?.warnState) return { label: "WARN", cls: "rt-warn" };
            if (!temps.length && !hums.length) return { label: "NO DATA", cls: "rt-warn" };

            return { label: "OK", cls: "rt-ok" };
        }

        function getJourneyState(row) {
            const state = String(row?.waybillState ?? "").trim();
            if (state === "1") return "Start delayed";
            if (state === "2") return "In progress";
            if (state === "3") return "Ended";
            return "No journey";
        }

        function render(row) {
            row = normalizeRow(row);

            if (!row) {
                host.innerHTML = `<div class="ud-rt-empty">Không có dữ liệu realtime.</div>`;
                if (metricPreview) metricPreview.textContent = "Không có dữ liệu";
                if (activeDeviceName) activeDeviceName.textContent = "—";
                if (activeDeviceGuid) activeDeviceGuid.textContent = "Chưa chọn thiết bị";
                return;
            }

            const st = statusFromRow(row);

            const sensors = [
                { key: "tmp1", label: "Nhiệt 1", unit: "°C", type: "temp" },
                { key: "tmp2", label: "Nhiệt 2", unit: "°C", type: "temp" },
                { key: "tmp3", label: "Nhiệt 3", unit: "°C", type: "temp" },
                { key: "tmp4", label: "Nhiệt 4", unit: "°C", type: "temp" },
                { key: "hum1", label: "Ẩm 1", unit: "%RH", type: "hum" },
                { key: "hum2", label: "Ẩm 2", unit: "%RH", type: "hum" }
            ];

            const tiles = sensors
                .map(s => {
                    const raw = row?.[s.key];
                    const val = asNumber(raw);
                    if (val === null) return null;

                    const bad = (s.type === "temp")
                        ? (val < 2 || val > 8)
                        : (val < 30 || val > 70);

                    return { ...s, raw, val, vcls: bad ? "bad" : "ok" };
                })
                .filter(Boolean);

            const sensorsHtml = tiles.length
                ? `
            <div class="rt-sensors">
            <div class="rt-sensors-hd">
            <div class="rt-sensors-title">Cảm biến</div>
            <div class="rt-sensors-badge">${tiles.length} kênh</div>
            </div>
            <div class="rt-sensor-grid">
            ${tiles.map(t => `
            <div class="rt-sensor">
            <div class="rt-k">${escapeHtml(t.label)}</div>
            <div class="rt-v ${t.vcls}">
            ${escapeHtml(fmt(row[t.key]))}
            <span class="rt-unit">${escapeHtml(t.unit)}</span>
            </div>
            </div>
            `).join("")}
            </div>
            </div>
            `
                : `
            <div class="rt-sensors">
            <div class="rt-sensors-hd">
            <div class="rt-sensors-title">Cảm biến</div>
            <div class="rt-sensors-badge">0 kênh</div>
            </div>
            <div class="ud-rt-empty">Elitech chưa trả dữ liệu cảm biến cho thiết bị này.</div>
            </div>
            `;

            host.innerHTML = `
            <div class="rt-card">
            <div class="rt-top">
            <div>
            <div class="rt-name">${fmt(row.deviceName) !== "—" ? escapeHtml(fmt(row.deviceName)) : "Device"}</div>
            <div class="rt-guid">${escapeHtml(fmt(row.deviceGuid))}</div>
            </div>
            <div class="rt-pill ${st.cls}">${st.label}</div>
            </div>

            <div class="rt-banner">
            <div class="rt-banner-box">
            <div class="rt-banner-k">Cập nhật session</div>
            <div class="rt-banner-v">${escapeHtml(tsSecToLocal(row.lastSessionTime))}</div>
            </div>
            <div class="rt-banner-box">
            <div class="rt-banner-k">Journey</div>
            <div class="rt-banner-v">${escapeHtml(getJourneyState(row))}</div>
            </div>
            <div class="rt-banner-box">
            <div class="rt-banner-k">Vị trí</div>
            <div class="rt-banner-v">${escapeHtml(fmt(row.position))}</div>
            </div>
            </div>

            <div class="rt-grid">
            ${sensorsHtml}

            <div class="rt-box">
            <div class="rt-k">Nguồn</div>
            <div class="rt-v">${escapeHtml(fmt(row.power))}</div>
            </div>
            <div class="rt-box">
            <div class="rt-k">Tín hiệu</div>
            <div class="rt-v">${escapeHtml(fmt(row.signal))}</div>
            </div>

            <div class="rt-box rt-full">
            <div class="rt-k">Địa chỉ</div>
            <div class="rt-v" style="font-size:1rem;">${escapeHtml(fmt(row.address))}</div>
            </div>
            </div>

            <div class="rt-foot">
            <span><i class="bi bi-clock"></i> ${escapeHtml(tsSecToLocal(row.lastSessionTime))}</span>
            <span><i class="bi bi-upc-scan"></i> GUID: ${escapeHtml(fmt(row.deviceGuid))}</span>
            </div>
            </div>
            `;

            if (metricPreview) metricPreview.textContent = st.label;
            if (activeDeviceName) activeDeviceName.textContent = fmt(row.deviceName) !== "—" ? fmt(row.deviceName) : "Device";
            if (activeDeviceGuid) activeDeviceGuid.textContent = fmt(row.deviceGuid);
        }

        async function fetchRealtime(guid) {
            const url = `/api/elitech/realtime?deviceGuids=${encodeURIComponent(guid)}`;
            const res = await fetch(url, { credentials: "same-origin", headers: { "Accept": "application/json" } });
            if (!res.ok) throw new Error("HTTP " + res.status);

            const json = await res.json();
            const rows = Array.isArray(json?.data)
                ? json.data
                : Array.isArray(json?.Data)
                    ? json.Data
                    : [];

            return rows.length ? normalizeRow(rows[0]) : null;
        }

        let timer = null;

        async function load() {
            const guid = (sel?.value || "").trim();

            if (!guid) {
                render(null);
                return;
            }

            markActiveDevice(guid);

            if (metricPreview) metricPreview.textContent = "Đang tải…";
            if (metricNow) metricNow.textContent = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
            host.style.opacity = ".92";

            try {
                const row = await fetchRealtime(guid);
                render(row);

                if (last) last.textContent = new Date().toLocaleTimeString();

                markActiveDevice(guid);
            } catch (e) {
                host.innerHTML = `<div class="ud-rt-empty">Không tải được realtime: ${escapeHtml(e.message || "Kiểm tra API / quyền user.")}</div>`;
                if (metricPreview) metricPreview.textContent = "Lỗi tải dữ liệu";
            } finally {
                host.style.opacity = "1";
            }
        }

        if (!sel || !host) return;

        renderDeviceList();

        if (deviceSearch) {
            deviceSearch.addEventListener("input", renderDeviceList);
        }

        if (items.length === 0) {
            host.innerHTML = `<div class="ud-rt-empty">Tài khoản chưa được gán thiết bị nào.</div>`;
            sel.innerHTML = "";
            if (metricPreview) metricPreview.textContent = "Chưa có thiết bị";
            return;
        }

        sel.innerHTML = items.map(x => `<option value="${escapeHtml(x.guid)}">${escapeHtml(x.name)} — ${escapeHtml(x.guid)}</option>`).join("");

        sel.addEventListener("change", () => {
            renderDeviceList();
            load();
        });

        if (btn) btn.addEventListener("click", load);

        load();

        timer = setInterval(load, 30000);
        window.addEventListener("beforeunload", () => timer && clearInterval(timer));
    })();
</script>
