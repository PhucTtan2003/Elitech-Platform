@using System.Text.Json
@{
    ViewData["Title"] = "Thiết bị của tôi";
    Layout = "_Layout";

    var assignedDevices = ViewBag.Devices ?? new List<object>();
    bool canUserSubscribeSms = (bool)(ViewBag.CanUserSubscribeSms ?? false);
    var smsAlready = (bool)(ViewBag.SmsAlreadySubscribed ?? false);
    var smsExp = ViewBag.SmsSubExpiresAtUtc as DateTime?;

    var userMeta = new
    {
        name = User?.Identity?.Name ?? "",
        role = User?.Claims?.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "",
        userId = User?.Claims?.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? ""
    };
}

<style>
    :root {
        --ud-bg: #eef4ff;
        --ud-bg2: #f8fbff;
        --ud-ink: #0f172a;
        --ud-soft-ink: #334155;
        --ud-mut: #64748b;
        --ud-faint: #94a3b8;
        --ud-line: rgba(148, 163, 184, .22);
        --ud-line2: rgba(100, 116, 139, .28);
        --ud-card: rgba(255, 255, 255, .94);
        --ud-card2: #f8fafc;
        --ud-blue: #2563eb;
        --ud-blue2: #3b82f6;
        --ud-orange: #f58220;
        --ud-orange2: #e36f15;
        --ud-green: #16a34a;
        --ud-amber: #d97706;
        --ud-red: #dc2626;
        --ud-cyan: #0891b2;
        --ud-shadow-lg: 0 24px 70px rgba(15, 23, 42, .12);
        --ud-shadow-md: 0 14px 34px rgba(15, 23, 42, .09);
        --ud-shadow-sm: 0 7px 18px rgba(15, 23, 42, .07);
        --ud-radius-xl: 28px;
        --ud-radius-lg: 22px;
        --ud-radius-md: 16px;
        --ud-sidebar: 88px;
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        color: var(--ud-ink);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        background: radial-gradient(900px 520px at -10% -10%, rgba(37, 99, 235, .14), transparent 58%), radial-gradient(900px 520px at 110% -10%, rgba(245, 130, 32, .12), transparent 56%), radial-gradient(820px 520px at 50% 115%, rgba(22, 163, 74, .08), transparent 58%), linear-gradient(180deg, #f8fbff 0%, #eef4ff 52%, #edf3fb 100%);
    }

    .ud-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: var(--ud-sidebar) minmax(0, 1fr);
    }

    .ud-side {
        position: sticky;
        top: 0;
        height: 100vh;
        padding: 16px 12px;
        border-right: 1px solid rgba(148, 163, 184, .18);
        background: linear-gradient(180deg, rgba(255, 255, 255, .76), rgba(255, 255, 255, .42));
        backdrop-filter: saturate(150%) blur(12px);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        z-index: 10;
    }

    .side-logo {
        width: 56px;
        height: 56px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: #fff;
        background: radial-gradient(120% 120% at 20% 10%, rgba(255, 255, 255, .42), transparent 46%), linear-gradient(135deg, var(--ud-blue2), var(--ud-blue));
        box-shadow: 0 18px 36px rgba(37, 99, 235, .22);
        font-size: 23px;
        border: 1px solid rgba(255, 255, 255, .36);
    }

    .side-stack {
        display: grid;
        gap: 10px;
        width: 100%;
    }

    .side-btn {
        width: 100%;
        min-height: 54px;
        border: 1px solid rgba(148, 163, 184, .18);
        border-radius: 18px;
        background: rgba(255, 255, 255, .80);
        color: #334155;
        display: grid;
        place-items: center;
        text-decoration: none;
        box-shadow: var(--ud-shadow-sm);
        transition: transform .14s ease, box-shadow .14s ease, border-color .14s ease, background .14s ease;
        font-size: 18px;
    }

        .side-btn:hover,
        .side-btn.is-active {
            transform: translateY(-1px);
            border-color: rgba(37, 99, 235, .26);
            background: linear-gradient(180deg, #ffffff, #eff6ff);
            box-shadow: 0 14px 28px rgba(37, 99, 235, .11);
            color: var(--ud-blue);
        }

    .side-spacer {
        flex: 1;
    }

    .ud-main {
        padding: 18px;
        min-width: 0;
    }

    .ud-page {
        max-width: 1500px;
        margin: 0 auto;
        display: grid;
        gap: 16px;
    }

    .glass {
        border: 1px solid rgba(148, 163, 184, .20);
        background: rgba(255, 255, 255, .78);
        box-shadow: var(--ud-shadow-md);
        backdrop-filter: blur(14px);
    }

    .hero {
        position: relative;
        overflow: hidden;
        border-radius: 32px;
        padding: 18px;
        display: grid;
        gap: 16px;
        background: radial-gradient(880px 240px at 5% 0%, rgba(37, 99, 235, .13), transparent 64%), radial-gradient(760px 260px at 96% 10%, rgba(245, 130, 32, .14), transparent 60%), linear-gradient(135deg, rgba(255, 255, 255, .94), rgba(255, 255, 255, .78));
    }

        .hero::after {
            content: "";
            position: absolute;
            inset: auto 18px 0 auto;
            width: 260px;
            height: 120px;
            background: radial-gradient(circle, rgba(37, 99, 235, .12), transparent 64%);
            pointer-events: none;
        }

    .hero-top {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hero-brand {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 280px;
    }

    .hero-badge {
        width: 64px;
        height: 64px;
        border-radius: 24px;
        display: grid;
        place-items: center;
        color: #fff;
        font-size: 26px;
        background: radial-gradient(120% 120% at 18% 8%, rgba(255, 255, 255, .45), transparent 45%), linear-gradient(135deg, #1d4ed8, #2563eb 55%, #38bdf8);
        box-shadow: 0 20px 42px rgba(37, 99, 235, .22);
        border: 1px solid rgba(255, 255, 255, .36);
        flex: 0 0 auto;
    }

    .hero-copy h1 {
        margin: 0;
        font-size: clamp(1.28rem, 1.1rem + .9vw, 1.9rem);
        font-weight: 1000;
        letter-spacing: -.04em;
    }

    .hero-copy p {
        margin: 8px 0 0;
        color: var(--ud-mut);
        font-weight: 760;
        line-height: 1.48;
        max-width: 820px;
    }

    .hero-meta {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-end;
        margin-left: auto;
    }

    .hero-pills,
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
    }

    .pill,
    .soft-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 0 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .86);
        border: 1px solid rgba(148, 163, 184, .22);
        box-shadow: var(--ud-shadow-sm);
        color: #334155;
        font-weight: 880;
        font-size: .82rem;
        white-space: nowrap;
    }

        .pill strong {
            color: var(--ud-ink);
        }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #cbd5e1;
        box-shadow: 0 0 0 4px rgba(148, 163, 184, .10);
    }

        .dot.ok {
            background: var(--ud-green);
            box-shadow: 0 0 0 4px rgba(22, 163, 74, .10);
        }

        .dot.warn {
            background: var(--ud-amber);
            box-shadow: 0 0 0 4px rgba(217, 119, 6, .10);
        }

        .dot.bad {
            background: var(--ud-red);
            box-shadow: 0 0 0 4px rgba(220, 38, 38, .10);
        }

    .action-btn,
    .sms-btn {
        appearance: none;
        border: 1px solid rgba(148, 163, 184, .22);
        background: #fff;
        color: var(--ud-ink);
        border-radius: 17px;
        min-height: 46px;
        padding: 0 16px;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        box-shadow: var(--ud-shadow-sm);
        transition: transform .14s ease, box-shadow .14s ease, background .14s ease, border-color .14s ease, opacity .14s ease;
        cursor: pointer;
        white-space: nowrap;
    }

        .action-btn i {
            width: 28px;
            height: 28px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: #f8fafc;
            border: 1px solid rgba(148, 163, 184, .20);
        }

        .action-btn:hover,
        .sms-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            border-color: rgba(37, 99, 235, .26);
            box-shadow: 0 16px 30px rgba(15, 23, 42, .09);
        }

        .action-btn.primary {
            background: linear-gradient(135deg, #111827, #1f2937);
            color: #fff;
            border-color: #111827;
        }

        .action-btn.dark {
            background: linear-gradient(135deg, #334155, #1f2937);
            color: #fff;
            border-color: #334155;
        }

            .action-btn.primary i,
            .action-btn.dark i {
                background: rgba(255, 255, 255, .10);
                border-color: rgba(255, 255, 255, .16);
                color: #fff;
            }

    .sms-btn {
        border-radius: 999px;
        padding: 0 18px;
        background: linear-gradient(180deg, #ffffff, #f8fbff);
    }

        .sms-btn.is-on {
            color: #fff;
            border-color: rgba(22, 163, 74, .16);
            background: linear-gradient(135deg, #16a34a, #22c55e);
        }

        .sms-btn:disabled {
            opacity: .68;
            cursor: not-allowed;
        }

    .hero-stats {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .metric {
        border-radius: 22px;
        padding: 14px 16px;
        border: 1px solid rgba(148, 163, 184, .18);
        background: linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(248, 250, 252, .96));
        box-shadow: var(--ud-shadow-sm);
    }

    .metric-k {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 950;
        color: var(--ud-mut);
    }

    .metric-v {
        margin-top: 8px;
        font-size: 1.28rem;
        font-weight: 1000;
        letter-spacing: -.02em;
        color: var(--ud-ink);
    }

    .metric-s {
        margin-top: 4px;
        color: var(--ud-mut);
        font-size: .8rem;
        font-weight: 760;
        line-height: 1.38;
    }

    .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(340px, .74fr);
        gap: 16px;
        align-items: start;
    }

    .card {
        border-radius: var(--ud-radius-xl);
        border: 1px solid rgba(148, 163, 184, .18);
        background: rgba(255, 255, 255, .92);
        box-shadow: var(--ud-shadow-md);
        overflow: hidden;
    }

    .card-hd {
        padding: 18px 18px 14px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 1px solid rgba(148, 163, 184, .14);
        flex-wrap: wrap;
    }

    .card-bd {
        padding: 18px;
    }

    .title-wrap b {
        display: block;
        font-size: 1.02rem;
        font-weight: 1000;
        letter-spacing: -.02em;
        color: var(--ud-ink);
    }

    .sub {
        margin-top: 6px;
        color: var(--ud-mut);
        font-weight: 760;
        font-size: .88rem;
        line-height: 1.45;
    }

    .tools {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
        margin-left: auto;
    }

    .soft-chip.btn {
        cursor: pointer;
        user-select: none;
        transition: transform .14s ease, box-shadow .14s ease, border-color .14s ease;
    }

        .soft-chip.btn:hover {
            transform: translateY(-1px);
            border-color: rgba(37, 99, 235, .24);
            box-shadow: 0 10px 20px rgba(37, 99, 235, .08);
        }

    .ud-rt-wrap {
        border-radius: 24px;
        border: 1px solid rgba(148, 163, 184, .18);
        background: linear-gradient(180deg, #ffffff, #fbfdff);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .70), var(--ud-shadow-sm);
        overflow: hidden;
    }

    .ud-rt-hd {
        padding: 16px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        justify-content: space-between;
        border-bottom: 1px solid rgba(148, 163, 184, .14);
        flex-wrap: wrap;
    }

    .ud-rt-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 1000;
        color: var(--ud-ink);
    }

    .ud-rt-sub {
        margin-top: 6px;
        color: var(--ud-mut);
        font-size: .82rem;
        font-weight: 760;
    }

    .ud-rt-tools {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
        margin-left: auto;
    }

    .ud-rt-select,
    .ud-rt-btn,
    .ud-rt-chip,
    .search-input {
        min-height: 42px;
        border-radius: 15px;
        border: 1px solid rgba(148, 163, 184, .22);
        background: #fff;
        box-shadow: var(--ud-shadow-sm);
        font-weight: 880;
        color: var(--ud-ink);
    }

    .ud-rt-select {
        min-width: min(100%, 390px);
        padding: 0 12px;
        outline: none;
    }

    .search-input {
        width: 100%;
        padding: 0 14px;
        outline: none;
    }

        .ud-rt-select:focus,
        .search-input:focus {
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .12);
            border-color: rgba(37, 99, 235, .30);
        }

    .ud-rt-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 0 14px;
        cursor: pointer;
        transition: transform .14s ease, box-shadow .14s ease;
    }

        .ud-rt-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 22px rgba(15, 23, 42, .08);
        }

    .ud-rt-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 0 14px;
        background: #f8fafc;
    }

    .ud-rt-host {
        padding: 16px;
    }

    .ud-rt-empty {
        border-radius: 18px;
        border: 1px dashed rgba(148, 163, 184, .34);
        background: #f8fafc;
        color: var(--ud-mut);
        padding: 18px;
        font-weight: 850;
        text-align: center;
    }

    .rt-card {
        border-radius: 24px;
        background: linear-gradient(180deg, #ffffff, #fbfdff);
        border: 1px solid rgba(148, 163, 184, .18);
        box-shadow: 0 18px 42px rgba(15, 23, 42, .09);
        overflow: hidden;
    }

    .rt-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        padding: 16px 16px 10px;
    }

    .rt-name {
        font-size: 1.1rem;
        font-weight: 1000;
        letter-spacing: -.02em;
        color: var(--ud-ink);
        overflow-wrap: anywhere;
    }

    .rt-guid {
        margin-top: 6px;
        color: var(--ud-mut);
        font-size: .8rem;
        font-weight: 820;
        overflow-wrap: anywhere;
    }

    .rt-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 1000;
        border: 1px solid transparent;
        white-space: nowrap;
    }

        .rt-pill:before {
            content: "";
            width: 9px;
            height: 9px;
            border-radius: 999px;
            background: #cbd5e1;
        }

    .rt-ok {
        background: #dcfce7;
        color: #166534;
        border-color: #bbf7d0;
    }

        .rt-ok:before {
            background: var(--ud-green);
        }

    .rt-warn {
        background: #ffedd5;
        color: #9a3412;
        border-color: #fed7aa;
    }

        .rt-warn:before {
            background: var(--ud-amber);
        }

    .rt-bad {
        background: #fee2e2;
        color: #991b1b;
        border-color: #fecaca;
    }

        .rt-bad:before {
            background: var(--ud-red);
        }

    .rt-banner {
        margin: 0 16px 4px;
        padding: 12px 14px;
        border-radius: 19px;
        background: linear-gradient(135deg, rgba(37, 99, 235, .08), rgba(8, 145, 178, .06));
        border: 1px solid rgba(37, 99, 235, .12);
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    .rt-banner-box {
        min-width: 0;
        border-radius: 15px;
        padding: 10px 12px;
        background: rgba(255, 255, 255, .78);
        border: 1px solid rgba(148, 163, 184, .14);
    }

    .rt-banner-k,
    .rt-k,
    .stat .k,
    .mini-k {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 950;
        color: var(--ud-mut);
    }

    .rt-banner-v {
        margin-top: 6px;
        font-size: .98rem;
        font-weight: 950;
        color: var(--ud-ink);
        overflow-wrap: anywhere;
    }

    .rt-grid {
        padding: 12px 16px 16px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .rt-box,
    .rt-sensors,
    .stat,
    .mini-card {
        border-radius: 19px;
        border: 1px solid rgba(148, 163, 184, .16);
        background: linear-gradient(180deg, #ffffff, #f8fafc);
        box-shadow: var(--ud-shadow-sm);
    }

    .rt-box {
        padding: 12px 14px;
    }

    .rt-v,
    .stat .v,
    .mini-v {
        margin-top: 8px;
        font-size: 1.12rem;
        font-weight: 1000;
        letter-spacing: -.02em;
        color: var(--ud-ink);
        overflow-wrap: anywhere;
    }

        .rt-v.ok {
            color: #166534;
        }

        .rt-v.bad {
            color: #991b1b;
        }

    .rt-full {
        grid-column: 1 / -1;
    }

    .rt-sensors {
        grid-column: 1 / -1;
        padding: 14px;
    }

    .rt-sensors-hd {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
    }

    .rt-sensors-title {
        font-size: .76rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 950;
        color: var(--ud-mut);
    }

    .rt-sensors-badge {
        min-height: 34px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, .18);
        background: #f8fafc;
        display: inline-flex;
        align-items: center;
        font-size: .78rem;
        font-weight: 850;
        color: #334155;
    }

    .rt-sensor-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
    }

    .rt-sensor {
        border-radius: 17px;
        border: 1px solid rgba(148, 163, 184, .16);
        background: #f8fafc;
        padding: 12px;
        min-height: 86px;
    }

    .rt-unit {
        margin-left: 6px;
        font-size: .78rem;
        font-weight: 900;
        color: #94a3b8;
    }

    .rt-foot {
        padding: 12px 16px 14px;
        border-top: 1px solid rgba(148, 163, 184, .14);
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        color: var(--ud-mut);
        font-size: .8rem;
        font-weight: 850;
    }

    .layout-note {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }

        .layout-note .note {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 38px;
            padding: 0 14px;
            border-radius: 999px;
            background: #f8fafc;
            border: 1px solid rgba(148, 163, 184, .18);
            color: #475569;
            font-size: .82rem;
            font-weight: 820;
        }

    .ud-mini {
        display: grid;
        gap: 16px;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .stat,
    .mini-card {
        padding: 14px;
    }

        .stat .s,
        .mini-s {
            margin-top: 4px;
            color: var(--ud-mut);
            font-size: .82rem;
            font-weight: 760;
            line-height: 1.45;
            overflow-wrap: anywhere;
        }

    .mini-grid {
        display: grid;
        gap: 12px;
    }

    .sr-badge,
    .sr-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        font-weight: 860;
        white-space: nowrap;
    }

    .sr-badge {
        min-height: 34px;
        padding: 0 12px;
        border: 1px solid rgba(148, 163, 184, .18);
        background: #f8fafc;
        font-size: .78rem;
    }

    .sr-chip {
        min-height: 32px;
        padding: 0 10px;
        border: 1px solid rgba(148, 163, 184, .16);
        background: #f8fafc;
        color: #475569;
        font-size: .75rem;
    }

    .sr-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #cbd5e1;
    }

    .sr-ok {
        background: rgba(22, 163, 74, .08);
