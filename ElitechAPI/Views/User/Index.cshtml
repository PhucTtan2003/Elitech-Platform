    .toast {
        pointer-events: auto;
        border-radius: 18px;
        border: 1px solid rgba(148, 163, 184, .20);
        background: rgba(255, 255, 255, .98);
        box-shadow: 0 22px 50px rgba(15, 23, 42, .16);
        overflow: hidden;
        transform: translateY(-8px);
        opacity: 0;
        animation: toastIn .16s ease forwards;
    }

    @@keyframes toastIn {
        to {
            transform: translateY(0);
            opacity: 1;
        }
