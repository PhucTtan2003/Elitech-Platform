    .hero {
        position: relative;
        overflow: hidden;
        border-radius: 34px;
        border-color: rgba(255,255,255,.18);
        color: #fff;
        background: radial-gradient(620px 340px at 8% 5%, rgba(245,130,32,.34), transparent 58%), radial-gradient(640px 420px at 92% 2%, rgba(37,99,235,.36), transparent 56%), linear-gradient(135deg, #0b1220 0%, #172033 48%, #1f2937 100%) !important;
        box-shadow: 0 34px 90px rgba(15,23,42,.22);
        padding: 24px;
    }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
            background-size: 34px 34px;
            mask-image: linear-gradient(180deg, rgba(0,0,0,.92), transparent 78%);
            pointer-events: none;
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            right: -70px;
            bottom: -120px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(245,130,32,.34), transparent 68%);
            filter: blur(2px);
            pointer-events: none;
        }

        .hero > * {
            position: relative;
            z-index: 1;
