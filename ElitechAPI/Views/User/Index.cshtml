        .device-mode-btn.is-active {
            color: #9a3412;
            border-color: rgba(245,130,32,.24);
            background: #fff7ed;
        }

    .device-scroll-hint {
        color: #64748b;
        font-size: .78rem;
        font-weight: 850;
        line-height: 1.35;
    }

    .device-list-shell {
        border-radius: 22px;
        padding: 10px;
        background: rgba(248,250,252,.62);
        border: 1px solid rgba(148,163,184,.14);
    }

    .device-list {
        scroll-behavior: smooth;
        overscroll-behavior: contain;
    }

        .device-list.is-vertical {
            display: grid;
            gap: 10px;
            max-height: 520px;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 4px;
        }

        .device-list.is-horizontal {
            display: flex;
            gap: 12px;
            max-height: none;
            overflow-x: auto;
            overflow-y: hidden;
            padding: 2px 4px 12px;
            scroll-snap-type: x proximity;
        }

            .device-list.is-horizontal .device-item {
                min-width: 280px;
                max-width: 320px;
                flex: 0 0 280px;
                scroll-snap-align: start;
            }

        .device-list.is-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 10px;
            max-height: 560px;
            overflow: auto;
            padding-right: 4px;
        }

        .device-list.is-compact {
            display: grid;
            gap: 8px;
            max-height: 520px;
            overflow: auto;
            padding-right: 4px;
        }

            .device-list.is-compact .device-item {
                min-height: 54px;
                padding: 9px 10px;
                border-radius: 15px;
            }

            .device-list.is-compact .device-item-guid {
                font-size: .72rem;
                margin-top: 2px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                max-width: 210px;
