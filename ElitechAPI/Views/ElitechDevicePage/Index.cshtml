        .di-stat.orange::after {
            background: radial-gradient(circle, rgba(245,130,32,.23), transparent 70%);
        }

        .di-stat.green::after {
            background: radial-gradient(circle, rgba(34,197,94,.20), transparent 70%);
        }

        .di-stat.dark::after {
            background: radial-gradient(circle, rgba(15,23,42,.18), transparent 70%);
