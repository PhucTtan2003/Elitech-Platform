        border-radius: 999px;
        font-size: .75rem;
        font-weight: 1000;
        white-space: nowrap;
        border: 1px solid transparent;
    }

        .di-pill.blue {
            background: #e0edff;
            color: #1d4ed8;
            border-color: #bfdbfe;
        }

        .di-pill.green {
            background: #e8fff1;
            color: #059669;
            border-color: #bbf7d0;
        }

        .di-pill.orange {
            background: #fff4e5;
            color: #c75f12;
            border-color: #fed7aa;
        }

        .di-pill.gray {
            background: #f1f5f9;
            color: #475569;
            border-color: #e2e8f0;
        }

    .di-empty {
