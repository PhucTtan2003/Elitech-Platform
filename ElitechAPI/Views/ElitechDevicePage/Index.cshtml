        font-size: 1.24rem;
        line-height: 1.15;
        font-weight: 1000;
        letter-spacing: -.035em;
    }

    .di-panel-note {
        margin-top: 4px;
        color: #64748b;
        font-size: .84rem;
        font-weight: 760;
    }

    .di-loading {
