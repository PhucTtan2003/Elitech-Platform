        }

        .di-guid-line code {
            max-width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .di-stats {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        * {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<div class="di-toast" id="diToast">
