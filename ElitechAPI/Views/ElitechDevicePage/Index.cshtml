        --di-soft-muted: #64748b;
        --di-line: rgba(148,163,184,.26);
        --di-line-2: rgba(226,232,240,.88);
        --di-bg: #eef3fb;
        --di-card: rgba(255,255,255,.92);
        --di-orange: #f58220;
        --di-orange-2: #ffb25b;
        --di-blue: #2563eb;
        --di-sky: #38bdf8;
        --di-green: #22c55e;
        --di-red: #ef4444;
