        align-items: center;
        gap: 8px;
        color: #334155;
        padding: 9px 12px;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid rgba(226,232,240,.92);
        font-weight: 900;
        font-size: .82rem;
    }

        .di-loading.show {
            display: inline-flex;
        }

    .di-spinner {
        width: 15px;
        height: 15px;
        border-radius: 999px;
        border: 2px solid #fed7aa;
        border-top-color: var(--di-orange);
        animation: diSpin .75s linear infinite;
    }

    @@keyframes diSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .di-table-wrap {
        max-height: 65vh;
        overflow: auto;
        background: #fff;
    }

    .di-table {
        width: 100%;
        min-width: 1120px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .di-table th,
        .di-table td {
            padding: 14px 15px;
            border-bottom: 1px solid rgba(226,232,240,.84);
            vertical-align: middle;
            text-align: left;
        }

        .di-table th {
