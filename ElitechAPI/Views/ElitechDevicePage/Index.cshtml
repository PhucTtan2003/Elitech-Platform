        background: #fff7ed;
        border: 1px solid rgba(245,130,32,.25);
        color: #9a3412;
        font-weight: 860;
        box-shadow: var(--di-shadow-soft);
    }

        .di-alert.show {
            display: block;
        }

    .di-panel {
        margin-top: 16px;
        overflow: hidden;
    }

    .di-panel-head {
        padding: 18px 20px;
        border-bottom: 1px solid rgba(226,232,240,.90);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        background: radial-gradient(480px 160px at 100% 0%, rgba(245,130,32,.10), transparent 58%), rgba(255,255,255,.70);
    }

    .di-panel-kicker {
        color: var(--di-orange);
        font-size: .72rem;
        font-weight: 1000;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .di-panel-title {
        margin: 5px 0 0;
