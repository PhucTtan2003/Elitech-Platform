        border-radius: 20px;
        background: rgba(255,255,255,.96);
        border: 1px solid rgba(226,232,240,.92);
        box-shadow: 0 20px 52px rgba(15,23,42,.18);
    }

        .di-toast.show {
            display: block;
        }

    .di-toast-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #0f172a;
