        box-shadow: 0 28px 84px rgba(7,18,38,.28);
    }

        .di-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255,255,255,.052) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.052) 1px, transparent 1px);
            background-size: 44px 44px;
            opacity: .48;
            pointer-events: none;
            mask-image: linear-gradient(90deg, #000 0%, transparent 96%);
