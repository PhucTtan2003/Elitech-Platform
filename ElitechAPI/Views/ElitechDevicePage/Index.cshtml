@using System.Text.Json
@{
    ViewData["Title"] = "Elitech Device Info";
    var deviceGuids = (ViewBag.DeviceGuids as string) ?? "";
    var deviceGuidsJson = JsonSerializer.Serialize(deviceGuids);
}

<style>
