        }

        .di-form {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 760px) {
        .di-page {
            padding: 12px 10px 26px;
        }

        .di-hero {
            border-radius: 28px;
            padding: 22px;
        }

        .di-title {
            font-size: 2.55rem;
        }

        .di-form {
            grid-template-columns: 1fr;
        }

        .di-btn,
        .di-btn-link {
            width: 100%;
        }

        .di-stats {
