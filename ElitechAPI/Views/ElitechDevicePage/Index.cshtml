    .di-hero-inner {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr);
        gap: 24px;
        align-items: stretch;
    }

    .di-kicker {
