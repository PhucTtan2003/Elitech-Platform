        color: #0f172a;
        font-weight: 1000;
        line-height: 1.2;
    }

    .di-device-sub {
        margin-top: 4px;
        color: #64748b;
        font-size: .76rem;
        font-weight: 760;
    }

    .di-code {
        max-width: 260px;
        display: inline-flex;
        align-items: center;
        padding: 7px 10px;
        border-radius: 13px;
        background: #f1f5f9;
        color: #0f172a;
        font-size: .78rem;
        font-weight: 900;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .di-copy-btn {
