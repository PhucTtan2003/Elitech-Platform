        color: var(--di-ink);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    }

    .di-page {
        position: relative;
        max-width: 1480px;
        margin: 0 auto;
        padding: 18px 16px 34px;
    }

    .di-hero {
        position: relative;
        overflow: hidden;
        min-height: 310px;
        border-radius: 38px;
        padding: 30px;
        color: #fff;
        background: radial-gradient(800px 330px at 88% 0%, rgba(245,130,32,.34), transparent 52%), radial-gradient(700px 340px at 3% 8%, rgba(56,189,248,.22), transparent 58%), linear-gradient(135deg, #071226 0%, #0b1833 48%, #10204a 100%);
