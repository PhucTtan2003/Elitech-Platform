            top: 0;
            z-index: 2;
            color: #64748b;
            background: #f8fafc;
            font-size: .72rem;
            font-weight: 1000;
            letter-spacing: .12em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .di-table td {
            color: #0f172a;
            font-size: .88rem;
            font-weight: 800;
        }

        .di-table tbody tr {
            transition: .15s ease;
        }

            .di-table tbody tr:hover td {
                background: rgba(245,130,32,.055);
            }

