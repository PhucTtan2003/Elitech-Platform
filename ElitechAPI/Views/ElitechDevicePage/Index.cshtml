        background: linear-gradient(135deg, #2563eb, #38bdf8);
        box-shadow: 0 14px 28px rgba(37,99,235,.18);
    }

    .di-stat.orange .di-stat-ico {
        color: #111827;
        background: linear-gradient(135deg, #f58220, #ffb25b);
        box-shadow: 0 14px 28px rgba(245,130,32,.20);
