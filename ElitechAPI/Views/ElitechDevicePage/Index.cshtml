            </div>
        </div>
    </section>

    <section class="di-card di-toolbar">
        <form method="get" class="di-form">
            <div class="di-input-wrap">
                <i class="bi bi-search"></i>
                <input id="deviceGuidsInput"
                       name="deviceGuids"
                       class="di-input"
                       placeholder="Nhập GUID, ví dụ: GUID1,GUID2"
                       value="@deviceGuids"
                       autocomplete="off" />
            </div>

            <button class="di-btn primary" type="submit">
                <i class="bi bi-rocket-takeoff-fill"></i>
                Load
            </button>

            <button type="button" id="btnFetch" class="di-btn">
                <i class="bi bi-lightning-charge-fill"></i>
                Fetch via API
            </button>

            <button type="button" id="btnClear" class="di-btn">
                <i class="bi bi-x-circle"></i>
                Clear
            </button>
        </form>

        <div class="di-guid-line">
            <span>GUID hiện tại:</span>
            <code id="guidShow">@(string.IsNullOrWhiteSpace(deviceGuids) ? "Chưa nhập" : deviceGuids)</code>
        </div>
    </section>

    <section class="di-stats">
        <div class="di-card di-stat">
            <div class="di-stat-top">
                <div class="di-stat-label">Tổng thiết bị</div>
                <div class="di-stat-ico">
                    <i class="bi bi-cpu-fill"></i>
                </div>
            </div>
            <div class="di-stat-value" id="statTotal">0</div>
            <div class="di-stat-sub">Số thiết bị trả về từ API</div>
        </div>

        <div class="di-card di-stat orange">
            <div class="di-stat-top">
                <div class="di-stat-label">Tổng SMS</div>
                <div class="di-stat-ico">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>
            </div>
            <div class="di-stat-value" id="statSms">0</div>
            <div class="di-stat-sub">Số lượt SMS còn/đã cấu hình</div>
        </div>

        <div class="di-card di-stat green">
            <div class="di-stat-top">
                <div class="di-stat-label">Tổng Voice</div>
                <div class="di-stat-ico">
                    <i class="bi bi-telephone-fill"></i>
                </div>
            </div>
            <div class="di-stat-value" id="statVoice">0</div>
            <div class="di-stat-sub">Số lượt Voice còn/đã cấu hình</div>
        </div>

        <div class="di-card di-stat dark">
            <div class="di-stat-top">
                <div class="di-stat-label">Có hạn dùng</div>
                <div class="di-stat-ico">
                    <i class="bi bi-calendar2-check-fill"></i>
                </div>
            </div>
            <div class="di-stat-value" id="statExpired">0</div>
            <div class="di-stat-sub">Thiết bị có expiredTime</div>
        </div>
    </section>

    <div id="err" class="di-alert"></div>

    <section class="di-card di-panel">
        <div class="di-panel-head">
            <div>
                <div class="di-panel-kicker">Device List</div>
                <h2 class="di-panel-title">Danh sách thiết bị</h2>
                <div class="di-panel-note">
                    Dữ liệu được lấy từ endpoint <b>/api/elitech/device-info</b>
                </div>
            </div>

            <div id="loading" class="di-loading">
                <span class="di-spinner"></span>
                Đang tải dữ liệu...
            </div>
        </div>

        <div class="di-table-wrap">
            <table class="di-table" id="tbl">
                <thead>
                    <tr>
                        <th>Tên thiết bị</th>
                        <th>GUID</th>
                        <th>Loại thiết bị</th>
                        <th>Scene</th>
                        <th>SubUID</th>
                        <th>SMS</th>
                        <th>Voice</th>
                        <th>Hết hạn</th>
                        <th>Lần cuối</th>
                    </tr>
                </thead>
                <tbody id="body">
                    <tr>
                        <td colspan="9" class="di-empty">
                            <div class="di-empty-icon">
                                <i class="bi bi-inbox-fill"></i>
                            </div>
                            Chưa có dữ liệu. Nhập GUID rồi bấm Load hoặc Fetch via API.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

<script>
    const initialDeviceGuids = @Html.Raw(deviceGuidsJson);

    const input = document.getElementById('deviceGuidsInput');
    const body = document.getElementById('body');
    const err = document.getElementById('err');
    const loading = document.getElementById('loading');
    const btnFetch = document.getElementById('btnFetch');
    const btnClear = document.getElementById('btnClear');
    const guidShow = document.getElementById('guidShow');

    const statTotal = document.getElementById('statTotal');
    const statSms = document.getElementById('statSms');
    const statVoice = document.getElementById('statVoice');
    const statExpired = document.getElementById('statExpired');

    const toast = document.getElementById('diToast');
    const toastTitle = document.getElementById('diToastTitle');
    const toastMsg = document.getElementById('diToastMsg');

    function getDeviceGuids() {
        return (input?.value || initialDeviceGuids || '').trim();
    }

    function showToast(title, message) {
        if (!toast || !toastTitle || !toastMsg) return;

        toastTitle.textContent = title || 'Thông báo';
        toastMsg.textContent = message || '';
        toast.classList.add('show');

        clearTimeout(window.__diToastTimer);
        window.__diToastTimer = setTimeout(() => toast.classList.remove('show'), 1800);
    }

    function showErr(message) {
        err.textContent = message;
        err.classList.add('show');
    }

    function hideErr() {
        err.classList.remove('show');
        err.textContent = '';
    }

    function setLoading(isLoading) {
        loading.classList.toggle('show', !!isLoading);
        btnFetch.disabled = isLoading;
        btnFetch.innerHTML = isLoading
            ? '<i class="bi bi-arrow-repeat"></i> Đang fetch...'
            : '<i class="bi bi-lightning-charge-fill"></i> Fetch via API';
    }

    function esc(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function fmtTime(sec) {
        if (!sec) return '-';
        return new Date(sec * 1000).toLocaleString('vi-VN');
    }

    function num(value) {
        const n = Number(value);
        return Number.isFinite(n) ? n : 0;
    }

    function resetStats() {
        statTotal.textContent = '0';
        statSms.textContent = '0';
        statVoice.textContent = '0';
        statExpired.textContent = '0';
    }

    function renderEmpty(message) {
        body.innerHTML = `
                <tr>
                    <td colspan="9" class="di-empty">
                        <div class="di-empty-icon">
                            <i class="bi bi-inbox-fill"></i>
                        </div>
                        ${esc(message)}
                    </td>
                </tr>
            `;
        resetStats();
    }

    function renderRows(rows) {
        const total = rows.length;
        const totalSms = rows.reduce((sum, x) => sum + num(x.smsCount), 0);
        const totalVoice = rows.reduce((sum, x) => sum + num(x.voiceCount), 0);
        const totalExpired = rows.filter(x => !!x.expiredTime).length;

        statTotal.textContent = total;
        statSms.textContent = totalSms;
        statVoice.textContent = totalVoice;
        statExpired.textContent = totalExpired;

        if (total === 0) {
            renderEmpty('Không có dữ liệu từ API.');
            return;
        }

        body.innerHTML = rows.map(x => {
            const guid = x.deviceGuid || '-';
            const expiredText = x.expiredTime ? fmtTime(x.expiredTime) : '-';
            const lastText = x.lastTimeStr || (x.lastTime ? fmtTime(x.lastTime) : '-');

            return `
                    <tr>
                        <td>
                            <div class="di-device-name">${esc(x.deviceName || '-')}</div>
                            <div class="di-device-sub">Elitech device</div>
                        </td>

                        <td>
                            <code class="di-code" title="${esc(guid)}">${esc(guid)}</code>
                            ${guid !== '-' ? `<button type="button" class="di-copy-btn" data-guid="${esc(guid)}">Copy</button>` : ''}
                        </td>

                        <td>
                            <span class="di-pill blue">${esc(x.deviceTypeName || '-')}</span>
                        </td>

                        <td>${esc(x.sceneName || '-')}</td>

                        <td>
                            <span class="di-pill gray">${esc(x.subUid ?? '-')}</span>
                        </td>

                        <td>
                            <span class="di-pill green">${esc(x.smsCount ?? 0)}</span>
                        </td>

                        <td>
                            <span class="di-pill orange">${esc(x.voiceCount ?? 0)}</span>
                        </td>

                        <td>${esc(expiredText)}</td>

                        <td>${esc(lastText)}</td>
                    </tr>
                `;
        }).join('');
    }

    async function copyText(text) {
        try {
            await navigator.clipboard.writeText(text);
        } catch {
            const temp = document.createElement('textarea');
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            temp.remove();
        }
    }

    async function fetchInfo() {
        const deviceGuids = getDeviceGuids();

        if (!deviceGuids) {
            showErr('Hãy nhập deviceGuids trước khi fetch.');
            renderEmpty('Chưa có dữ liệu. Nhập GUID rồi bấm Load hoặc Fetch via API.');
            return;
        }

        guidShow.textContent = deviceGuids;
        hideErr();
        setLoading(true);

        try {
            const url = `/api/elitech/device-info?deviceGuids=${encodeURIComponent(deviceGuids)}`;
            const res = await fetch(url, { cache: 'no-store' });

            if (!res.ok) {
                let text = await res.text().catch(() => '');

                try {
                    const parsed = JSON.parse(text);
                    text = parsed.message || text;
                } catch { }

                showErr(`API lỗi: ${res.status} — ${text || 'Không đọc được nội dung lỗi.'}`);
                renderEmpty('Không tải được dữ liệu.');
                return;
            }

            const json = await res.json();
            const rows = json?.data ?? [];

            renderRows(rows);
            showToast('Device info loaded', `Đã tải ${rows.length} thiết bị.`);
        } catch (e) {
            showErr(`Không gọi được API: ${e?.message || e}`);
            renderEmpty('Không tải được dữ liệu.');
        } finally {
            setLoading(false);
        }
    }

    btnFetch.addEventListener('click', fetchInfo);

    btnClear.addEventListener('click', () => {
        input.value = '';
        guidShow.textContent = 'Chưa nhập';
        hideErr();
        renderEmpty('Chưa có dữ liệu. Nhập GUID rồi bấm Load hoặc Fetch via API.');
    });

    input.addEventListener('input', () => {
        const value = getDeviceGuids();
        guidShow.textContent = value || 'Chưa nhập';
    });

    body.addEventListener('click', async function(e) {
        const btn = e.target.closest('.di-copy-btn');
        if (!btn) return;

        const guid = btn.getAttribute('data-guid');
        await copyText(guid);

        const oldText = btn.textContent;
        btn.textContent = 'Copied';
        showToast('Đã copy GUID', guid);

        setTimeout(() => btn.textContent = oldText, 900);
    });

    if (getDeviceGuids()) {
        fetchInfo();
    }
</script>
