@model Elitech.Controllers.LoginController.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
    var showRegister = (ViewBag.IsRegister as bool?) == true;
}

<style>
    :root {
        --lx-black: #050507;
        --lx-ink: #0f172a;
        --lx-muted: #64748b;
        --lx-soft: #f5f7fb;
        --lx-card: rgba(255,255,255,.92);
        --lx-line: rgba(226,232,240,.88);
        --lx-line-dark: rgba(255,255,255,.16);
        --lx-blue: #0a84ff;
        --lx-blue-2: #38bdf8;
        --lx-orange: #f58220;
        --lx-orange-2: #ffb25b;
        --lx-green: #22c55e;
        --lx-red: #ef4444;
        --lx-radius-xl: 38px;
        --lx-radius-lg: 26px;
        --lx-radius-md: 18px;
        --lx-shadow: 0 34px 100px rgba(2,6,23,.24);
        --lx-shadow-soft: 0 18px 48px rgba(15,23,42,.12);
    }

    html,
    body {
        max-width: 100%;
        overflow-x: hidden;
    }

    body {
        background: #050507 !important;
        color: var(--lx-ink);
    }

    .elx-main {
        padding: 0 !important;
        background: transparent !important;
    }

    .login-apple-page {
        position: relative;
        min-height: calc(100vh - 92px);
        overflow: hidden;
        color: #f5f5f7;
        background: radial-gradient(960px 560px at 14% 8%, rgba(245,130,32,.28), transparent 62%), radial-gradient(860px 560px at 88% 10%, rgba(10,132,255,.25), transparent 60%), linear-gradient(135deg, #030305 0%, #080b12 54%, #111827 100%);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        isolation: isolate;
    }

    .login-hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: .48;
        z-index: -4;
        transform: scale(1.02);
        filter: saturate(1.05) contrast(1.04);
    }

    .login-apple-page::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -3;
        background: linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.055) 1px, transparent 1px);
        background-size: 72px 72px;
        opacity: .42;
        mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 100%);
        -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 100%);
        pointer-events: none;
    }

    .login-apple-page::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -2;
        background: radial-gradient(900px 620px at 18% 44%, rgba(0,0,0,.08), transparent 58%), radial-gradient(900px 640px at 82% 42%, rgba(0,0,0,.22), transparent 58%), linear-gradient(90deg, rgba(0,0,0,.28) 0%, rgba(0,0,0,.16) 46%, rgba(0,0,0,.58) 100%), linear-gradient(180deg, rgba(0,0,0,.15) 0%, rgba(0,0,0,.40) 100%);
        pointer-events: none;
    }

    .login-apple-shell {
        position: relative;
        z-index: 2;
        width: min(1440px, 100%);
        margin: 0 auto;
        min-height: calc(100vh - 92px);
        padding: clamp(22px, 4vw, 60px) 22px;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(390px, .72fr);
        gap: clamp(22px, 4vw, 58px);
        align-items: center;
    }

    .login-hero-copy {
        position: relative;
        min-width: 0;
        padding: 16px 0;
    }

    .lx-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 40px;
        padding: 8px 14px;
        border-radius: 999px;
        color: rgba(245,245,247,.90);
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.16);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
        backdrop-filter: blur(18px) saturate(160%);
        -webkit-backdrop-filter: blur(18px) saturate(160%);
        font-size: .78rem;
        font-weight: 1000;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

        .lx-eyebrow i {
            color: var(--lx-orange-2);
        }

    .lx-title {
        margin: 24px 0 0;
        max-width: 940px;
        color: #fff;
        font-size: clamp(3.35rem, 7.3vw, 8.4rem);
        line-height: .86;
        letter-spacing: -.087em;
        font-weight: 1000;
        text-shadow: 0 24px 80px rgba(0,0,0,.34);
    }

        .lx-title span {
            color: transparent;
            background: linear-gradient(90deg, #fff 0%, #dbeafe 36%, #ffb25b 74%, #f58220 100%);
            -webkit-background-clip: text;
            background-clip: text;
        }

    .lx-lead {
        max-width: 790px;
        margin: 24px 0 0;
        color: rgba(245,245,247,.78);
        font-size: clamp(1rem, 1.35vw, 1.2rem);
        line-height: 1.68;
        font-weight: 720;
        letter-spacing: -.012em;
        text-shadow: 0 14px 42px rgba(0,0,0,.32);
    }

    .lx-chips {
        margin-top: 28px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .lx-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 8px 13px;
        border-radius: 999px;
        color: rgba(245,245,247,.84);
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.15);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        font-size: .82rem;
        font-weight: 900;
    }

        .lx-chip i {
            color: var(--lx-orange-2);
        }

    .lx-visual-row {
        margin-top: 34px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, .42fr);
        gap: 14px;
        max-width: 820px;
    }

    .lx-monitor-card,
    .lx-mini-stack,
    .lx-mini-card {
        border: 1px solid rgba(255,255,255,.15);
        background: rgba(255,255,255,.10);
        box-shadow: 0 22px 70px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.08);
        backdrop-filter: blur(22px) saturate(160%);
        -webkit-backdrop-filter: blur(22px) saturate(160%);
    }

    .lx-monitor-card {
        border-radius: 32px;
        padding: 18px;
        overflow: hidden;
    }

    .lx-monitor-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .lx-monitor-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .lx-monitor-icon {
        width: 46px;
        height: 46px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        color: #101827;
        background: linear-gradient(135deg, var(--lx-orange), var(--lx-orange-2));
        box-shadow: 0 16px 34px rgba(245,130,32,.28);
        flex: 0 0 auto;
    }

    .lx-monitor-name {
        color: #fff;
        font-size: 1.02rem;
        line-height: 1.05;
        font-weight: 1000;
        letter-spacing: -.03em;
    }

    .lx-monitor-sub {
        margin-top: 4px;
        color: rgba(245,245,247,.58);
        font-size: .78rem;
        font-weight: 820;
    }

    .lx-live {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 11px;
        border-radius: 999px;
        color: #dcfce7;
        background: rgba(34,197,94,.15);
        border: 1px solid rgba(34,197,94,.22);
        font-size: .78rem;
        font-weight: 1000;
        white-space: nowrap;
    }

        .lx-live::before {
            content: "";
            width: 9px;
            height: 9px;
            border-radius: 999px;
            background: var(--lx-green);
            box-shadow: 0 0 0 6px rgba(34,197,94,.12);
        }

    .lx-status-grid {
        margin-top: 16px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .lx-status-main {
        grid-column: 1 / -1;
        min-height: 154px;
        border-radius: 26px;
        padding: 16px;
        background: linear-gradient(90deg, rgba(255,255,255,.07) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(135deg, rgba(10,132,255,.22), rgba(255,255,255,.07));
        background-size: 28px 28px, 28px 28px, auto;
        border: 1px solid rgba(255,255,255,.12);
        overflow: hidden;
    }

    .lx-status-k {
        color: rgba(245,245,247,.56);
        font-size: .72rem;
        font-weight: 1000;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .lx-status-v {
        margin-top: 8px;
        color: #fff;
        font-size: 2.5rem;
        line-height: 1;
        letter-spacing: -.06em;
        font-weight: 1000;
    }

        .lx-status-v small {
            font-size: 1rem;
            color: rgba(245,245,247,.62);
            letter-spacing: -.02em;
        }

    .lx-bars {
        height: 58px;
        margin-top: 18px;
        display: flex;
        align-items: end;
        gap: 8px;
    }

        .lx-bars span {
            flex: 1;
            border-radius: 999px 999px 8px 8px;
            background: linear-gradient(180deg, #fff, rgba(10,132,255,.55));
            opacity: .90;
        }

            .lx-bars span:nth-child(3),
            .lx-bars span:nth-child(6) {
                background: linear-gradient(180deg, #ffb25b, rgba(245,130,32,.60));
            }

    .lx-mini-stack {
        border-radius: 32px;
        padding: 14px;
        display: grid;
        gap: 12px;
    }

    .lx-mini-card {
        min-height: 82px;
        border-radius: 22px;
        padding: 14px;
    }

        .lx-mini-card b {
            display: block;
            color: #fff;
            font-size: 1.28rem;
            line-height: 1;
            font-weight: 1000;
            letter-spacing: -.045em;
        }

        .lx-mini-card span {
            display: block;
            margin-top: 6px;
            color: rgba(245,245,247,.58);
            font-size: .76rem;
            line-height: 1.35;
            font-weight: 820;
        }

    .auth-panel-wrap {
        position: relative;
        width: 100%;
        max-width: 520px;
        justify-self: end;
    }

        .auth-panel-wrap::before,
        .auth-panel-wrap::after {
            content: "";
            position: absolute;
            border-radius: 999px;
            filter: blur(2px);
            pointer-events: none;
        }

        .auth-panel-wrap::before {
            width: 250px;
            height: 250px;
            right: -80px;
            top: -90px;
            background: radial-gradient(circle, rgba(245,130,32,.34), transparent 68%);
        }

        .auth-panel-wrap::after {
            width: 260px;
            height: 260px;
            left: -90px;
            bottom: -100px;
            background: radial-gradient(circle, rgba(10,132,255,.27), transparent 70%);
        }

    .auth-card {
        position: relative;
        z-index: 2;
        border-radius: var(--lx-radius-xl);
        padding: clamp(20px, 3vw, 30px);
        color: var(--lx-ink);
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(255,255,255,.78);
        box-shadow: var(--lx-shadow);
        overflow: hidden;
        backdrop-filter: blur(26px) saturate(170%);
        -webkit-backdrop-filter: blur(26px) saturate(170%);
    }

        .auth-card::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(460px 260px at 100% 0%, rgba(10,132,255,.12), transparent 62%), radial-gradient(460px 280px at 0% 100%, rgba(245,130,32,.11), transparent 66%);
        }

    .auth-inner {
        position: relative;
        z-index: 2;
    }

    .auth-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        padding: 7px;
        border-radius: 999px;
        background: rgba(226,232,240,.88);
        border: 1px solid rgba(203,213,225,.86);
        margin-bottom: 26px;
    }

    .auth-tab {
        height: 48px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: #475569;
        font-size: .94rem;
        font-weight: 1000;
        cursor: pointer;
        transition: transform .15s ease, background .15s ease, color .15s ease, box-shadow .15s ease;
    }

        .auth-tab:hover {
            transform: translateY(-1px);
        }

        .auth-tab.active {
            color: var(--lx-ink);
            background: #fff;
            box-shadow: 0 12px 30px rgba(15,23,42,.10);
        }

    .auth-panel {
        display: none;
    }

        .auth-panel.active {
            display: block;
            animation: authFade .18s ease-out;
        }

    @@keyframes authFade {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .auth-title {
        margin: 0;
        color: var(--lx-ink);
        font-size: clamp(2rem, 3vw, 2.72rem);
        line-height: .96;
        font-weight: 1000;
        letter-spacing: -.07em;
    }

    .auth-sub {
        margin: 12px 0 0;
        color: var(--lx-muted);
        font-size: .96rem;
        line-height: 1.55;
        font-weight: 760;
    }

    .auth-alert {
        margin-top: 16px;
        border-radius: 20px;
        border: 1px solid transparent;
        padding: 12px 14px;
        font-weight: 850;
        line-height: 1.45;
    }

        .auth-alert.success {
            color: #047857;
            background: #ecfdf5;
            border-color: #bbf7d0;
        }

        .auth-alert.error {
            color: #b91c1c;
            background: #fef2f2;
            border-color: #fecaca;
        }

    .auth-form {
        margin-top: 22px;
        display: grid;
        gap: 14px;
    }

    .auth-field label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: .86rem;
        font-weight: 950;
    }

    .auth-input-group {
        display: grid;
        grid-template-columns: 54px minmax(0, 1fr) 58px;
        min-height: 58px;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #dbe5f2;
        background: #f8fafc;
        transition: box-shadow .15s ease, border-color .15s ease, background .15s ease;
    }

        .auth-input-group.no-eye {
            grid-template-columns: 54px minmax(0, 1fr);
        }

        .auth-input-group:focus-within {
            border-color: rgba(10,132,255,.56);
            box-shadow: 0 0 0 4px rgba(10,132,255,.13);
            background: #fff;
        }

    .auth-input-icon {
        display: grid;
        place-items: center;
        color: #64748b;
        background: rgba(226,232,240,.62);
    }

    .auth-input-group input {
        min-width: 0;
        border: 0 !important;
        outline: 0 !important;
        box-shadow: none !important;
        background: transparent !important;
        padding: 0 14px;
        color: var(--lx-ink);
        font-weight: 850;
    }

        .auth-input-group input::placeholder {
            color: #94a3b8;
            font-weight: 750;
        }

    .auth-eye {
        width: 58px;
        border: 0;
        background: #fff;
        color: #64748b;
        border-left: 1px solid #dbe5f2;
        cursor: pointer;
        transition: color .15s ease, background .15s ease;
    }

        .auth-eye:hover {
            color: var(--lx-blue);
            background: #f8fafc;
        }

    .auth-submit {
        min-height: 60px;
        border: 0;
        border-radius: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #fff;
        background: linear-gradient(135deg, #0a84ff, #38bdf8);
        font-size: .98rem;
        font-weight: 1000;
        box-shadow: 0 20px 48px rgba(10,132,255,.27);
        transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
    }

        .auth-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 26px 60px rgba(10,132,255,.33);
            filter: saturate(1.04);
        }

        .auth-submit.register {
            color: #111827;
            background: linear-gradient(135deg, var(--lx-orange), var(--lx-orange-2));
            box-shadow: 0 20px 48px rgba(245,130,32,.24);
        }

    .auth-links {
        margin-top: 18px;
        display: grid;
        gap: 10px;
    }

    .auth-link-btn {
        min-height: 52px;
        border-radius: 20px;
        border: 1px solid #dbe5f2;
        background: rgba(255,255,255,.78);
        color: var(--lx-ink);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        text-decoration: none !important;
        font-weight: 950;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

        .auth-link-btn:hover {
            transform: translateY(-1px);
            color: var(--lx-ink);
            background: #fff;
            box-shadow: 0 16px 36px rgba(15,23,42,.10);
        }

    .auth-policy {
        margin-top: 18px;
        color: var(--lx-muted);
        font-size: .83rem;
        line-height: 1.52;
        font-weight: 720;
    }

        .auth-policy a {
            color: var(--lx-blue);
            text-decoration: none;
            font-weight: 950;
        }

            .auth-policy a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 1120px) {
        .login-apple-shell {
            grid-template-columns: 1fr;
            min-height: auto;
            padding-top: 46px;
            padding-bottom: 46px;
        }

        .auth-panel-wrap {
            justify-self: center;
            max-width: 640px;
        }

        .login-hero-copy {
            text-align: center;
        }

        .lx-lead,
        .lx-title,
        .lx-visual-row {
            margin-left: auto;
            margin-right: auto;
        }

        .lx-chips {
            justify-content: center;
        }
    }

    @@media (max-width: 768px) {
        .login-apple-page,
        .login-apple-shell {
            min-height: auto;
        }

        .login-apple-shell {
            padding: 34px 14px 40px;
            gap: 26px;
        }

        .lx-title {
            font-size: 3.35rem;
        }

        .lx-visual-row {
            grid-template-columns: 1fr;
        }

        .lx-status-grid {
            grid-template-columns: 1fr;
        }

        .auth-card {
            border-radius: 30px;
        }
    }

    @@media (max-width: 520px) {
        .lx-title {
            font-size: 2.78rem;
        }

        .lx-lead {
            font-size: .96rem;
        }

        .lx-monitor-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .auth-input-group {
            grid-template-columns: 48px minmax(0, 1fr) 52px;
        }

            .auth-input-group.no-eye {
                grid-template-columns: 48px minmax(0, 1fr);
            }

        .auth-eye {
            width: 52px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        * {
            transition: none !important;
            animation: none !important;
            scroll-behavior: auto !important;
        }

        .login-hero-video {
            display: none;
        }
    }
</style>

<div class="login-apple-page">
    <video class="login-hero-video"
           autoplay
           muted
           loop
           playsinline
           preload="metadata"
           poster="/videos/login-hero-poster.jpg">
        <source src="/videos/login-hero.mp4" type="video/mp4" />
    </video>

    <div class="login-apple-shell">
        <section class="login-hero-copy">
            <div class="lx-eyebrow">
                <i class="bi bi-shield-lock-fill"></i>
                Elitech Vietnam Secure Access
            </div>

            <h1 class="lx-title">
                Access the<br />Command <span>Center.</span>
            </h1>

            <p class="lx-lead">
                Sign in to Elitech Vietnam’s monitoring platform — built for realtime visibility,
                intelligent alerts, secure access, SMS notifications, and trusted cold-chain operations.
            </p>

            <div class="lx-chips">
                <span class="lx-chip"><i class="bi bi-broadcast-pin"></i> Realtime monitoring</span>
                <span class="lx-chip"><i class="bi bi-bell-fill"></i> Alert & SMS</span>
                <span class="lx-chip"><i class="bi bi-shield-check"></i> Secure session</span>
                <span class="lx-chip"><i class="bi bi-filetype-pdf"></i> PDF report</span>
            </div>

            <div class="lx-visual-row" aria-hidden="true">
                <div class="lx-monitor-card">
                    <div class="lx-monitor-head">
                        <div class="lx-monitor-brand">
                            <div class="lx-monitor-icon"><i class="bi bi-command"></i></div>
                            <div>
                                <div class="lx-monitor-name">Elitech Operation Deck</div>
                                <div class="lx-monitor-sub">Device • Alert • Report • Access</div>
                            </div>
                        </div>
                        <div class="lx-live">Online</div>
                    </div>

                    <div class="lx-status-grid">
                        <div class="lx-status-main">
                            <div class="lx-status-k">Cold chain status</div>
                            <div class="lx-status-v">24.8<small>°C</small></div>
                            <div class="lx-bars">
                                <span style="height:42%"></span>
                                <span style="height:64%"></span>
                                <span style="height:53%"></span>
                                <span style="height:78%"></span>
                                <span style="height:58%"></span>
                                <span style="height:68%"></span>
                                <span style="height:50%"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lx-mini-stack">
                    <div class="lx-mini-card"><b>SMS</b><span>Auto alert channel</span></div>
                    <div class="lx-mini-card"><b>Auth</b><span>Role-based access</span></div>
                    <div class="lx-mini-card"><b>PDF</b><span>Operation report</span></div>
                </div>
            </div>
        </section>

        <section class="auth-panel-wrap">
            <div class="auth-card">
                <div class="auth-inner">
                    <div class="auth-tabs" role="tablist">
                        <button type="button" class="auth-tab @(showRegister ? "" : "active")" id="tabLogin" onclick="showAuthPanel('login')">
                            Đăng nhập
                        </button>
                        <button type="button" class="auth-tab @(showRegister ? "active" : "")" id="tabRegister" onclick="showAuthPanel('register')">
                            Đăng ký
                        </button>
                    </div>

                    @if (TempData["RegisterSuccess"] != null)
                    {
                        <div class="auth-alert success">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            @TempData["RegisterSuccess"]
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="auth-alert error">
                            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div><i class="bi bi-exclamation-triangle-fill me-1"></i>@e.ErrorMessage</div>
                            }
                        </div>
                    }

                    <div class="auth-panel @(showRegister ? "" : "active")" id="panelLogin">
                        <h2 class="auth-title">Welcome to Elitech Viet Nam.</h2>
                        <p class="auth-sub">Continue to your Elitech Command Center and manage every device with confidence.</p>

                        <form asp-controller="Login" asp-action="Index" method="post" class="auth-form needs-validation" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="auth-field">
                                <label>Email hoặc tên đăng nhập</label>
                                <div class="auth-input-group no-eye">
                                    <span class="auth-input-icon"><i class="bi bi-person-fill"></i></span>
                                    <input asp-for="Username" autocomplete="username" placeholder="VD: admin" required />
                                </div>
                            </div>

                            <div class="auth-field">
                                <label>Mật khẩu</label>
                                <div class="auth-input-group">
                                    <span class="auth-input-icon"><i class="bi bi-key-fill"></i></span>
                                    <input asp-for="Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required />
                                    <button type="button" class="auth-eye" onclick="togglePwd(this)" aria-label="Hiện/ẩn mật khẩu">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <button type="submit" class="auth-submit">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Đăng nhập
                            </button>
                        </form>
                    </div>

                    <div class="auth-panel @(showRegister ? "active" : "")" id="panelRegister">
                        <h2 class="auth-title">Create your account.</h2>
                        <p class="auth-sub">Start your journey with smarter monitoring, safer operations, and trusted data.</p>

                        <form asp-controller="Login" asp-action="Register" method="post" class="auth-form">
                            @Html.AntiForgeryToken()

                            <div class="auth-field">
                                <label>Tên đăng nhập</label>
                                <div class="auth-input-group no-eye">
                                    <span class="auth-input-icon"><i class="bi bi-person-plus-fill"></i></span>
                                    <input name="username" autocomplete="username" placeholder="Tên đăng nhập" required />
                                </div>
                            </div>

                            <div class="auth-field">
                                <label>Email</label>
                                <div class="auth-input-group no-eye">
                                    <span class="auth-input-icon"><i class="bi bi-envelope-fill"></i></span>
                                    <input name="email" type="email" autocomplete="email" placeholder="Email" required />
                                </div>
                            </div>

                            <div class="auth-field">
                                <label>Mật khẩu</label>
                                <div class="auth-input-group">
                                    <span class="auth-input-icon"><i class="bi bi-lock-fill"></i></span>
                                    <input name="password" type="password" autocomplete="new-password" placeholder="Mật khẩu" required />
                                    <button type="button" class="auth-eye" onclick="togglePwd(this)" aria-label="Hiện/ẩn mật khẩu">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="auth-field">
                                <label>Nhập lại mật khẩu</label>
                                <div class="auth-input-group">
                                    <span class="auth-input-icon"><i class="bi bi-shield-lock-fill"></i></span>
                                    <input name="confirmPassword" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu" required />
                                    <button type="button" class="auth-eye" onclick="togglePwd(this)" aria-label="Hiện/ẩn mật khẩu">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <button type="submit" class="auth-submit register">
                                <i class="bi bi-person-check-fill"></i>
                                Đăng ký
                            </button>
                        </form>
                    </div>

                    <div class="auth-links">
                        <a class="auth-link-btn" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door-fill"></i>
                            Về trang chủ
                        </a>
                    </div>

                    <div class="auth-policy">
                        Bằng việc đăng nhập hoặc đăng ký, bạn đồng ý với
                        <a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a>
                        và điều khoản sử dụng hệ thống Elitech.
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        function showAuthPanel(mode) {
            const isRegister = mode === 'register';

            document.getElementById('tabLogin')?.classList.toggle('active', !isRegister);
            document.getElementById('tabRegister')?.classList.toggle('active', isRegister);
            document.getElementById('panelLogin')?.classList.toggle('active', !isRegister);
            document.getElementById('panelRegister')?.classList.toggle('active', isRegister);
        }

        function togglePwd(btn) {
            const wrap = btn.closest('.auth-input-group');
            const input = wrap?.querySelector('input[type="password"], input[type="text"]');
            const icon = btn.querySelector('i');
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        (function() {
            const forms = document.querySelectorAll('.needs-validation');
            forms.forEach(form => {
                form.addEventListener('submit', function(event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
