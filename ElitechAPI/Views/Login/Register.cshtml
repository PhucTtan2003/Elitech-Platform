@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

<style>
    :root {
        --rx-orange: #f58220;
        --rx-orange-2: #ffb25b;
        --rx-blue: #0a84ff;
        --rx-blue-2: #38bdf8;
        --rx-green: #22c55e;
        --rx-red: #ef4444;
        --rx-ink: #0f172a;
        --rx-muted: #64748b;
        --rx-soft: #f6f8fc;
        --rx-card: rgba(255,255,255,.90);
        --rx-line: rgba(255,255,255,.18);
        --rx-line-light: rgba(226,232,240,.92);
        --rx-shadow: 0 32px 100px rgba(2,6,23,.36);
        --rx-shadow-soft: 0 16px 42px rgba(15,23,42,.10);
    }

    body {
        background: #030712 !important;
        overflow-x: hidden;
    }

    .elx-main {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        background: transparent !important;
    }

    .register-apple {
        position: relative;
        min-height: calc(100vh - 110px);
        overflow: hidden;
        color: #fff;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        isolation: isolate;
        background: radial-gradient(900px 560px at 12% 6%, rgba(10,132,255,.34), transparent 62%), radial-gradient(820px 520px at 92% 8%, rgba(245,130,32,.30), transparent 64%), linear-gradient(145deg, #020617 0%, #07111f 52%, #030712 100%);
    }

    .rx-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -5;
        opacity: .34;
        filter: saturate(1.08) contrast(1.04);
        transform: scale(1.02);
    }

    .register-apple::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -4;
        background: linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.045) 1px, transparent 1px);
        background-size: 72px 72px;
        mask-image: linear-gradient(180deg, rgba(0,0,0,.95), rgba(0,0,0,.70) 58%, transparent 100%);
        -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,.95), rgba(0,0,0,.70) 58%, transparent 100%);
        pointer-events: none;
    }

    .register-apple::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -3;
        background: radial-gradient(720px 460px at 26% 48%, rgba(255,255,255,.08), transparent 64%), linear-gradient(90deg, rgba(2,6,23,.78) 0%, rgba(2,6,23,.34) 48%, rgba(2,6,23,.82) 100%), linear-gradient(180deg, rgba(2,6,23,.18) 0%, rgba(2,6,23,.78) 100%);
        pointer-events: none;
    }

    .rx-shell {
        position: relative;
        z-index: 2;
        width: min(1440px, calc(100% - 32px));
        margin: 0 auto;
        padding: clamp(34px, 5vw, 72px) 0 clamp(44px, 5vw, 82px);
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(390px, .72fr);
        gap: clamp(24px, 4vw, 60px);
        align-items: center;
    }

    .rx-hero {
        min-width: 0;
        padding: clamp(8px, 2vw, 20px) 0;
    }

    .rx-eyebrow {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 9px 14px;
        border-radius: 999px;
        color: rgba(255,255,255,.88);
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.15);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
        backdrop-filter: blur(16px) saturate(150%);
        -webkit-backdrop-filter: blur(16px) saturate(150%);
        font-size: .78rem;
        font-weight: 1000;
        text-transform: uppercase;
        letter-spacing: .13em;
    }

        .rx-eyebrow i {
            color: var(--rx-orange-2);
        }

    .rx-title {
        margin: 22px 0 0;
        max-width: 920px;
        font-size: clamp(3.35rem, 7.6vw, 8.15rem);
        line-height: .87;
        letter-spacing: -.087em;
        font-weight: 1000;
        color: #fff;
        text-shadow: 0 20px 70px rgba(0,0,0,.32);
    }

        .rx-title span {
            display: inline-block;
            color: transparent;
            background: linear-gradient(90deg, #fff 0%, #dbeafe 34%, #ffcf92 68%, #f58220 100%);
            -webkit-background-clip: text;
            background-clip: text;
        }

    .rx-lead {
        max-width: 800px;
        margin: 26px 0 0;
        color: rgba(226,232,240,.78);
        font-size: clamp(1rem, 1.35vw, 1.2rem);
        line-height: 1.72;
        font-weight: 720;
        text-shadow: 0 12px 34px rgba(0,0,0,.26);
    }

    .rx-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .rx-btn {
        min-height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 20px;
        border-radius: 999px;
        text-decoration: none !important;
        font-weight: 1000;
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
        border: 1px solid rgba(255,255,255,.14);
    }

        .rx-btn:hover {
            transform: translateY(-3px);
        }

        .rx-btn.primary {
            color: #06111f;
            background: linear-gradient(135deg, #fff, #dbeafe);
            box-shadow: 0 18px 48px rgba(255,255,255,.12);
        }

        .rx-btn.glass {
            color: #fff;
            background: rgba(255,255,255,.09);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }

    .rx-trust-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 26px;
    }

    .rx-trust {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 0 13px;
        border-radius: 999px;
        color: rgba(226,232,240,.80);
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        font-size: .82rem;
        font-weight: 900;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

        .rx-trust i {
            color: var(--rx-orange-2);
        }

    .rx-deck {
        margin-top: 42px;
        max-width: 820px;
        border-radius: 34px;
        padding: 16px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.14);
        box-shadow: 0 26px 80px rgba(0,0,0,.26);
        backdrop-filter: blur(18px) saturate(150%);
        -webkit-backdrop-filter: blur(18px) saturate(150%);
    }

    .rx-deck-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .rx-deck-brand {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .rx-deck-mark {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        color: #06111f;
        background: linear-gradient(135deg, var(--rx-orange), var(--rx-orange-2));
        box-shadow: 0 16px 34px rgba(245,130,32,.24);
        flex: 0 0 auto;
    }

    .rx-deck-title {
        color: #fff;
        font-weight: 1000;
        letter-spacing: -.03em;
    }

    .rx-deck-sub {
        margin-top: 3px;
        color: rgba(226,232,240,.58);
        font-size: .78rem;
        font-weight: 780;
    }

    .rx-live {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 11px;
        border-radius: 999px;
        color: #dcfce7;
        background: rgba(34,197,94,.14);
        border: 1px solid rgba(34,197,94,.22);
        font-size: .78rem;
        font-weight: 1000;
        white-space: nowrap;
    }

        .rx-live::before {
            content: "";
            width: 9px;
            height: 9px;
            border-radius: 999px;
            background: var(--rx-green);
            box-shadow: 0 0 0 6px rgba(34,197,94,.13);
        }

    .rx-mini-grid {
        display: grid;
        grid-template-columns: 1.2fr .8fr .8fr;
        gap: 12px;
    }

    .rx-mini {
        min-height: 112px;
        border-radius: 24px;
        padding: 16px;
        overflow: hidden;
        position: relative;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
    }

        .rx-mini::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -78px;
            bottom: -92px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(10,132,255,.32), transparent 70%);
        }

        .rx-mini.orange::after {
            background: radial-gradient(circle, rgba(245,130,32,.36), transparent 70%);
        }

    .rx-mini-k {
        position: relative;
        z-index: 1;
        color: rgba(226,232,240,.60);
        font-size: .72rem;
        font-weight: 1000;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .rx-mini-v {
        position: relative;
        z-index: 1;
        margin-top: 10px;
        color: #fff;
        font-size: 1.8rem;
        line-height: 1;
        font-weight: 1000;
        letter-spacing: -.055em;
    }

    .rx-mini-s {
        position: relative;
        z-index: 1;
        margin-top: 8px;
        color: rgba(226,232,240,.60);
        font-size: .78rem;
        font-weight: 760;
        line-height: 1.35;
    }

    .rx-card-wrap {
        position: relative;
        min-width: 0;
    }

        .rx-card-wrap::before,
        .rx-card-wrap::after {
            content: "";
            position: absolute;
            border-radius: 999px;
            pointer-events: none;
            filter: blur(2px);
        }

        .rx-card-wrap::before {
            width: 210px;
            height: 210px;
            right: -68px;
            top: -72px;
            background: radial-gradient(circle, rgba(245,130,32,.42), transparent 70%);
        }

        .rx-card-wrap::after {
            width: 180px;
            height: 180px;
            left: -56px;
            bottom: -58px;
            background: radial-gradient(circle, rgba(10,132,255,.35), transparent 70%);
        }

    .rx-card {
        position: relative;
        z-index: 2;
        overflow: hidden;
        border-radius: 38px;
        color: var(--rx-ink);
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(255,255,255,.72);
        box-shadow: var(--rx-shadow);
        backdrop-filter: blur(26px) saturate(150%);
        -webkit-backdrop-filter: blur(26px) saturate(150%);
    }

        .rx-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(520px 260px at 100% 0%, rgba(245,130,32,.13), transparent 60%), radial-gradient(500px 260px at 0% 0%, rgba(10,132,255,.12), transparent 58%);
            pointer-events: none;
        }

    .rx-card-inner {
        position: relative;
        z-index: 2;
    }

    .rx-card-top {
        padding: clamp(22px, 3vw, 30px) clamp(22px, 3vw, 30px) 20px;
        border-bottom: 1px solid rgba(226,232,240,.82);
    }

    .rx-card-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
    }

    .rx-form-mark {
        width: 58px;
        height: 58px;
        border-radius: 22px;
        display: grid;
        place-items: center;
        color: #06111f;
        background: linear-gradient(135deg, var(--rx-orange), var(--rx-orange-2));
        box-shadow: 0 18px 40px rgba(245,130,32,.24);
        font-size: 1.42rem;
    }

    .rx-secure {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 11px;
        border-radius: 999px;
        color: #047857;
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        font-size: .78rem;
        font-weight: 1000;
        white-space: nowrap;
    }

    .rx-card h1 {
        margin: 22px 0 0;
        color: var(--rx-ink);
        font-size: clamp(2rem, 3vw, 2.55rem);
        line-height: 1;
        letter-spacing: -.07em;
        font-weight: 1000;
    }

    .rx-card-sub {
        margin-top: 10px;
        color: var(--rx-muted);
        font-size: .94rem;
        line-height: 1.55;
        font-weight: 720;
    }

    .rx-form {
        padding: 24px clamp(22px, 3vw, 30px) clamp(24px, 3vw, 30px);
    }

    .rx-alert {
        margin-bottom: 16px;
        border-radius: 20px;
        padding: 13px 14px;
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        font-size: .88rem;
        font-weight: 780;
        line-height: 1.45;
    }

        .rx-alert ul {
            margin: 0;
            padding-left: 18px;
        }

    .rx-field {
        margin-bottom: 14px;
    }

    .rx-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 7px;
        color: #334155;
        font-size: .83rem;
        font-weight: 1000;
    }

        .rx-label small {
            color: #94a3b8;
            font-weight: 850;
        }

    .rx-inputbox {
        position: relative;
        display: grid;
        grid-template-columns: 54px minmax(0, 1fr) 50px;
        min-height: 56px;
        overflow: hidden;
        border-radius: 20px;
        background: #f8fafc;
        border: 1px solid rgba(148,163,184,.30);
        transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
    }

        .rx-inputbox.no-eye {
            grid-template-columns: 54px minmax(0, 1fr);
        }

        .rx-inputbox:focus-within {
            background: #fff;
            border-color: rgba(10,132,255,.55);
            box-shadow: 0 0 0 4px rgba(10,132,255,.12);
        }

    .rx-input-icon {
        display: grid;
        place-items: center;
        color: #64748b;
        background: rgba(226,232,240,.58);
    }

    .rx-inputbox .form-control {
        width: 100%;
        height: 100%;
        min-height: 56px;
        border: 0 !important;
        outline: 0 !important;
        box-shadow: none !important;
        background: transparent !important;
        color: var(--rx-ink);
        padding: 0 14px;
        font-weight: 850;
        min-width: 0;
    }

        .rx-inputbox .form-control::placeholder {
            color: #94a3b8;
            font-weight: 760;
        }

    .rx-eye {
        width: 50px;
        border: 0;
        border-left: 1px solid rgba(226,232,240,.92);
        color: #64748b;
        background: rgba(255,255,255,.72);
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: background .16s ease, color .16s ease;
    }

        .rx-eye:hover {
            color: var(--rx-blue);
            background: #eff6ff;
        }

    .rx-check-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin: 16px 0 14px;
        padding: 13px;
        border-radius: 18px;
        color: #475569;
        background: #f8fafc;
        border: 1px solid rgba(226,232,240,.92);
        font-size: .82rem;
        font-weight: 760;
        line-height: 1.45;
    }

        .rx-check-row input {
            width: 18px;
            height: 18px;
            margin-top: 2px;
            accent-color: var(--rx-blue);
            flex: 0 0 auto;
        }

        .rx-check-row a {
            color: var(--rx-blue);
            text-decoration: none;
            font-weight: 1000;
        }

    .rx-submit {
        width: 100%;
        min-height: 56px;
        border: 0;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #fff;
        background: linear-gradient(135deg, var(--rx-blue), var(--rx-blue-2));
        box-shadow: 0 18px 44px rgba(10,132,255,.26);
        font-weight: 1000;
        transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
    }

        .rx-submit:hover {
            transform: translateY(-2px);
            filter: brightness(1.02);
            box-shadow: 0 24px 58px rgba(10,132,255,.32);
        }

        .rx-submit:disabled {
            opacity: .66;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .rx-divider {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        margin: 20px 0 14px;
        color: #94a3b8;
        font-size: .76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

        .rx-divider::before,
        .rx-divider::after {
            content: "";
            height: 1px;
            background: rgba(226,232,240,.95);
        }

    .rx-bottom-actions {
        display: grid;
        gap: 10px;
    }

    .rx-secondary-link {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border-radius: 18px;
        color: var(--rx-ink);
        background: #fff;
        border: 1px solid rgba(226,232,240,.95);
        text-decoration: none !important;
        font-weight: 1000;
        transition: transform .16s ease, box-shadow .16s ease;
    }

        .rx-secondary-link:hover {
            color: var(--rx-ink);
            transform: translateY(-1px);
            box-shadow: 0 14px 30px rgba(15,23,42,.09);
        }

    .rx-login-note {
        margin-top: 14px;
        text-align: center;
        color: var(--rx-muted);
        font-size: .9rem;
        font-weight: 760;
    }

        .rx-login-note a {
            color: var(--rx-blue);
            font-weight: 1000;
            text-decoration: none;
        }

            .rx-login-note a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 1120px) {
        .rx-shell {
            grid-template-columns: 1fr;
            width: min(820px, calc(100% - 28px));
        }

        .rx-card-wrap {
            width: 100%;
        }
    }

    @@media (max-width: 760px) {
        .register-apple {
            min-height: calc(100vh - 90px);
        }

        .rx-shell {
            width: min(100% - 22px, 820px);
            padding-top: 30px;
            padding-bottom: 44px;
        }

        .rx-title {
            font-size: 3.25rem;
        }

        .rx-actions .rx-btn {
            width: 100%;
        }

        .rx-mini-grid {
            grid-template-columns: 1fr;
        }

        .rx-deck {
            margin-top: 28px;
            border-radius: 26px;
        }

        .rx-deck-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .rx-mini-grid {
            grid-template-columns: 1fr;
        }

        .rx-card {
            border-radius: 30px;
        }

        .rx-card-row {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 480px) {
        .rx-title {
            font-size: 2.82rem;
        }

        .rx-lead {
            font-size: .96rem;
        }

        .rx-card-top,
        .rx-form {
            padding-left: 18px;
            padding-right: 18px;
        }

        .rx-inputbox {
            grid-template-columns: 48px minmax(0,1fr) 46px;
            border-radius: 18px;
        }

            .rx-inputbox.no-eye {
                grid-template-columns: 48px minmax(0,1fr);
            }

        .rx-eye {
            width: 46px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            transition: none !important;
            animation: none !important;
            scroll-behavior: auto !important;
        }

        .rx-video {
            display: none;
        }
    }
</style>

<div class="register-apple">
    <video class="rx-video" autoplay muted loop playsinline preload="metadata" poster="/videos/register-hero-poster.jpg">
        <source src="/videos/register-hero.mp4" type="video/mp4" />
    </video>

    <div class="rx-shell">
        <section class="rx-hero">
            <div class="rx-eyebrow">
                <i class="bi bi-stars"></i>
                Elitech Vietnam Secure Registration
            </div>

            <h1 class="rx-title">
                Create access<br />for <span>precision.</span>
            </h1>

            <p class="rx-lead">
                Tạo tài khoản để bước vào Elitech Command Center — nơi dữ liệu thiết bị được theo dõi realtime,
                cảnh báo chủ động, phân quyền rõ ràng và vận hành chuỗi lạnh an toàn hơn mỗi ngày.
            </p>

            <div class="rx-actions">
                <a class="rx-btn primary" asp-controller="Login" asp-action="Index">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Đã có tài khoản
                </a>

                <a class="rx-btn glass" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill"></i>
                    Về trang chủ
                </a>
            </div>

            <div class="rx-trust-row">
                <span class="rx-trust"><i class="bi bi-shield-lock-fill"></i> Secure access</span>
                <span class="rx-trust"><i class="bi bi-broadcast-pin"></i> Realtime monitoring</span>
                <span class="rx-trust"><i class="bi bi-bell-fill"></i> Alert & SMS</span>
                <span class="rx-trust"><i class="bi bi-filetype-pdf"></i> Reports</span>
            </div>

            <div class="rx-deck" aria-hidden="true">
                <div class="rx-deck-head">
                    <div class="rx-deck-brand">
                        <div class="rx-deck-mark"><i class="bi bi-command"></i></div>
                        <div>
                            <div class="rx-deck-title">Elitech Operation Deck</div>
                            <div class="rx-deck-sub">Create account • Assign role • Monitor devices</div>
                        </div>
                    </div>
                    <div class="rx-live">Ready</div>
                </div>

                <div class="rx-mini-grid">
                    <div class="rx-mini">
                        <div class="rx-mini-k">Monitoring</div>
                        <div class="rx-mini-v">24/7</div>
                        <div class="rx-mini-s">Theo dõi liên tục dữ liệu thiết bị được gán.</div>
                    </div>
                    <div class="rx-mini orange">
                        <div class="rx-mini-k">Access</div>
                        <div class="rx-mini-v">Role</div>
                        <div class="rx-mini-s">Admin / Staff / User tách quyền rõ ràng.</div>
                    </div>
                    <div class="rx-mini">
                        <div class="rx-mini-k">Alerts</div>
                        <div class="rx-mini-v">SMS</div>
                        <div class="rx-mini-s">Cảnh báo nhanh khi vượt ngưỡng vận hành.</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="rx-card-wrap">
            <div class="rx-card">
                <div class="rx-card-inner">
                    <div class="rx-card-top">
                        <div class="rx-card-row">
                            <div class="rx-form-mark">
                                <i class="bi bi-person-plus-fill"></i>
                            </div>

                            <div class="rx-secure">
                                <i class="bi bi-check-circle-fill"></i>
                                Secure Access
                            </div>
                        </div>

                        <h1>Create your account.</h1>
                        <div class="rx-card-sub">
                            Đăng ký tài khoản Elitech Monitoring Suite để bắt đầu theo dõi thiết bị, nhận cảnh báo và xem báo cáo vận hành.
                        </div>
                    </div>

                    <div class="rx-form">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="rx-alert">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <form asp-controller="Login" asp-action="Register" method="post" novalidate id="rxRegisterForm">
                            @Html.AntiForgeryToken()

                            <div class="rx-field">
                                <label class="rx-label" for="username">
                                    <span>Tên đăng nhập</span>
                                    <small>Username</small>
                                </label>
                                <div class="rx-inputbox no-eye">
                                    <span class="rx-input-icon"><i class="bi bi-person-fill"></i></span>
                                    <input id="username" name="username" class="form-control" placeholder="VD: nguyenvana" autocomplete="username" required />
                                </div>
                            </div>

                            <div class="rx-field">
                                <label class="rx-label" for="email">
                                    <span>Email</span>
                                    <small>Work email</small>
                                </label>
                                <div class="rx-inputbox no-eye">
                                    <span class="rx-input-icon"><i class="bi bi-envelope-fill"></i></span>
                                    <input id="email" name="email" type="email" class="form-control" placeholder="VD: user@email.com" autocomplete="email" required />
                                </div>
                            </div>

                            <div class="rx-field">
                                <label class="rx-label" for="password">
                                    <span>Mật khẩu</span>
                                    <small>New password</small>
                                </label>
                                <div class="rx-inputbox">
                                    <span class="rx-input-icon"><i class="bi bi-key-fill"></i></span>
                                    <input id="password" name="password" type="password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="new-password" required />
                                    <button type="button" class="rx-eye" data-toggle-password="#password" aria-label="Hiện mật khẩu">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="rx-field">
                                <label class="rx-label" for="confirmPassword">
                                    <span>Nhập lại mật khẩu</span>
                                    <small>Confirm</small>
                                </label>
                                <div class="rx-inputbox">
                                    <span class="rx-input-icon"><i class="bi bi-shield-lock-fill"></i></span>
                                    <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" required />
                                    <button type="button" class="rx-eye" data-toggle-password="#confirmPassword" aria-label="Hiện mật khẩu">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <label class="rx-check-row" for="rxAgree">
                                <input id="rxAgree" type="checkbox" required />
                                <span>
                                    Tôi đồng ý với
                                    <a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a>
                                    và điều khoản sử dụng hệ thống Elitech.
                                </span>
                            </label>

                            <button class="rx-submit" type="submit" id="rxSubmitBtn">
                                <i class="bi bi-person-check-fill"></i>
                                Đăng ký tài khoản
                            </button>
                        </form>

                        <div class="rx-divider"><span>or</span></div>

                        <div class="rx-bottom-actions">
                            <a class="rx-secondary-link" asp-controller="Login" asp-action="Index">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Đăng nhập tài khoản có sẵn
                            </a>
                            <a class="rx-secondary-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill"></i>
                                Về trang chủ
                            </a>
                        </div>

                        <div class="rx-login-note">
                            Elitech Vietnam — Creating Confidence in Every Degree.
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('[data-toggle-password]');
            if (!btn) return;

            const input = document.querySelector(btn.getAttribute('data-toggle-password'));
            const icon = btn.querySelector('i');
            if (!input || !icon) return;

            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.classList.toggle('bi-eye', !show);
            icon.classList.toggle('bi-eye-slash', show);
        });

        (function() {
            const form = document.getElementById('rxRegisterForm');
            const agree = document.getElementById('rxAgree');
            const submit = document.getElementById('rxSubmitBtn');
            if (!form || !agree || !submit) return;

            function syncSubmit() {
                submit.disabled = !agree.checked;
            }

            agree.addEventListener('change', syncSubmit);
            syncSubmit();
        })();
    </script>
}
