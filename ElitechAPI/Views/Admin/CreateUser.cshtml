@model Elitech.Controllers.AdminController.CreateUserViewModel
@{
    ViewData["Title"] = "Tạo tài khoản người dùng";
}

<style>
    :root {
        --brand: #F58220;
        --brand-600: #e36f15;
        --brand-blue: #1e88e5;
        --ink: #0f172a;
        --mut: #64748b;
        --bg: #f8fafc;
        --card: #ffffff;
        --stroke: #e5e7eb;
        --ok: #10b981;
        --warn: #f59e0b;
        --bad: #ef4444;
        --radius: 18px;
    }

    /* ===== Page ===== */
    .cu-page {
        min-height: 100vh;
        background: radial-gradient(800px 400px at -10% -10%, #fff6ec 0%, transparent 60%), radial-gradient(700px 420px at 110% 0%, #eef6ff 0%, transparent 60%), linear-gradient(180deg,#fff,var(--bg));
        padding: 20px;
    }

    /* ===== Hero ===== */
    .cu-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .cu-hero-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .cu-hero-icon {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        font-size: 26px;
        color: #111;
        background: linear-gradient(135deg,#F58220,#E36F15,#1e88e5);
        background-size: 200% 200%;
        animation: grad 6s ease infinite;
        box-shadow: 0 16px 36px rgba(245,130,32,.35);
    }

    @@keyframes grad {
        0%

    {
        background-position: 0% 50%
    }

    50% {
        background-position: 100% 50%
    }

    100% {
        background-position: 0% 50%
    }

    }

    .cu-hero h1 {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 1000;
    }

    .cu-hero p {
        margin: 4px 0 0;
        color: var(--mut);
        font-weight: 700;
    }

    .cu-hero-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .cu-pill {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 900;
        background: #fff;
        border: 1px solid var(--stroke);
        box-shadow: 0 8px 22px rgba(0,0,0,.06);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-back {
        border: 1px solid rgba(30,136,229,.35);
        background: linear-gradient(180deg,#eef6ff,#fff);
        color: #1e40af;
        font-weight: 900;
        padding: 8px 14px;
        border-radius: 12px;
        box-shadow: 0 10px 26px rgba(30,136,229,.18);
        transition: .15s;
    }

        .btn-back:hover {
            transform: translateY(-1px)
        }

    /* ===== Card ===== */
    .cu-card {
        max-width: 980px;
        margin: 0 auto;
        background: var(--card);
        border-radius: var(--radius);
        border: 1px solid var(--stroke);
        box-shadow: 0 20px 60px rgba(15,23,42,.12);
        overflow: hidden;
    }

    .cu-card-head {
        padding: 16px;
        border-bottom: 1px dashed var(--stroke);
    }

        .cu-card-head h5 {
            margin: 0;
            font-weight: 900;
            display: flex;
            gap: 8px;
            align-items: center;
        }

    .cu-card-body {
        padding: 16px
    }

    /* ===== Alerts ===== */
    .cu-alert {
        display: flex;
        gap: 10px;
        padding: 12px;
        border-radius: 14px;
        margin-bottom: 14px;
        font-weight: 800;
    }

        .cu-alert.ok {
            background: #ecfdf5;
            border: 1px solid #bbf7d0;
            color: #065f46
        }

        .cu-alert.err {
            background: #fff1f2;
            border: 1px solid #fecaca;
            color: #991b1b
        }

    /* ===== Form ===== */
    .cu-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }
    @@media(max - width:768px) {
        .cu-grid

    {
        grid-template-columns: 1fr
    }

    }

    .cu-field label {
        font-size: .8rem;
        font-weight: 900;
        display: flex;
        gap: 6px;
        align-items: center;
        margin-bottom: 6px;
    }

    .elx-input, select {
        width: 100%;
        height: 44px;
        border-radius: 14px;
        border: 1px solid var(--stroke);
        padding: 0 14px;
        font-weight: 800;
        background: #fff;
    }

        .elx-input:focus, select:focus {
            outline: none;
            border-color: var(--brand);
            box-shadow: 0 0 0 4px rgba(245,130,32,.18);
        }

    .cu-help {
        margin-top: 6px;
        font-size: .78rem;
        color: var(--mut);
    }

    /* Strength */
    .cu-strength {
        margin-top: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 900;
        border: 1px solid var(--stroke);
    }

        .cu-strength.ok {
            color: #065f46
        }

        .cu-strength.warn {
            color: #92400e
        }

        .cu-strength.bad {
            color: #991b1b
        }

    /* Actions */
    .cu-actions {
        display: flex;
        gap: 12px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: linear-gradient(180deg,var(--brand),var(--brand-600));
        border: none;
        border-radius: 14px;
        font-weight: 900;
        padding: 12px 18px;
        box-shadow: 0 14px 34px rgba(245,130,32,.28);
    }

        .btn-primary:active {
            transform: scale(.97)
        }
</style>

<div class="cu-page">

    <div class="cu-hero">
        <div class="cu-hero-left">
            <div class="cu-hero-icon"><i class="bi bi-person-plus"></i></div>
            <div>
                <h1>Tạo tài khoản người dùng</h1>
                <p>Admin tạo user mới • phân quyền rõ ràng • bảo mật cao</p>
            </div>
        </div>

        <div class="cu-hero-right">
            <span class="cu-pill"><i class="bi bi-shield-lock"></i> Admin only</span>
            <span class="cu-pill"><i class="bi bi-database-lock"></i> BCrypt</span>
            <a asp-controller="Admin" asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> Về Admin
            </a>
        </div>
    </div>

    <div class="cu-card">
        <div class="cu-card-head">
            <h5><i class="bi bi-person-badge"></i> Thông tin tài khoản</h5>
        </div>

        <div class="cu-card-body">

            @if (TempData["Success"] != null)
            {
                <div class="cu-alert ok">@TempData["Success"]</div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="cu-alert err">
                    <ul style="margin:0;padding-left:16px">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="CreateUser" method="post" id="createUserForm">
                @Html.AntiForgeryToken()

                <div class="cu-grid">

                    <div class="cu-field">
                        <label><i class="bi bi-person"></i> Username</label>
                        <input asp-for="Username" class="elx-input" placeholder="user_kho_a" />
                        <div class="cu-help">Không dấu • không khoảng trắng • duy nhất</div>
                    </div>

                    <div class="cu-field">
                        <label><i class="bi bi-key"></i> Password</label>
                        <input asp-for="Password" type="password" class="elx-input" id="pwd" />
                        <div class="cu-strength bad" id="pwdStrength">Độ mạnh: yếu</div>
                    </div>

                    <div class="cu-field">
                        <label><i class="bi bi-shield-check"></i> Role</label>
                        <select asp-for="Role" id="roleSel">
                            <option value="User">User</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <div class="cu-strength warn" id="rolePreview">Role: User</div>
                    </div>

                </div>

                <div class="cu-actions">
                    <button class="btn-primary" id="btnSubmit">
                        <i class="bi bi-person-check"></i> Tạo tài khoản
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            const pwd=document.getElementById('pwd');
            const box=document.getElementById('pwdStrength');
            if(!pwd||!box)return;
            pwd.addEventListener('input',()=>{
                const v=pwd.value;
                let s=0;
                if(v.length>=8)s++;
                if(/[A-Z]/.test(v))s++;
                if(/[0-9]/.test(v))s++;
                if(/[^A-Za-z0-9]/.test(v))s++;
                box.className='cu-strength '+(s>=3?'ok':s>=2?'warn':'bad');
                box.textContent='Độ mạnh: '+(s>=3?'mạnh':s>=2?'trung bình':'yếu');
            });
        })();
    </script>
}
