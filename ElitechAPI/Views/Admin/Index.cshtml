@{
    ViewData["Title"] = "Admin Dashboard";
    var adminName = User.Identity?.Name ?? "Admin";
}

<style>
    :root {
        --aa-black: #000000;
        --aa-ink: #1d1d1f;
        --aa-ink-2: #2b2b2f;
        --aa-muted: #6e6e73;
        --aa-soft: #f5f5f7;
        --aa-card: #ffffff;
        --aa-line: rgba(0,0,0,.10);
        --aa-line-dark: rgba(255,255,255,.16);
        --aa-blue: #0071e3;
        --aa-blue-2: #2997ff;
        --aa-orange: #f58220;
        --aa-orange-2: #ffb25b;
        --aa-green: #34c759;
        --aa-red: #ff3b30;
        --aa-yellow: #ffcc00;
        --aa-radius-xl: 34px;
        --aa-radius-lg: 26px;
        --aa-radius-md: 18px;
        --aa-shadow: 0 30px 80px rgba(0,0,0,.14);
        --aa-shadow-soft: 0 16px 44px rgba(0,0,0,.08);
        --aa-max: 1200px;
    }

    html, body {
        max-width: 100%;
        overflow-x: hidden;
    }

    body {
        background: var(--aa-soft) !important;
        color: var(--aa-ink);
    }

    .aa-admin {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        min-height: 100vh;
        background: var(--aa-soft);
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, Arial, sans-serif;
        color: var(--aa-ink);
    }

    .aa-wrap {
        max-width: var(--aa-max);
        margin: 0 auto;
        padding-left: 22px;
        padding-right: 22px;
    }

    .aa-topbar {
        position: sticky;
        top: 0;
        z-index: 80;
        min-height: 52px;
        background: rgba(22,22,23,.86);
        color: rgba(245,245,247,.92);
        border-bottom: 1px solid rgba(255,255,255,.08);
        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
    }

    .aa-topbar-inner {
        max-width: var(--aa-max);
        min-height: 52px;
        margin: 0 auto;
        padding: 0 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }

    .aa-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #f5f5f7;
        text-decoration: none;
        font-weight: 800;
        letter-spacing: -.02em;
        white-space: nowrap;
    }

    .aa-brand-mark {
        width: 30px;
        height: 30px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        color: #111;
        background: linear-gradient(135deg, #fff, var(--aa-orange-2));
        box-shadow: 0 8px 22px rgba(245,130,32,.22);
    }

    .aa-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2px;
        flex: 1;
    }

    .aa-nav a {
        color: rgba(245,245,247,.75);
        text-decoration: none;
        font-size: .82rem;
        font-weight: 650;
        padding: 10px 12px;
        border-radius: 999px;
        transition: .18s ease;
    }

    .aa-nav a:hover,
    .aa-nav a.is-active {
        color: #fff;
        background: rgba(255,255,255,.10);
    }

    .aa-top-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .aa-top-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 11px;
        border-radius: 999px;
        color: rgba(245,245,247,.90);
        font-size: .78rem;
        font-weight: 750;
        text-decoration: none;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.10);
        white-space: nowrap;
    }

    .aa-dot-live {
        width: 8px;
        height: 8px;
        border-radius: 99px;
        background: var(--aa-green);
        box-shadow: 0 0 0 5px rgba(52,199,89,.18);
    }

    .aa-hero {
        position: relative;
        min-height: 680px;
        overflow: hidden;
        display: grid;
        place-items: center;
        color: #f5f5f7;
        background: #000;
        isolation: isolate;
    }

    .aa-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -3;
        background:
            radial-gradient(980px 620px at 70% 35%, rgba(0,113,227,.46), transparent 62%),
            radial-gradient(760px 520px at 30% 30%, rgba(245,130,32,.34), transparent 58%),
            radial-gradient(540px 380px at 50% 92%, rgba(255,255,255,.16), transparent 68%),
            linear-gradient(180deg, #030303 0%, #08080b 56%, #000 100%);
    }

    .aa-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -2;
        opacity: .28;
        background:
            linear-gradient(90deg, rgba(255,255,255,.10) 1px, transparent 1px),
            linear-gradient(180deg, rgba(255,255,255,.10) 1px, transparent 1px);
        background-size: 74px 74px;
        mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 70%, transparent 100%);
        -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 70%, transparent 100%);
    }

    .aa-hero-inner {
        width: 100%;
        max-width: var(--aa-max);
        margin: 0 auto;
        padding: 86px 22px 70px;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(340px, .95fr);
        gap: 34px;
        align-items: center;
    }

    .aa-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 9px 14px;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 999px;
        color: rgba(245,245,247,.88);
        background: rgba(255,255,255,.07);
        font-size: .78rem;
        font-weight: 900;
        letter-spacing: .11em;
        text-transform: uppercase;
    }

    .aa-eyebrow i {
        color: var(--aa-orange-2);
    }

    .aa-hero h1 {
        margin: 18px 0 0;
        max-width: 820px;
        font-size: clamp(3.55rem, 7vw, 6.75rem);
        line-height: .88;
        letter-spacing: -.078em;
        font-weight: 900;
    }

    .aa-hero h1 span {
        display: inline-block;
        color: transparent;
        background: linear-gradient(90deg, #fff 0%, #d8ecff 34%, #ffb25b 75%, #f58220 100%);
        -webkit-background-clip: text;
        background-clip: text;
    }

    .aa-hero-copy {
        position: relative;
        z-index: 2;
    }

    .aa-hero-copy p {
        margin: 22px 0 0;
        max-width: 720px;
        color: rgba(245,245,247,.76);
        font-size: clamp(1.02rem, 1.5vw, 1.24rem);
        line-height: 1.62;
        font-weight: 560;
        letter-spacing: -.018em;
    }

    .aa-actions {
        margin-top: 28px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .aa-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 44px;
        padding: 12px 18px;
        border-radius: 999px;
        border: 1px solid transparent;
        text-decoration: none;
        cursor: pointer;
        font-size: .95rem;
        font-weight: 780;
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
    }

    .aa-btn:hover {
        transform: translateY(-2px);
        text-decoration: none;
    }

    .aa-btn-primary {
        color: #fff;
        background: var(--aa-blue);
        box-shadow: 0 18px 42px rgba(0,113,227,.30);
    }

    .aa-btn-primary:hover {
        color: #fff;
        background: #0878eb;
    }

    .aa-btn-light {
        color: #1d1d1f;
        background: rgba(245,245,247,.96);
        box-shadow: 0 18px 42px rgba(255,255,255,.10);
    }

    .aa-btn-light:hover {
        color: #1d1d1f;
        background: #fff;
    }

    .aa-btn-ghost {
        color: #f5f5f7;
        background: rgba(255,255,255,.09);
        border-color: rgba(255,255,255,.16);
    }

    .aa-btn-ghost:hover {
        color: #fff;
        background: rgba(255,255,255,.13);
    }

    .aa-device-stage {
        position: relative;
        min-height: 520px;
        display: grid;
        place-items: center;
    }

    .aa-device-stage::before {
        content: "";
        position: absolute;
        width: 560px;
        height: 560px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(41,151,255,.30), transparent 62%);
        filter: blur(10px);
    }

    .aa-phone {
        position: relative;
        width: min(380px, 90vw);
        min-height: 530px;
        border-radius: 56px;
        padding: 13px;
        background: linear-gradient(135deg, rgba(255,255,255,.55), rgba(255,255,255,.08));
        box-shadow:
            inset 0 0 0 1px rgba(255,255,255,.20),
            0 40px 110px rgba(0,0,0,.45);
        transform: rotate(-4deg);
    }

    .aa-phone-screen {
        position: relative;
        min-height: 504px;
        overflow: hidden;
        border-radius: 45px;
        background:
            radial-gradient(360px 220px at 70% 16%, rgba(245,130,32,.30), transparent 58%),
            radial-gradient(300px 240px at 20% 28%, rgba(41,151,255,.34), transparent 58%),
            linear-gradient(180deg, #111318, #050506);
        border: 1px solid rgba(255,255,255,.12);
    }

    .aa-phone-notch {
        position: absolute;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        width: 118px;
        height: 34px;
        border-radius: 999px;
        background: #000;
        z-index: 4;
    }

    .aa-screen-content {
        position: relative;
        z-index: 2;
        padding: 70px 22px 22px;
    }

    .aa-screen-title {
        color: #fff;
        font-size: 1.8rem;
        line-height: 1.02;
        letter-spacing: -.055em;
        font-weight: 900;
    }

    .aa-screen-sub {
        margin-top: 8px;
        color: rgba(245,245,247,.64);
        font-size: .86rem;
        line-height: 1.45;
        font-weight: 560;
    }

    .aa-signal-card {
        margin-top: 20px;
        border-radius: 28px;
        padding: 16px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.14);
    }

    .aa-signal-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #fff;
        font-weight: 800;
        font-size: .9rem;
    }

    .aa-bars {
        height: 104px;
        display: flex;
        align-items: end;
        gap: 8px;
        margin-top: 18px;
    }

    .aa-bars span {
        flex: 1;
        border-radius: 999px 999px 12px 12px;
        background: linear-gradient(180deg, #fff, rgba(41,151,255,.40));
        opacity: .88;
    }

    .aa-bars span:nth-child(3),
    .aa-bars span:nth-child(6) {
        background: linear-gradient(180deg, #ffb25b, rgba(245,130,32,.48));
    }

    .aa-temp-card {
        margin-top: 12px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .aa-temp-mini {
        padding: 14px;
        border-radius: 22px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.13);
    }

    .aa-temp-mini b {
        display: block;
        color: #fff;
        font-size: 1.25rem;
        line-height: 1;
        letter-spacing: -.04em;
    }

    .aa-temp-mini span {
        display: block;
        margin-top: 7px;
        color: rgba(245,245,247,.58);
        font-size: .74rem;
        font-weight: 650;
    }



    /* ===== HERO VISUAL V2 - COMMAND CENTER (không dùng mockup iPhone) ===== */
    .aa-device-stage {
        position: relative;
        min-height: 520px;
        display: grid;
        place-items: center;
        perspective: 1200px;
    }

    .aa-device-stage::before {
        content: "";
        position: absolute;
        width: 620px;
        height: 420px;
        border-radius: 999px;
        background:
            radial-gradient(circle at 50% 50%, rgba(41,151,255,.34), transparent 62%),
            radial-gradient(circle at 76% 28%, rgba(245,130,32,.25), transparent 54%);
        filter: blur(14px);
        opacity: .9;
    }

    .aa-command-deck {
        position: relative;
        width: min(560px, 92vw);
        min-height: 420px;
        border-radius: 36px;
        padding: 18px;
        overflow: hidden;
        background:
            linear-gradient(135deg, rgba(255,255,255,.18), rgba(255,255,255,.055)),
            linear-gradient(145deg, rgba(22,22,23,.96), rgba(4,8,16,.96));
        border: 1px solid rgba(255,255,255,.18);
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,.16),
            0 38px 100px rgba(0,0,0,.42);
        transform: rotateY(-9deg) rotateX(4deg) rotateZ(1deg);
    }

    .aa-command-deck::before {
        content: "";
        position: absolute;
        inset: 0;
        opacity: .32;
        background:
            linear-gradient(90deg, rgba(255,255,255,.11) 1px, transparent 1px),
            linear-gradient(180deg, rgba(255,255,255,.10) 1px, transparent 1px);
        background-size: 34px 34px;
        mask-image: linear-gradient(135deg, #000, transparent 85%);
        pointer-events: none;
    }

    .aa-command-glow {
        position: absolute;
        right: -120px;
        top: -150px;
        width: 340px;
        height: 340px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(245,130,32,.42), transparent 66%);
        pointer-events: none;
    }

    .aa-deck-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 8px 8px 16px;
        border-bottom: 1px solid rgba(255,255,255,.10);
    }

    .aa-deck-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .aa-deck-logo {
        width: 44px;
        height: 44px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        color: #111827;
        background: linear-gradient(135deg, #f58220, #ffcb8a);
        box-shadow: 0 16px 34px rgba(245,130,32,.26);
        flex: 0 0 auto;
        font-size: 1.24rem;
    }

    .aa-deck-title {
        color: #fff;
        font-size: 1.12rem;
        line-height: 1.05;
        letter-spacing: -.035em;
        font-weight: 900;
    }

    .aa-deck-subtitle {
        margin-top: 4px;
        color: rgba(245,245,247,.56);
        font-size: .78rem;
        font-weight: 650;
    }

    .aa-deck-live {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        border-radius: 999px;
        color: rgba(245,245,247,.88);
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.13);
        font-size: .8rem;
        font-weight: 850;
        white-space: nowrap;
    }

    .aa-deck-main {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1.18fr .82fr;
        gap: 14px;
        padding-top: 16px;
    }

    .aa-deck-panel,
    .aa-deck-sidepanel,
    .aa-deck-mini {
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(255,255,255,.075);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
    }

    .aa-deck-panel {
        min-height: 258px;
        border-radius: 28px;
        padding: 17px;
        overflow: hidden;
    }

    .aa-deck-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .aa-deck-label {
        color: rgba(245,245,247,.54);
        font-size: .74rem;
        font-weight: 850;
        letter-spacing: .11em;
        text-transform: uppercase;
    }

    .aa-deck-number {
        margin-top: 7px;
        color: #fff;
        font-size: 2.6rem;
        line-height: .9;
        letter-spacing: -.07em;
        font-weight: 900;
    }

    .aa-deck-number small {
        font-size: 1.05rem;
        color: rgba(245,245,247,.58);
        letter-spacing: -.03em;
    }

    .aa-deck-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 10px;
        border-radius: 999px;
        color: #d1fae5;
        background: rgba(52,199,89,.13);
        border: 1px solid rgba(52,199,89,.20);
        font-size: .74rem;
        font-weight: 850;
        white-space: nowrap;
    }

    .aa-deck-chart {
        position: relative;
        height: 122px;
        margin-top: 20px;
        border-radius: 22px;
        overflow: hidden;
        background:
            linear-gradient(180deg, rgba(41,151,255,.10), transparent),
            linear-gradient(90deg, rgba(255,255,255,.075) 1px, transparent 1px),
            linear-gradient(180deg, rgba(255,255,255,.075) 1px, transparent 1px);
        background-size: auto, 28px 28px, 28px 28px;
    }

    .aa-deck-chart svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .aa-deck-bars {
        position: absolute;
        left: 15px;
        right: 15px;
        bottom: 12px;
        display: flex;
        align-items: end;
        gap: 8px;
        height: 70px;
        opacity: .88;
    }

    .aa-deck-bars span {
        flex: 1;
        border-radius: 999px 999px 9px 9px;
        background: linear-gradient(180deg, rgba(255,255,255,.95), rgba(41,151,255,.40));
    }

    .aa-deck-bars span:nth-child(3),
    .aa-deck-bars span:nth-child(7) {
        background: linear-gradient(180deg, #ffb25b, rgba(245,130,32,.46));
    }

    .aa-deck-sidepanel {
        border-radius: 28px;
        padding: 15px;
        display: grid;
        gap: 11px;
    }

    .aa-deck-mini {
        border-radius: 22px;
        padding: 14px;
    }

    .aa-deck-mini b {
        display: block;
        color: #fff;
        font-size: 1.35rem;
        line-height: 1;
        letter-spacing: -.05em;
    }

    .aa-deck-mini span {
        display: block;
        margin-top: 6px;
        color: rgba(245,245,247,.58);
        font-size: .75rem;
        font-weight: 700;
    }

    .aa-deck-mini.orange {
        background: linear-gradient(135deg, rgba(245,130,32,.30), rgba(255,255,255,.075));
    }

    .aa-deck-footer {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 11px;
        margin-top: 14px;
    }

    .aa-deck-footitem {
        min-height: 76px;
        border-radius: 22px;
        padding: 13px;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.11);
    }

    .aa-deck-footitem i {
        color: #ffb25b;
        font-size: 1.05rem;
    }

    .aa-deck-footitem b {
        display: block;
        margin-top: 8px;
        color: #fff;
        font-size: .86rem;
        font-weight: 850;
    }

    .aa-deck-footitem span {
        display: block;
        margin-top: 4px;
        color: rgba(245,245,247,.52);
        font-size: .7rem;
        line-height: 1.25;
        font-weight: 650;
    }

    .aa-floating-orb {
        position: absolute;
        z-index: 3;
        width: 88px;
        height: 88px;
        border-radius: 26px;
        display: grid;
        place-items: center;
        color: #fff;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.14);
        box-shadow: 0 20px 54px rgba(0,0,0,.26);
    }

    .aa-floating-orb.one {
        right: -18px;
        top: 62px;
        color: #111827;
        background: linear-gradient(135deg, #f58220, #ffcb8a);
    }

    .aa-floating-orb.two {
        left: -20px;
        bottom: 54px;
        background: linear-gradient(135deg, rgba(0,113,227,.95), rgba(41,151,255,.75));
    }

    .aa-section {
        padding: 56px 0;
    }

    .aa-section-tight {
        padding-top: 34px;
    }

    .aa-section-head {
        margin-bottom: 22px;
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 16px;
    }

    .aa-kicker-dark {
        color: #86868b;
        font-size: .78rem;
        font-weight: 850;
        letter-spacing: .11em;
        text-transform: uppercase;
    }

    .aa-section-title {
        margin: 5px 0 0;
        font-size: clamp(2rem, 4vw, 3.8rem);
        line-height: .96;
        letter-spacing: -.068em;
        font-weight: 900;
        color: var(--aa-ink);
    }

    .aa-section-note {
        max-width: 420px;
        color: var(--aa-muted);
        font-size: .95rem;
        line-height: 1.55;
        font-weight: 560;
    }

    .aa-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        border-radius: 999px;
        color: var(--aa-ink);
        background: #fff;
        border: 1px solid var(--aa-line);
        font-size: .82rem;
        font-weight: 800;
        box-shadow: 0 8px 24px rgba(0,0,0,.06);
        white-space: nowrap;
    }

    .aa-metrics {
        margin-top: -52px;
        position: relative;
        z-index: 10;
    }

    .aa-metric-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 14px;
    }

    .aa-metric {
        min-height: 176px;
        border-radius: var(--aa-radius-lg);
        padding: 22px;
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(0,0,0,.07);
        box-shadow: var(--aa-shadow-soft);
        overflow: hidden;
        position: relative;
    }

    .aa-metric::after {
        content: "";
        position: absolute;
        width: 160px;
        height: 160px;
        border-radius: 99px;
        right: -78px;
        bottom: -78px;
