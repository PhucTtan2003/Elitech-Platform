        </section>
    </main>

    <div class="aa-floating" aria-label="Floating quick actions">
        <a href="/Admin/AssignDevices" title="Assign Devices"><i class="bi bi-diagram-3-fill"></i></a>
        <a href="/ElitechRealtime" title="Realtime"><i class="bi bi-lightning-charge-fill"></i></a>
        <a href="/Admin/Accounts" title="Accounts"><i class="bi bi-person-gear"></i></a>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const toastEl = document.getElementById('aaToast');
            const toastDot = document.getElementById('aaToastDot');
            const toastTitle = document.getElementById('aaToastTitle');
            const toastMsg = document.getElementById('aaToastMsg');

            function showToast(type, title, msg) {
                if (!toastEl || !toastDot || !toastTitle || !toastMsg) return;

                toastEl.classList.add('show');
                toastDot.classList.remove('err', 'warn');

                if (type === 'err') toastDot.classList.add('err');
                if (type === 'warn') toastDot.classList.add('warn');

                toastTitle.textContent = title || 'Thông báo';
                toastMsg.textContent = msg || '';

                clearTimeout(window.__aaToastTimer);
                window.__aaToastTimer = setTimeout(() => toastEl.classList.remove('show'), 3200);
            }

            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, ch => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                }[ch]));
            }

            function fmtDate(value) {
                if (!value) return '-';
                try {
                    return new Date(value).toLocaleString();
                } catch {
                    return String(value);
                }
            }

            function roleLabel(role) {
                const raw = String(role ?? '').trim();
                const lower = raw.toLowerCase();

                if (role === 1 || raw === '1' || lower === 'admin') return 'Admin';
                if (role === 2 || raw === '2' || lower === 'user') return 'User';
                if (role === 3 || raw === '3' || lower === 'staff') return 'Staff';

                return raw || '-';
            }

            function roleClass(role) {
                const label = roleLabel(role).toLowerCase();
                if (label === 'admin') return 'info';
                if (label === 'staff') return 'ok';
                if (label === 'user') return 'warn';
                return 'warn';
            }

            // Smooth anchor scroll
            document.querySelectorAll('.aa-nav a[href^="#"], .aa-btn[href^="#"]').forEach(a => {
                a.addEventListener('click', e => {
                    const id = a.getAttribute('href');
                    const target = id ? document.querySelector(id) : null;
                    if (!target) return;
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });

            // Accordion
            document.addEventListener('click', e => {
                const target = e.target instanceof Element ? e.target : null;
                const btn = target?.closest('[data-aa-toggle]');
                if (!btn) return;

                const card = btn.closest('.aa-module');
                if (!card) return;

                const willOpen = !card.classList.contains('is-open');
                document.querySelectorAll('.aa-module.is-open').forEach(item => {
                    if (item !== card) item.classList.remove('is-open');
                });

                card.classList.toggle('is-open', willOpen);
            });

            // Add Device
            const guidInput = document.getElementById('devGuid');
            const nameInput = document.getElementById('devName');
            const btnAdd = document.getElementById('btnAddDevice');
            const btnDemo = document.getElementById('btnFillDemo');
            const resultBox = document.getElementById('addDeviceResult');
            const rHttp = document.getElementById('rHttp');
            const rCode = document.getElementById('rCode');
            const rMsg = document.getElementById('rMsg');
            const rAdded = document.getElementById('rAdded');
            const rGuid = document.getElementById('rGuid');
            const rName = document.getElementById('rName');

            btnDemo?.addEventListener('click', () => {
                if (guidInput) guidInput.value = '90319774496194524687';
                if (nameInput) nameInput.value = 'Kho A - RCW-360P';
                showToast('warn', 'Đã điền mẫu', 'Nhớ thay GUID thật trước khi Add Device.');
            });

            btnAdd?.addEventListener('click', async () => {
                const deviceGuid = (guidInput?.value || '').trim();
                const deviceName = (nameInput?.value || '').trim();

                if (!deviceGuid) {
                    showToast('err', 'Thiếu Device GUID', 'Vui lòng nhập deviceGuid.');
                    guidInput?.focus();
                    return;
                }

                btnAdd.disabled = true;
                btnAdd.innerHTML = '<i class="bi bi-arrow-repeat"></i> Đang gửi...';
                if (resultBox) resultBox.style.display = 'none';

                try {
                    const res = await fetch('/api/admin/elitech/add-device', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ deviceGuid, deviceName })
                    });

                    const json = await res.json().catch(() => null);
                    const isOk = res.ok && (json?.code === 0 || json?.code === '0');
                    const message = json?.message ?? json?.msg ?? (isOk ? 'OK' : 'Vui lòng thử lại');

                    if (resultBox) resultBox.style.display = 'grid';
                    if (rHttp) rHttp.textContent = String(res.status);
                    if (rCode) rCode.textContent = String(json?.code ?? '-');
                    if (rMsg) rMsg.textContent = String(message);
                    if (rAdded) rAdded.textContent = String(json?.added ?? json?.data ?? '-');
                    if (rGuid) rGuid.textContent = String(json?.deviceGuid ?? deviceGuid);
                    if (rName) rName.textContent = String(json?.deviceName ?? deviceName);

                    if (isOk) showToast('ok', 'Add Device thành công', `GUID: ${deviceGuid}`);
                    else showToast('err', 'Add Device thất bại', String(message));
                } catch {
                    if (resultBox) resultBox.style.display = 'grid';
                    if (rHttp) rHttp.textContent = '-';
                    if (rCode) rCode.textContent = '-';
                    if (rMsg) rMsg.textContent = 'Không gọi được server';
                    if (rAdded) rAdded.textContent = '-';
                    if (rGuid) rGuid.textContent = deviceGuid;
                    if (rName) rName.textContent = deviceName;

                    showToast('err', 'Lỗi mạng / server', 'Không gọi được /api/admin/elitech/add-device');
                } finally {
                    btnAdd.disabled = false;
                    btnAdd.innerHTML = '<i class="bi bi-plus-circle"></i> Add Device';
                }
            });

            // Device GUIDs
            const btnLoadGuids = document.getElementById('btnLoadGuids');
            const guidsHint = document.getElementById('guidsHint');
            const guidsTableWrap = document.getElementById('guidsTableWrap');
            const guidsTbody = document.getElementById('guidsTbody');

            btnLoadGuids?.addEventListener('click', async () => {
                btnLoadGuids.disabled = true;
                btnLoadGuids.innerHTML = '<i class="bi bi-arrow-repeat"></i> Đang tải...';
                if (guidsTableWrap) guidsTableWrap.style.display = 'none';
                if (guidsTbody) guidsTbody.innerHTML = '';

                try {
                    const res = await fetch('/api/elitech/device-guids', { method: 'GET' });
                    const json = await res.json().catch(() => null);

                    if (!res.ok || !json || json.code !== 0) {
                        const msg = json?.message ?? 'Không tải được danh sách GUID.';
                        if (guidsHint) guidsHint.textContent = msg;
                        showToast('err', 'Load GUIDs thất bại', msg);
                        return;
                    }

                    const arr = Array.isArray(json.data) ? json.data : [];

                    if (!arr.length) {
                        if (guidsHint) guidsHint.textContent = 'Danh sách GUID rỗng.';
                        showToast('warn', 'Không có thiết bị', 'API trả về danh sách rỗng.');
                        return;
                    }

                    if (guidsTableWrap) guidsTableWrap.style.display = 'block';
                    if (guidsTbody) {
                        guidsTbody.innerHTML = arr.map((g, i) => `
                            <tr>
                                <td>${i + 1}</td>
                                <td style="font-weight:850;">${escapeHtml(g)}</td>
                                <td>
                                    <button type="button" class="aa-mini-btn" data-copy-guid="${escapeHtml(g)}">
                                        <i class="bi bi-clipboard"></i> Copy
                                    </button>
                                </td>
                            </tr>
                        `).join('');
                    }

                    if (guidsHint) guidsHint.textContent = `Đã tải ${arr.length} GUID.`;
                    showToast('ok', 'Load GUIDs thành công', `Tổng: ${arr.length}`);
                } catch {
                    showToast('err', 'Lỗi mạng / server', 'Không gọi được /api/elitech/device-guids');
                } finally {
                    btnLoadGuids.disabled = false;
                    btnLoadGuids.innerHTML = '<i class="bi bi-arrow-repeat"></i> Load GUIDs';
                }
            });

            document.addEventListener('click', async e => {
                const target = e.target instanceof Element ? e.target : null;
                const btn = target?.closest('[data-copy-guid]');
                if (!btn) return;

                const guid = btn.getAttribute('data-copy-guid') || '';
                try {
                    await navigator.clipboard.writeText(guid);
                    showToast('ok', 'Đã copy GUID', guid);
                } catch {
                    showToast('warn', 'Copy không được', 'Trình duyệt đang chặn clipboard.');
                }
            });

            // Accounts
            const btnLoadAccounts = document.getElementById('btnLoadAccounts');
            const accountsHint = document.getElementById('accountsHint');
            const accountsTableWrap = document.getElementById('accountsTableWrap');
            const accountsTbody = document.getElementById('accountsTbody');

            btnLoadAccounts?.addEventListener('click', async () => {
                btnLoadAccounts.disabled = true;
                btnLoadAccounts.innerHTML = '<i class="bi bi-arrow-repeat"></i> Đang tải...';
                if (accountsTableWrap) accountsTableWrap.style.display = 'none';
                if (accountsTbody) accountsTbody.innerHTML = '';

                try {
                    const res = await fetch('/api/admin/accounts', { method: 'GET' });
                    const json = await res.json().catch(() => null);

                    if (!res.ok || !json || json.code !== 0) {
                        const msg = json?.message ?? 'Không tải được danh sách accounts.';
                        if (accountsHint) accountsHint.textContent = msg;
                        showToast('err', 'Load Accounts thất bại', msg);
                        return;
                    }

                    const arr = Array.isArray(json.data) ? json.data : [];

                    if (!arr.length) {
                        if (accountsHint) accountsHint.textContent = 'Danh sách account rỗng.';
                        showToast('warn', 'Không có account', 'Collection Accounts đang rỗng.');
                        return;
                    }

                    if (accountsTableWrap) accountsTableWrap.style.display = 'block';
                    if (accountsTbody) {
                        accountsTbody.innerHTML = arr.map((a, i) => {
                            const active = a.isActive === true;
                            const statusChip = active
                                ? '<span class="aa-status ok">Active</span>'
                                : '<span class="aa-status crit">Disabled</span>';

                            const roleName = roleLabel(a.role);
                            const roleChip = `<span class="aa-status ${roleClass(a.role)}">${escapeHtml(roleName)}</span>`;

                            const avatar = a.avatarUrl
                                ? `<img src="${escapeHtml(a.avatarUrl)}" alt="avatar" onerror="this.outerHTML='<i class=\'bi bi-person-fill\'></i>'" />`
                                : '<i class="bi bi-person-fill"></i>';

                            return `
                                <tr>
                                    <td>${i + 1}</td>
                                    <td><span class="aa-avatar">${avatar}</span></td>
                                    <td style="font-weight:850;">${escapeHtml(a.username)}</td>
                                    <td>${roleChip}</td>
                                    <td>${statusChip}</td>
                                    <td>${escapeHtml(fmtDate(a.createdAtUtc))}</td>
                                </tr>
                            `;
                        }).join('');
                    }

                    if (accountsHint) accountsHint.textContent = `Đã tải ${arr.length} accounts.`;
                    showToast('ok', 'Load Accounts thành công', `Tổng: ${arr.length}`);
                } catch {
                    showToast('err', 'Lỗi mạng / server', 'Không gọi được /api/admin/accounts');
                } finally {
                    btnLoadAccounts.disabled = false;
                    btnLoadAccounts.innerHTML = '<i class="bi bi-arrow-repeat"></i> Load Accounts';
                }
            });
        })();
    </script>

    <script type="module" src="/app/entry-admin.js"></script>
}
