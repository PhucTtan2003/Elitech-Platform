                            <!-- Direct link -->
                            <div class="aa-module">
                                <a asp-controller="Admin" asp-action="Accounts" class="aa-module-toggle">
                                    <div class="aa-module-icon"><i class="bi bi-person-gear"></i></div>
                                    <div class="aa-module-txt">
                                        <div class="aa-module-title">Mở trang Accounts đầy đủ</div>
                                        <div class="aa-module-sub">CRUD accounts • reset password • toggle active</div>
                                    </div>
                                    <i class="bi bi-arrow-right aa-module-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <aside class="aa-side">
                        <div class="aa-side-card">
                            <div class="aa-side-inner">
                                <div class="aa-side-badge"><i class="bi bi-stars"></i> Elitech Flow</div>
                                <div class="aa-side-title">Vận hành rõ ràng hơn.</div>
                                <div class="aa-side-desc">
                                    Flow gợi ý để Admin xử lý từ thiết bị mới đến giám sát realtime và báo cáo.
                                </div>

                                <div class="aa-flow">
                                    <div class="aa-flow-item">
                                        <div class="aa-flow-num">1</div>
                                        <div>
