                                <div class="aa-module-body">
                                    <div class="aa-help">Click để mở nhanh các trang quản trị / theo dõi.</div>

                                    <div class="aa-link-grid">
                                        <a class="aa-linkpill" href="/Admin/SmsSubscriptions">
                                            <i class="bi bi-chat-dots"></i>
                                            <div>
                                                <div class="aa-link-t">SMS Subscriptions</div>
                                                <div class="aa-link-s">Quản lý SMS cảnh báo</div>
                                            </div>
                                            <span class="aa-link-go">↗</span>
                                        </a>

                                        <a class="aa-linkpill" href="/ElitechAlarmPage">
                                            <i class="bi bi-exclamation-triangle"></i>
                                            <div>
                                                <div class="aa-link-t">Elitech Alarm</div>
                                                <div class="aa-link-s">Theo dõi cảnh báo</div>
                                            </div>
                                            <span class="aa-link-go">↗</span>
                                        </a>

                                        <a class="aa-linkpill" href="/ElitechAlertRulesPage">
                                            <i class="bi bi-sliders"></i>
                                            <div>
                                                <div class="aa-link-t">Alert Rules</div>
                                                <div class="aa-link-s">Cấu hình ngưỡng</div>
                                            </div>
                                            <span class="aa-link-go">↗</span>
                                        </a>

                                        <a class="aa-linkpill" href="/ElitechDevicePage">
                                            <i class="bi bi-cpu"></i>
                                            <div>
                                                <div class="aa-link-t">Device Page</div>
                                                <div class="aa-link-s">Danh sách logger</div>
                                            </div>
                                            <span class="aa-link-go">↗</span>
                                        </a>

                                        <a class="aa-linkpill" href="/ElitechRealtime">
                                            <i class="bi bi-broadcast-pin"></i>
                                            <div>
                                                <div class="aa-link-t">Realtime</div>
                                                <div class="aa-link-s">Theo dõi realtime</div>
                                            </div>
                                            <span class="aa-link-go">↗</span>
                                        </a>

                                        <a class="aa-linkpill" href="/ElitechHistoryPage">
                                            <i class="bi bi-graph-up-arrow"></i>
                                            <div>
                                                <div class="aa-link-t">History Chart</div>
                                                <div class="aa-link-s">Biểu đồ lịch sử</div>
                                            </div>
                                            <span class="aa-link-go">↗</span>
                                        </a>
