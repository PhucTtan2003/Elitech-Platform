                                    <div class="aa-flow-item">
                                        <div class="aa-flow-num">3</div>
                                        <div>
                                            <div class="aa-flow-t">Set ngưỡng</div>
                                            <div class="aa-flow-s">Cấu hình cảnh báo nhiệt độ / độ ẩm.</div>
                                        </div>
