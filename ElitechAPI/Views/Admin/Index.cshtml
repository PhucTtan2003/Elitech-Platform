                                            <div class="aa-flow-s">Add Device bằng GUID và tên thiết bị.</div>
                                        </div>
                                    </div>

                                    <div class="aa-flow-item">
                                        <div class="aa-flow-num">2</div>
                                        <div>
                                            <div class="aa-flow-t">Gán người dùng</div>
                                            <div class="aa-flow-s">Assign thiết bị cho account cần theo dõi.</div>
                                        </div>
