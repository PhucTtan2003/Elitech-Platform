                                                <tr>
                                                    <th style="width:60px;">#</th>
                                                    <th style="width:70px;">Avatar</th>
                                                    <th>Username</th>
                                                    <th style="width:120px;">Role</th>
                                                    <th style="width:130px;">Status</th>
                                                    <th style="min-width:200px;">Created</th>
                                                </tr>
                                            </thead>
                                            <tbody id="accountsTbody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Quick Links -->
                            <div class="aa-module">
                                <button type="button" class="aa-module-toggle" data-aa-toggle>
                                    <div class="aa-module-icon"><i class="bi bi-link-45deg"></i></div>
                                    <div class="aa-module-txt">
                                        <div class="aa-module-title">Quick Links / Admin Pages</div>
                                        <div class="aa-module-sub">Đi nhanh tới các trang quản trị và monitoring</div>
