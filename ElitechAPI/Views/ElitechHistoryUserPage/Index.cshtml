<script>
    document.addEventListener("DOMContentLoaded", () => {
    document.documentElement.setAttribute("data-elitech-theme", "@theme");
    document.body.setAttribute("data-elitech-theme", "@theme");

    const fallbackScope = "user";
    const cfg = window.__ELITECH_HISTORY__ || {
    scope: fallbackScope,
    isAdmin: false,
    baseUrl: '@Url.Content("~/")',
    historyApiUrl: '@Url.Content("~/api/user/elitech/history")',
    devicesApiUrl: '@Url.Content("~/api/elitech/my-devices")',
    exportPdfUrl: '@Url.Content("~/export/pdf")'
    };

    cfg.scope = cfg.scope || fallbackScope;
    cfg.isAdmin = Boolean(cfg.isAdmin);
    cfg.baseUrl = cfg.baseUrl || '@Url.Content("~/")';
    cfg.historyApiUrl = cfg.historyApiUrl || '@Url.Content("~/api/user/elitech/history")';
    cfg.devicesApiUrl = cfg.devicesApiUrl || '@Url.Content("~/api/elitech/my-devices")';
    cfg.exportPdfUrl = cfg.exportPdfUrl || '@Url.Content("~/export/pdf")';
    window.__ELITECH_HISTORY__ = cfg;

    const $ = (id) => document.getElementById(id);

    const refs = {
    form: $("qForm"),
    deviceGuid: $("deviceGuid"),
    devicePick: $("devicePick"),
    from: $("from"),
    to: $("to"),
    quick: $("quick"),
    tempChan: $("tempChan"),
    humChan: $("humChan"),
    btnFetch: $("btnFetch"),
    btnClear: $("btnClear"),
    btnExport: $("btnExport"),
    btnExportPdf: $("btnExportPdf"),
    autoToggle: $("autoToggle"),
    autoInterval: $("autoInterval"),
    autoCountdown: $("autoCountdown"),
    loading: $("loading"),
    status: $("status"),
    apiMsg: $("apiMsg"),
    toasty: $("toasty"),
    nowText: $("nowText"),
    pointCount: $("pointCount"),
    rangeText: $("rangeText"),
    deviceText: $("deviceText"),
    avgTemp: $("avgTemp"),
    maxTemp: $("maxTemp"),
    minTemp: $("minTemp"),
    lastHum: $("lastHum"),
    tbody: $("tbody"),
    chartCanvas: $("chartTemp"),
    zoomTempToggle: $("zoomTempToggle"),
    zoomRhToggle: $("zoomRhToggle"),
    zoomTempBadge: $("zoomTempBadge"),
    zoomRhBadge: $("zoomRhBadge")
    };

    let chart = null;
    let lastRows = [];
    let autoTimer = null;
    let autoRemain = 0;

    function setStatus(message, type = "info") {
    if (refs.status) refs.status.textContent = message;
    if (refs.apiMsg) {
    refs.apiMsg.textContent = message;
    refs.apiMsg.style.color = type === "error" ? "#dc2626" : type === "success" ? "#16a34a" : "#64748b";
    }
    }

    function toast(message, type = "info") {
    if (!refs.toasty) {
    setStatus(message, type);
    return;
    }

    const el = document.createElement("div");
    const bg = type === "error"
    ? "linear-gradient(135deg,#fee2e2,#fff)"
    : type === "success"
    ? "linear-gradient(135deg,#dcfce7,#fff)"
    : "linear-gradient(135deg,#dbeafe,#fff)";
    const color = type === "error" ? "#991b1b" : type === "success" ? "#166534" : "#1e3a8a";

    el.style.cssText = `
    border-radius:16px;
    padding:12px 14px;
    background:${bg};
    color:${color};
    border:1px solid rgba(148,163,184,.22);
    box-shadow:0 18px 40px rgba(15,23,42,.16);
    font-weight:850;
    font-size:.86rem;
    `;
    el.textContent = message;
    refs.toasty.appendChild(el);

    setTimeout(() => {
    el.style.opacity = "0";
    el.style.transform = "translateY(6px)";
    el.style.transition = "all .2s ease";
    }, 2600);
    setTimeout(() => el.remove(), 2950);
    }

    function setLoading(on) {
    if (refs.loading) refs.loading.style.display = on ? "inline-flex" : "none";
    if (refs.btnFetch) refs.btnFetch.disabled = on;
    }

    function updateNow() {
    if (!refs.nowText) return;
    refs.nowText.textContent = new Date().toLocaleString("vi-VN", {
    hour12: false,
    timeZone: "Asia/Ho_Chi_Minh"
    });
    }

    function pad2(n) {
    return String(n).padStart(2, "0");
    }

    function toDateTimeLocalValue(date) {
    return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}T${pad2(date.getHours())}:${pad2(date.getMinutes())}`;
    }

    function applyQuickRange() {
    const hours = Number(refs.quick?.value || 24);
    const end = new Date();
    const start = new Date(end.getTime() - hours * 60 * 60 * 1000);

    if (refs.from) refs.from.value = toDateTimeLocalValue(start);
    if (refs.to) refs.to.value = toDateTimeLocalValue(end);
    }

    function parseNumber(value) {
    if (value === null || value === undefined) return null;
    const match = String(value).replace(",", ".").match(/-?\d+(\.\d+)?/);
    if (!match) return null;
    const n = Number(match[0]);
    return Number.isFinite(n) ? n : null;
    }

    // Adapter duy nhất cho History API V2:
    // - Giữ nguyên toàn bộ chart/table/export đang dùng tmp1..tmp4, hum1..hum2.
    // - Chỉ chuyển response V2 dạng data[{ paramCode, value, unitCode, paramName }]
    //   về cấu trúc phẳng mà giao diện hiện tại đang đọc.
    function normalizeHistoryRow(row) {
    if (!row || typeof row !== "object") return row;

    const normalized = { ...row };

    // V2 dùng monitorTimeStamp; giao diện cũ dùng monitorTime.
    normalized.monitorTime =
    row.monitorTime ?? row.MonitorTime ??
    row.monitorTimeStamp ?? row.MonitorTimeStamp ?? null;

    const rawParams = Array.isArray(row.data)
    ? row.data
    : Array.isArray(row.Data)
    ? row.Data
    : [];

    if (!rawParams.length) return normalized;

    const temperatures = [];
    const humidities = [];

    rawParams.forEach((param, index) => {
    if (!param || typeof param !== "object") return;

    const code = String(param.paramCode ?? param.ParamCode ?? "").trim();
    const value = param.value ?? param.Value ?? null;
    const unit = String(param.unitCode ?? param.UnitCode ?? "").trim();
    const name = String(param.paramName ?? param.ParamName ?? "").trim();
    const signature = `${name} ${unit}`.toLowerCase();

    // Lưu lại theo paramCode để debug/mở rộng sau này, không ảnh hưởng UI hiện tại.
    if (code) normalized[`param_${code}`] = value;

    const isTemperature =
    unit.includes("℃") || unit.includes("°C") || unit.toLowerCase() === "c" ||
    /temperature|temp|nhiệt độ|nhiet do/.test(signature);

    const isHumidity =
    /%\s*rh|%rh|humidity|humid|độ ẩm|do am/.test(signature);

    if (isTemperature) {
    temperatures.push({ code, index, value });
    return;
    }

    if (isHumidity) {
    humidities.push({ code, index, value });
    return;
    }

    // Chỉ bổ sung khi API V2 có paramName tương ứng; không ghi đè field legacy.
    if ((normalized.signal === null || normalized.signal === undefined || normalized.signal === "") &&
    /signal|rssi|tín hiệu|tin hieu/.test(signature)) {
    normalized.signal = value;
    }

    if ((normalized.power === null || normalized.power === undefined || normalized.power === "") &&
    /power|battery|nguồn|nguon|pin/.test(signature)) {
    normalized.power = value;
    }
    });

    const byCodeThenIndex = (a, b) => {
    const ac = a.code || "~";
    const bc = b.code || "~";
    return ac.localeCompare(bc, undefined, { numeric: true }) || a.index - b.index;
    };

    temperatures.sort(byCodeThenIndex).slice(0, 4).forEach((item, index) => {
    const key = `tmp${index + 1}`;
    if (normalized[key] === null || normalized[key] === undefined || normalized[key] === "") {
    normalized[key] = item.value;
    }
    });

    humidities.sort(byCodeThenIndex).slice(0, 2).forEach((item, index) => {
    const key = `hum${index + 1}`;
    if (normalized[key] === null || normalized[key] === undefined || normalized[key] === "") {
    normalized[key] = item.value;
    }
    });

    return normalized;
    }

    function normalizeTime(value) {
    if (value === null || value === undefined) return null;
    const n = Number(value);
    if (!Number.isFinite(n) || n <= 0) return null;
    return n > 3_000_000_000 ? n : n * 1000;
    }

    function formatTime(value) {
    const ms = normalizeTime(value);
    if (!ms) return "—";
    return new Date(ms).toLocaleString("vi-VN", {
    hour12: false,
    timeZone: "Asia/Ho_Chi_Minh"
    });
    }

    function getTempKey() {
    return `tmp${refs.tempChan?.value || "1"}`;
    }

    function getHumKey() {
    return `hum${refs.humChan?.value || "1"}`;
    }

    function extractDeviceList(json) {
    const raw = json?.data ?? json?.Data ?? [];
    if (!Array.isArray(raw)) return [];

    return raw
    .map(x => {
    if (typeof x === "string") {
    return { deviceGuid: x, deviceName: x };
    }

    const deviceGuid = x?.deviceGuid ?? x?.DeviceGuid ?? x?.guid ?? x?.Guid ?? "";
    const deviceName = x?.deviceName ?? x?.DeviceName ?? x?.name ?? x?.Name ?? deviceGuid;

    return {
    deviceGuid: String(deviceGuid || "").trim(),
    deviceName: String(deviceName || deviceGuid || "").trim()
    };
    })
    .filter(x => x.deviceGuid)
    .filter((x, idx, arr) => arr.findIndex(y => y.deviceGuid.toLowerCase() === x.deviceGuid.toLowerCase()) === idx)
    .sort((a, b) => (a.deviceName || a.deviceGuid).localeCompare(b.deviceName || b.deviceGuid));
    }

    async function fetchJson(url) {
    const res = await fetch(url, {
    cache: "no-store",
    credentials: "same-origin"
    });

    const text = await res.text();
    let json = null;
    try { json = text ? JSON.parse(text) : null; } catch { }

    if (!res.ok) {
    const detail = json?.message || json?.detail || json?.error || text || res.statusText;
    const err = new Error(`HTTP ${res.status}: ${detail}`);
    err.status = res.status;
    err.payload = json;
    throw err;
    }

    return json;
    }

    async function loadDeviceList() {
    if (!refs.devicePick) return;

    const endpoints = [cfg.devicesApiUrl];
    if (cfg.isAdmin) endpoints.push('@Url.Content("~/api/elitech/device-guids")');

    refs.devicePick.innerHTML = `<option value="">— Đang tải danh sách thiết bị… —</option>`;
    setStatus("Đang tải danh sách thiết bị...", "info");

    let devices = [];
    let lastError = null;

    for (const endpoint of endpoints.filter(Boolean)) {
    try {
    console.log("LOAD HISTORY DEVICES:", endpoint, "scope =", cfg.scope);
    const json = await fetchJson(endpoint);
    devices = extractDeviceList(json);
    if (devices.length > 0) break;
    } catch (err) {
    lastError = err;
    console.warn("Device endpoint failed:", endpoint, err);
    }
    }

    if (!devices.length) {
    refs.devicePick.innerHTML = `<option value="">— Không tải được danh sách thiết bị —</option>`;
    setStatus(lastError ? lastError.message : "Không có thiết bị để hiển thị.", "error");
    return;
    }

    refs.devicePick.innerHTML = `<option value="">— Chọn thiết bị —</option>` + devices.map(d => {
    const label = d.deviceName && d.deviceName !== d.deviceGuid ? `${d.deviceName} • ${d.deviceGuid}` : d.deviceGuid;
    return `<option value="${escapeHtml(d.deviceGuid)}">${escapeHtml(label)}</option>`;
    }).join("");

    if (!refs.deviceGuid?.value && devices[0]) {
    refs.devicePick.value = devices[0].deviceGuid;
    refs.deviceGuid.value = devices[0].deviceGuid;
    if (refs.deviceText) refs.deviceText.textContent = devices[0].deviceName || devices[0].deviceGuid;
    }

    setStatus(`Đã tải ${devices.length} thiết bị.`, "success");
    }

    function escapeHtml(value) {
    return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
    }

    function buildHistoryUrl() {
    const deviceGuid = refs.deviceGuid?.value?.trim();
    if (!deviceGuid) throw new Error("Vui lòng chọn thiết bị trước khi lấy lịch sử.");

    const params = new URLSearchParams();
    params.set("deviceGuid", deviceGuid);
    params.set("limit", "500");

    if (refs.from?.value) params.set("from", new Date(refs.from.value).toISOString());
    if (refs.to?.value) params.set("to", new Date(refs.to.value).toISOString());

    return `${cfg.historyApiUrl}?${params.toString()}`;
    }

    async function fetchHistory() {
    try {
    setLoading(true);
    setStatus("Đang lấy dữ liệu lịch sử...", "info");

    const url = buildHistoryUrl();
    console.log("FETCH HISTORY:", url);

    const json = await fetchJson(url);
    const rows = Array.isArray(json?.data) ? json.data : Array.isArray(json?.Data) ? json.Data : [];

    lastRows = rows
    .map(normalizeHistoryRow)
    .filter(x => x)
    .sort((a, b) => (Number(a.monitorTime ?? 0) - Number(b.monitorTime ?? 0)));

    renderAll();
    setStatus(`Lấy dữ liệu thành công: ${lastRows.length} điểm.`, "success");
    } catch (err) {
    console.error(err);
    setStatus(err.message || "Lấy lịch sử thất bại.", "error");
    toast(err.message || "Lấy lịch sử thất bại.", "error");
    } finally {
    setLoading(false);
    }
    }

    function renderAll() {
    renderChart();
    renderTable();
    renderStats();
    }

    function renderChart() {
    if (!refs.chartCanvas || !window.Chart) return;

    const tempKey = getTempKey();
    const humKey = getHumKey();

    const tempData = lastRows
    .map(x => ({ x: normalizeTime(x.monitorTime ?? x.MonitorTime), y: parseNumber(x[tempKey] ?? x[tempKey.toUpperCase?.()]) }))
    .filter(p => p.x && p.y !== null);

    const humData = lastRows
    .map(x => ({ x: normalizeTime(x.monitorTime ?? x.MonitorTime), y: parseNumber(x[humKey] ?? x[humKey.toUpperCase?.()]) }))
    .filter(p => p.x && p.y !== null);

    const tempValues = tempData.map(x => x.y);
    const humValues = humData.map(x => x.y);
    const tempRange = calcRange(tempValues, 1.5);
    const humRange = calcRange(humValues, 5);

    if (refs.zoomTempBadge) refs.zoomTempBadge.textContent = tempRange ? `${tempRange.min} → ${tempRange.max} °C` : "°C —";
    if (refs.zoomRhBadge) refs.zoomRhBadge.textContent = humRange ? `${humRange.min} → ${humRange.max} %RH` : "%RH —";

    const useTempZoom = refs.zoomTempToggle ? refs.zoomTempToggle.checked : false;
    const useHumZoom = refs.zoomRhToggle ? refs.zoomRhToggle.checked : false;

    const data = {
    datasets: [
    {
    label: tempKey,
    data: tempData,
    yAxisID: "yTemp",
    tension: 0.25,
    pointRadius: 1.8,
    borderWidth: 2
    },
    {
    label: humKey,
    data: humData,
    yAxisID: "yHum",
    tension: 0.25,
    pointRadius: 1.8,
    borderWidth: 2
    }
    ]
    };

    const options = {
    responsive: true,
    maintainAspectRatio: false,
    interaction: { mode: "index", intersect: false },
    plugins: {
    legend: { position: "top" },
    tooltip: {
    callbacks: {
    title: items => items?.[0]?.parsed?.x ? formatTime(items[0].parsed.x) : ""
    }
    }
    },
    scales: {
    x: {
    type: "time",
    time: { tooltipFormat: "yyyy-MM-dd HH:mm" },
    ticks: { maxRotation: 0, autoSkip: true }
    },
    yTemp: {
    position: "left",
    title: { display: true, text: "°C" },
    min: useTempZoom && tempRange ? tempRange.min : undefined,
    max: useTempZoom && tempRange ? tempRange.max : undefined
    },
    yHum: {
    position: "right",
    title: { display: true, text: "%RH" },
    grid: { drawOnChartArea: false },
    min: useHumZoom && humRange ? humRange.min : undefined,
    max: useHumZoom && humRange ? humRange.max : undefined
    }
    }
    };

    if (chart) {
    chart.data = data;
    chart.options = options;
    chart.update();
    } else {
    chart = new Chart(refs.chartCanvas, {
    type: "line",
    data,
    options
    });
    }
    }

    function calcRange(values, pad) {
    const nums = values.filter(x => Number.isFinite(x));
    if (!nums.length) return null;
    const min = Math.min(...nums);
    const max = Math.max(...nums);
    if (min === max) return { min: Number((min - pad).toFixed(1)), max: Number((max + pad).toFixed(1)) };
    const dynamicPad = Math.max(pad, (max - min) * 0.12);
    return {
    min: Number((min - dynamicPad).toFixed(1)),
    max: Number((max + dynamicPad).toFixed(1))
    };
    }

    function renderTable() {
    if (!refs.tbody) return;

    refs.tbody.innerHTML = lastRows.map(x => `
    <tr>
    <td>${escapeHtml(formatTime(x.monitorTime ?? x.MonitorTime))}</td>
    <td>${escapeHtml(x.tmp1 ?? "")}</td>
    <td>${escapeHtml(x.tmp2 ?? "")}</td>
    <td>${escapeHtml(x.tmp3 ?? "")}</td>
    <td>${escapeHtml(x.tmp4 ?? "")}</td>
    <td>${escapeHtml(x.hum1 ?? "")}</td>
    <td>${escapeHtml(x.hum2 ?? "")}</td>
    <td>${escapeHtml(x.signal ?? "")}</td>
    <td>${escapeHtml(x.power ?? "")}</td>
    <td>${escapeHtml(x.address ?? "")}</td>
    </tr>
    `).join("");
    }

    function renderStats() {
    const tempKey = getTempKey();
    const humKey = getHumKey();
    const temps = lastRows.map(x => parseNumber(x[tempKey])).filter(x => Number.isFinite(x));
    const hums = lastRows.map(x => parseNumber(x[humKey])).filter(x => Number.isFinite(x));

    if (refs.pointCount) refs.pointCount.textContent = `${lastRows.length} điểm`;
    if (refs.deviceText) refs.deviceText.textContent = refs.deviceGuid?.value || "—";

    if (refs.avgTemp) refs.avgTemp.textContent = temps.length ? `${avg(temps).toFixed(1)} °C` : "—";
    if (refs.maxTemp) refs.maxTemp.textContent = temps.length ? `${Math.max(...temps).toFixed(1)} °C` : "—";
    if (refs.minTemp) refs.minTemp.textContent = temps.length ? `${Math.min(...temps).toFixed(1)} °C` : "—";
    if (refs.lastHum) refs.lastHum.textContent = hums.length ? `${hums[hums.length - 1].toFixed(1)} %RH` : "—";

    if (refs.rangeText) {
    const first = lastRows[0]?.monitorTime ?? lastRows[0]?.MonitorTime;
    const last = lastRows[lastRows.length - 1]?.monitorTime ?? lastRows[lastRows.length - 1]?.MonitorTime;
    refs.rangeText.textContent = first && last ? `${formatTime(first)} → ${formatTime(last)}` : "—";
    }
    }

    function avg(values) {
    return values.reduce((a, b) => a + b, 0) / values.length;
    }

    function clearData() {
    lastRows = [];
    if (refs.tbody) refs.tbody.innerHTML = "";
    if (chart) {
    chart.data.datasets.forEach(ds => ds.data = []);
    chart.update();
    }
    renderStats();
    setStatus("Đã xoá dữ liệu trên màn hình.", "info");
    }

    function exportCsv() {
    if (!lastRows.length) {
    toast("Chưa có dữ liệu để xuất CSV.", "error");
    return;
    }

    const headers = ["Time (UTC+7)", "tmp1", "tmp2", "tmp3", "tmp4", "hum1", "hum2", "signal", "power", "address"];
    const lines = [headers.join(",")];

    lastRows.forEach(x => {
    const row = [
    formatTime(x.monitorTime ?? x.MonitorTime),
    x.tmp1, x.tmp2, x.tmp3, x.tmp4,
    x.hum1, x.hum2,
    x.signal, x.power,
    x.address
    ].map(csvCell);
    lines.push(row.join(","));
    });

    const blob = new Blob(["\ufeff" + lines.join("\n")], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${cfg.scope || "elitech"}-history-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
    }

    function csvCell(value) {
    const s = String(value ?? "");
    return `"${s.replaceAll('"', '""')}"`;
    }

    async function exportPdf() {
    const canvas = refs.chartCanvas;
    const table = $("tbl");

    if (!canvas || !table) {
    toast("Không tìm thấy biểu đồ hoặc bảng để xuất PDF.", "error");
    return;
    }

    try {
    setStatus("Đang chuẩn bị xuất PDF...", "info");
    await new Promise(r => setTimeout(r, 300));

    const res = await fetch(cfg.exportPdfUrl || '@Url.Content("~/export/pdf")', {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    credentials: "same-origin",
    body: JSON.stringify({
    chartImage: canvas.toDataURL("image/png"),
    tableHtml: table.outerHTML,
    from: refs.from?.value || null,
    to: refs.to?.value || null,
    scope: cfg.scope
    })
    });

    if (!res.ok) throw new Error(`Export PDF lỗi HTTP ${res.status}`);

    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${cfg.scope || "Elitech"} History Report.pdf`;
    a.click();
    URL.revokeObjectURL(url);

    setStatus("Xuất PDF thành công.", "success");
    toast("Xuất PDF thành công.", "success");
    } catch (err) {
    console.error(err);
    setStatus("Xuất PDF thất bại.", "error");
    toast(err.message || "Xuất PDF thất bại.", "error");
    }
    }

    function startAuto() {
    stopAuto();

    const seconds = Number(refs.autoInterval?.value || 0);
    if (!refs.autoToggle?.checked || seconds <= 0) {
    if (refs.autoCountdown) refs.autoCountdown.textContent = "—";
    return;
    }

    autoRemain = seconds;
    if (refs.autoCountdown) refs.autoCountdown.textContent = `${autoRemain}s`;

    autoTimer = setInterval(() => {
    autoRemain -= 1;
    if (refs.autoCountdown) refs.autoCountdown.textContent = `${Math.max(0, autoRemain)}s`;

    if (autoRemain <= 0) {
    autoRemain = seconds;
    fetchHistory();
    }
    }, 1000);
    }

    function stopAuto() {
    if (autoTimer) clearInterval(autoTimer);
    autoTimer = null;
    }

    refs.devicePick?.addEventListener("change", () => {
    if (refs.deviceGuid) refs.deviceGuid.value = refs.devicePick.value || "";
    const label = refs.devicePick.options[refs.devicePick.selectedIndex]?.textContent || refs.deviceGuid?.value || "—";
    if (refs.deviceText) refs.deviceText.textContent = label;
    });

    refs.quick?.addEventListener("change", applyQuickRange);
    refs.tempChan?.addEventListener("change", renderAll);
    refs.humChan?.addEventListener("change", renderAll);
    refs.zoomTempToggle?.addEventListener("change", renderChart);
    refs.zoomRhToggle?.addEventListener("change", renderChart);
    refs.btnClear?.addEventListener("click", clearData);
    refs.btnExport?.addEventListener("click", exportCsv);
    refs.btnExportPdf?.addEventListener("click", exportPdf);
    refs.autoToggle?.addEventListener("change", startAuto);
    refs.autoInterval?.addEventListener("change", startAuto);

    refs.form?.addEventListener("submit", (e) => {
    e.preventDefault();
    fetchHistory();
    });

    updateNow();
    setInterval(updateNow, 1000);
    applyQuickRange();
    loadDeviceList();
    });
</script>
