@{
    ViewData["Title"] = "Elitech - Lịch sử thiết bị của tôi";
    Layout = "_Layout";

    // View này chỉ dành cho User
    var theme = "user";
}

<style>
    :root {
        --adm-bg: #f4f7fb;
        --adm-bg-deep: #07111f;
        --adm-panel: rgba(255,255,255,.92);
        --adm-panel-solid: #ffffff;
        --adm-soft: #f8fafc;
        --adm-soft-2: #eef4ff;
        --adm-line: rgba(148,163,184,.22);
        --adm-line-2: rgba(59,130,246,.20);
        --adm-text: #0f172a;
        --adm-muted: #64748b;
        --adm-muted-2: #94a3b8;
        --adm-blue: #2563eb;
        --adm-blue-2: #60a5fa;
        --adm-cyan: #22d3ee;
        --adm-green: #22c55e;
        --adm-amber: #f59e0b;
        --adm-red: #ef4444;
        --adm-violet: #8b5cf6;
        --adm-orange: #f58220;
        --adm-dark: #08121f;
        --adm-shadow-lg: 0 26px 70px rgba(15,23,42,.14);
        --adm-shadow-md: 0 18px 42px rgba(15,23,42,.10);
        --adm-shadow-sm: 0 8px 22px rgba(15,23,42,.07);
        --adm-radius-2xl: 30px;
        --adm-radius-xl: 24px;
        --adm-radius-lg: 18px;
        --adm-radius-md: 14px;
        --adm-radius-sm: 12px;
        --adm-glow: 0 0 0 4px rgba(37,99,235,.12);
    }

    @@keyframes hxPulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .48;
            transform: scale(.88);
        }
    }

    @@keyframes hxFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    /* html[data-elitech-theme="user"],
    html[data-elitech-theme="user"] body {
        min-height: 100%;
        background: radial-gradient(900px 500px at 0% 0%, rgba(14,165,233,.18), transparent 58%), radial-gradient(860px 480px at 100% 4%, rgba(34,197,94,.14), transparent 52%), linear-gradient(180deg, #061827 0%, #082033 36%, #f5f9ff 36%, #edf5fb 100%);
    } */

    body {
        margin: 0;
        padding: 0;
        color: var(--adm-text);
        font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        overflow-x: hidden;
    }

    .hx-admin-page,
    .hx-admin-page * {
        box-sizing: border-box;
    }

    .hx-admin-page {
        max-width: 1600px;
        width: 100%;
        margin: 0 auto;
        padding: 20px;
        color: var(--adm-text);
    }

    .hx-admin-shell {
        display: grid;
        gap: 18px;
    }

    .hx-admin-hero {
        position: relative;
        overflow: hidden;
        border-radius: var(--adm-radius-2xl);
        background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(255,255,255,.86)), radial-gradient(420px 240px at 18% 0%, rgba(96,165,250,.28), transparent 70%), radial-gradient(460px 250px at 82% 10%, rgba(245,130,32,.18), transparent 70%);
        border: 1px solid rgba(255,255,255,.62);
        box-shadow: var(--adm-shadow-lg);
        padding: 22px;
    }

        .hx-admin-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,.50) 48%, transparent 100%), repeating-linear-gradient(90deg, rgba(37,99,235,.04) 0 1px, transparent 1px 72px);
            pointer-events: none;
        }

    .hx-hero-inner {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 20px;
        align-items: stretch;
    }

    .hx-hero-main {
        display: flex;
        gap: 16px;
        align-items: center;
        min-width: 0;
    }

    .hx-logo {
        width: 68px;
        height: 68px;
        border-radius: 22px;
        display: grid;
        place-items: center;
        color: #fff;
        font-size: 30px;
        background: linear-gradient(135deg, var(--adm-orange), var(--adm-blue));
        box-shadow: 0 22px 44px rgba(37,99,235,.24), inset 0 1px 0 rgba(255,255,255,.36);
        border: 1px solid rgba(255,255,255,.42);
        flex: 0 0 auto;
        animation: hxFloat 4s ease-in-out infinite;
    }

    .hx-title-wrap {
        min-width: 0;
    }

    .hx-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 30px;
        padding: 0 11px;
        border-radius: 999px;
        background: rgba(37,99,235,.08);
        color: #1d4ed8;
        border: 1px solid rgba(37,99,235,.12);
        font-weight: 900;
        font-size: .76rem;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .hx-kicker-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--adm-green);
        box-shadow: 0 0 0 6px rgba(34,197,94,.12);
        animation: hxPulse 1.5s ease-in-out infinite;
    }

    .hx-title {
        margin: 10px 0 0;
        font-size: clamp(1.5rem, 1.1rem + 1.65vw, 2.45rem);
        line-height: 1.08;
        font-weight: 980;
        letter-spacing: -.045em;
        color: #0f172a;
    }

    .hx-sub {
        margin-top: 10px;
        max-width: 820px;
        color: var(--adm-muted);
        font-size: .97rem;
        line-height: 1.58;
        font-weight: 650;
    }

    .hx-hero-side {
        min-width: 320px;
        display: grid;
        gap: 12px;
        align-content: space-between;
        justify-items: end;
    }

    .hx-badge-row,
    .hx-hero-actions,
    .hx-badges,
    .hx-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
        align-items: center;
    }

    .hx-hero-actions {
        justify-content: flex-end;
    }

    .hx-pill,
    .hx-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 34px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid var(--adm-line);
        background: rgba(255,255,255,.72);
        color: #0f172a;
        font-size: .78rem;
        font-weight: 900;
        letter-spacing: .01em;
        white-space: nowrap;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.64);
    }

    .hx-pill-admin {
        color: #7c2d12;
        background: rgba(245,130,32,.12);
        border-color: rgba(245,130,32,.22);
    }

    .hx-pill-ok {
        color: #166534;
        background: rgba(34,197,94,.12);
        border-color: rgba(34,197,94,.20);
    }

    .hx-pill-blue {
        color: #1d4ed8;
        background: rgba(37,99,235,.10);
        border-color: rgba(37,99,235,.18);
    }

    .hx-status {
        min-height: 44px;
        border-radius: 16px;
        padding: 0 14px;
        color: #0f172a;
        background: #ffffff;
        box-shadow: var(--adm-shadow-sm);
    }

    .hx-meta-line {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--adm-muted);
        font-size: .86rem;
        font-weight: 800;
    }

    .hx-meta-card {
        display: grid;
        gap: 8px;
        justify-items: end;
    }

    .hx-btn {
        min-height: 42px;
        padding: 0 14px;
        border-radius: 13px;
        border: 1px solid var(--adm-line);
        background: #ffffff;
        color: #0f172a;
        cursor: pointer;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease, background .16s ease;
        box-shadow: var(--adm-shadow-sm);
        text-decoration: none;
    }

        .hx-btn:hover {
            transform: translateY(-1px);
            border-color: rgba(37,99,235,.26);
            box-shadow: 0 16px 30px rgba(15,23,42,.12);
            background: #f8fafc;
        }

    .hx-primary {
        color: #fff;
        border: none;
        background: linear-gradient(135deg, var(--adm-orange), #fb923c);
        box-shadow: 0 14px 30px rgba(245,130,32,.24);
    }

        .hx-primary:hover {
            color: #fff;
            background: linear-gradient(135deg, #ea580c, var(--adm-orange));
        }

    .hx-danger {
        color: #fff;
        border: none;
        background: linear-gradient(135deg, #ef4444, #f97316);
        box-shadow: 0 14px 30px rgba(239,68,68,.22);
    }

    .hx-outline {
        background: #ffffff;
    }

    .hx-sm {
        min-height: 38px;
        padding: 0 12px;
        font-size: .82rem;
    }

    .hx-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .hx-kpi {
        position: relative;
        overflow: hidden;
        min-height: 126px;
        padding: 18px;
        border-radius: var(--adm-radius-xl);
        background: rgba(255,255,255,.94);
        border: 1px solid rgba(255,255,255,.64);
        box-shadow: var(--adm-shadow-md);
    }

        .hx-kpi::before {
            content: "";
            position: absolute;
            inset: auto -28px -38px auto;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(37,99,235,.08);
        }

        .hx-kpi:nth-child(2)::before {
            background: rgba(245,130,32,.10);
        }

        .hx-kpi:nth-child(3)::before {
            background: rgba(239,68,68,.09);
        }

        .hx-kpi:nth-child(4)::before {
            background: rgba(34,197,94,.09);
        }

    .hx-kpi-top {
        position: relative;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
    }

    .hx-kpi-label {
        color: var(--adm-muted);
        font-size: .82rem;
        font-weight: 900;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .hx-kpi-icon {
        width: 42px;
        height: 42px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        background: rgba(37,99,235,.10);
        color: var(--adm-blue);
        border: 1px solid rgba(37,99,235,.12);
        flex: 0 0 auto;
    }

    .hx-kpi:nth-child(2) .hx-kpi-icon {
        background: rgba(245,130,32,.12);
        color: #c2410c;
        border-color: rgba(245,130,32,.14);
    }

    .hx-kpi:nth-child(3) .hx-kpi-icon {
        background: rgba(239,68,68,.10);
        color: #dc2626;
        border-color: rgba(239,68,68,.14);
    }

    .hx-kpi:nth-child(4) .hx-kpi-icon {
        background: rgba(34,197,94,.11);
        color: #16a34a;
        border-color: rgba(34,197,94,.14);
    }

    .hx-num {
        position: relative;
        margin-top: 12px;
        color: #0f172a;
        font-size: 1.42rem;
        line-height: 1.15;
        font-weight: 980;
        letter-spacing: -.035em;
        overflow-wrap: anywhere;
    }

    .hx-kpi-foot {
        position: relative;
        margin-top: 8px;
        color: var(--adm-muted);
        font-size: .8rem;
        font-weight: 760;
    }

    .hx-grid {
        display: grid;
        grid-template-columns: 410px minmax(0,1fr);
        gap: 18px;
        align-items: start;
    }

    .hx-left,
    .hx-right {
        min-width: 0;
        display: grid;
        gap: 18px;
    }

    .hx-card {
        min-width: 0;
        overflow: hidden;
        border-radius: var(--adm-radius-xl);
        background: rgba(255,255,255,.96);
        border: 1px solid rgba(255,255,255,.62);
        box-shadow: var(--adm-shadow-md);
    }

    .hx-card-head {
        padding: 16px 18px;
        border-bottom: 1px solid rgba(148,163,184,.14);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        flex-wrap: wrap;
        background: linear-gradient(180deg, rgba(255,255,255,.92), rgba(248,250,252,.82));
    }

        .hx-card-head h3 {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1rem;
            font-weight: 960;
            letter-spacing: -.02em;
            color: #0f172a;
        }

            .hx-card-head h3 i {
                color: var(--adm-blue);
            }

    .hx-card-body {
        padding: 18px;
        min-width: 0;
    }

    .hx-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-width: 0;
    }

    .hx-field,
    .hx-row2,
    .hx-row3,
    .hx-auto,
    .hx-badges,
    .hx-table-wrap {
        min-width: 0;
    }

    .hx-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 7px;
        color: #0f172a;
        font-weight: 900;
        font-size: .84rem;
        letter-spacing: .01em;
    }

        .hx-label small {
            color: var(--adm-muted-2);
            font-weight: 800;
        }

    .hx-input {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        height: 45px;
        padding: 0 12px;
        border-radius: var(--adm-radius-sm);
        border: 1px solid rgba(148,163,184,.28);
        background: #ffffff;
        color: #0f172a;
        outline: none;
        font-weight: 720;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.65);
        transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
    }

        .hx-input:focus {
            border-color: rgba(37,99,235,.42);
            box-shadow: var(--adm-glow);
            background: white;
        }

        .hx-input::placeholder {
            color: #94a3b8;
        }

    select.hx-input option {
        color: #0f172a;
        background: #ffffff;
    }

    input[type="datetime-local"] {
        color-scheme: light;
    }

    .hx-row2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .hx-row3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
    }

    .hx-actions {
        justify-content: flex-start;
    }

    .hx-sep {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(148,163,184,.24), transparent);
        margin: 2px 0;
    }

    .hx-auto {
        display: grid;
        grid-template-columns: minmax(0,1fr) 110px auto;
        gap: 10px;
        align-items: center;
    }

    .hx-switch {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #0f172a;
        font-size: .84rem;
        font-weight: 850;
        min-width: 0;
    }

        .hx-switch input {
            accent-color: var(--adm-blue);
            transform: translateY(-.5px);
        }

    .hx-help,
    .hx-hint,
    .hx-note,
    .hx-api,
    .hx-muted {
        color: var(--adm-muted);
        font-size: .82rem;
        line-height: 1.48;
        font-weight: 700;
    }

    .hx-help {
        margin-top: 8px;
        padding: 10px 12px;
        border-radius: 14px;
        background: rgba(37,99,235,.06);
        border: 1px solid rgba(37,99,235,.10);
        color: #334155;
    }

    .hx-admin-mini {
        display: grid;
        gap: 10px;
    }

    .hx-mini-item {
        display: grid;
        grid-template-columns: 38px minmax(0,1fr);
        gap: 10px;
        align-items: start;
        padding: 12px;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid rgba(148,163,184,.16);
    }

        .hx-mini-item i {
            width: 38px;
            height: 38px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            color: #1d4ed8;
            background: rgba(37,99,235,.08);
        }

    .hx-mini-title {
        color: #0f172a;
        font-weight: 930;
        font-size: .9rem;
    }

    .hx-mini-text {
        margin-top: 3px;
        color: var(--adm-muted);
        font-size: .8rem;
        line-height: 1.45;
        font-weight: 720;
    }

    .hx-loading {
        display: none;
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 14px;
        border-radius: 13px;
        background: rgba(37,99,235,.10);
        border: 1px solid rgba(37,99,235,.16);
        color: #1d4ed8;
        font-weight: 900;
        font-size: .84rem;
    }

    .hx-chart {
        position: relative;
        height: 480px;
        width: 100%;
        border-radius: 20px;
        background: linear-gradient(180deg, #ffffff, #f8fafc), repeating-linear-gradient(0deg, rgba(148,163,184,.06) 0 1px, transparent 1px 36px);
        border: 1px solid rgba(148,163,184,.20);
        padding: 10px;
    }

    .hx-table-wrap {
        max-height: 520px;
        overflow: auto;
        border-radius: 18px;
        border: 1px solid rgba(148,163,184,.18);
        background: #ffffff;
    }

    .hx-table {
        width: 100%;
        min-width: 980px;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 13px;
        color: #334155;
    }

        .hx-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #eef4ff;
            color: #0f172a;
            font-weight: 950;
            text-align: left;
            border-bottom: 1px solid rgba(148,163,184,.22);
            white-space: nowrap;
        }

        .hx-table th,
        .hx-table td {
            padding: 10px 12px;
            border-bottom: 1px solid rgba(148,163,184,.10);
            vertical-align: top;
        }

        .hx-table tbody tr:nth-child(odd) {
            background: rgba(248,250,252,.78);
        }

        .hx-table tbody tr:hover {
            background: rgba(37,99,235,.07);
        }

        .hx-table td {
            color: #0f172a;
            word-break: break-word;
        }

    .hx-api {
        margin-top: 12px;
        min-height: 22px;
    }

    .hx-toasty {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 9999;
        display: grid;
        gap: 10px;
        width: min(390px, calc(100vw - 28px));
        pointer-events: none;
    }

        .hx-toasty > * {
            pointer-events: auto;
        }

    .hx-admin-page main,
    .hx-admin-page .container,
    .hx-admin-page .container-lg,
    .hx-admin-page .container-xl,
    .hx-admin-page .container-xxl {
        max-width: 100% !important;
    }

    @@media (max-width: 1280px) {
        .hx-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .hx-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 980px) {
        .hx-admin-page {
            padding: 14px;
            max-width: 100% !important;
        }

        .hx-hero-inner {
            grid-template-columns: 1fr;
        }

        .hx-hero-side {
            min-width: 0;
            justify-items: start;
        }

        .hx-hero-actions {
            justify-content: flex-start;
        }

        .hx-row2,
        .hx-row3,
        .hx-kpi-grid {
            grid-template-columns: 1fr !important;
        }

        .hx-auto {
            grid-template-columns: 1fr;
        }

        .hx-actions,
        .hx-hero-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .hx-btn {
            width: 100%;
        }

        .hx-chart {
            height: 340px;
        }

        .hx-table {
            min-width: 860px;
        }

        main, .container, .container-lg, .container-xl, .elx-main,
        .container-sm, .container-md, .container-xxl {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
        }
    }

    @@media (max-width: 640px) {
        .hx-admin-page {
            padding: 10px !important;
        }

        .hx-admin-hero,
        .hx-card,
        .hx-kpi {
            border-radius: 20px;
        }

        .hx-admin-hero,
        .hx-card-body {
            padding: 14px;
        }

        .hx-card-head {
            padding: 14px;
        }

        .hx-hero-main {
            align-items: flex-start;
        }

        .hx-logo {
            width: 54px;
            height: 54px;
            border-radius: 17px;
            font-size: 24px;
        }

        .hx-chart {
            height: 270px;
            padding: 6px;
        }

        .hx-table {
            min-width: 760px;
        }
    }


    /* ===== USER VERSION OVERRIDES ===== */
    .hx-user-page .hx-logo {
        background: linear-gradient(135deg, #0ea5e9, #2563eb 52%, #22c55e);
        box-shadow: 0 22px 48px rgba(37,99,235,.24), inset 0 1px 0 rgba(255,255,255,.28);
    }

    .hx-user-page .hx-pill-admin {
        background: linear-gradient(135deg, rgba(37,99,235,.14), rgba(34,197,94,.12));
        border-color: rgba(37,99,235,.22);
        color: #1d4ed8;
    }

    .hx-user-page .hx-kicker-dot {
        background: #22c55e;
        box-shadow: 0 0 0 7px rgba(34,197,94,.13);
    }

    .hx-user-page .hx-primary {
        background: linear-gradient(135deg, #2563eb, #0ea5e9);
        box-shadow: 0 16px 34px rgba(37,99,235,.24);
    }

