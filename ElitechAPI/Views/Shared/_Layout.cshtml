            <source src="/sounds/alarm.mp3" type="audio/mpeg" />
        </audio>
    </div>

    <script>
            window.__ELX_CAN_ADMIN_AREA__ = @(isAdmin.ToString().ToLowerInvariant());
            window.__ELX_IS_REAL_ADMIN__ = @(User.IsInRole("Admin").ToString().ToLowerInvariant());
            window.__ELX_ROLE_NAME__ = "@roleName";

            (function() {
                const openBtn = document.getElementById('elxCommandOpen');
                const backdrop = document.getElementById('elxCmdkBackdrop');
                const input = document.getElementById('elxCmdkInput');
                const closeBtn = document.getElementById('elxCmdkClose');
                const results = document.getElementById('elxCmdkResults');

                if (!backdrop || !input || !results) return;

                let activeIndex = 0;
                let flatResults = [];
                let searchTimer = null;
                let requestSeq = 0;

                const canAdminArea = window.__ELX_CAN_ADMIN_AREA__ === true;
                const isRealAdmin = window.__ELX_IS_REAL_ADMIN__ === true;

                const pages = [
                    {
                        group: 'Pages',
                        title: 'Dashboard',
                        desc: 'Mở trang tổng quan theo đúng vai trò hiện tại',
                        url: '/Home/Router',
                        icon: 'bi-speedometer2',
                        tone: 'orange',
                        tag: 'Page',
                        keys: 'dashboard home router tổng quan admin user staff'
                    },
                    {
                        group: 'Pages',
                        title: 'Realtime Monitoring',
                        desc: 'Theo dõi nhiệt độ, độ ẩm và trạng thái live',
                        url: '/ElitechRealtime/Index',
                        icon: 'bi-broadcast-pin',
                        tone: 'blue',
                        tag: 'Live',
                        keys: 'realtime live monitoring nhiệt độ độ ẩm signalr'
                    },
                    {
                        group: 'Pages',
                        title: 'Devices',
                        desc: 'Danh sách thiết bị / Device Page',
                        url: '/ElitechDevicePage/Index',
                        icon: 'bi-cpu',
                        tone: 'blue',
                        tag: 'Device',
                        keys: 'device devices thiết bị logger guid serial'
                    },
                    {
                        group: 'Pages',
                        title: canAdminArea ? 'History Admin Chart' : 'History Chart',
                        desc: 'Biểu đồ lịch sử và dữ liệu đo',
                        url: canAdminArea ? '/ElitechHistoryAdminPage/Index' : '/ElitechHistoryUserPage/Index',
                        icon: 'bi-graph-up-arrow',
                        tone: 'green',
                        tag: 'Chart',
                        keys: 'history chart biểu đồ lịch sử report pdf csv excel'
                    },
                    {
                        group: 'Alerts',
                        title: 'Alert Rules',
                        desc: 'Cài ngưỡng cảnh báo nhiệt độ / độ ẩm',
                        url: '/ElitechAlertRulesPage/Index',
                        icon: 'bi-sliders',
                        tone: 'orange',
                        tag: 'Rules',
                        keys: 'alert rules alarm ngưỡng cảnh báo nhiệt độ độ ẩm threshold'
                    },
                    {
                        group: 'Alerts',
                        title: 'Alert History',
                        desc: 'Xem lịch sử cảnh báo thiết bị',
                        url: '/ElitechAlertHistoryPage/Index',
                        icon: 'bi-bell-fill',
                        tone: 'red',
                        tag: 'Alert',
                        keys: 'alert history alarm cảnh báo vượt ngưỡng mất nguồn pin yếu'
                    },
                    {
                        group: 'Alerts',
                        title: 'SMS Periodic',
                        desc: 'SMS định kỳ nhiệt độ',
                        url: '/SmsPeriodic',
                        icon: 'bi-alarm',
                        tone: 'orange',
                        tag: 'SMS',
                        keys: 'sms periodic định kỳ tin nhắn nhiệt độ'
                    }
                ];

                if (canAdminArea) {
                    pages.push(
                        {
                            group: 'Pages',
                            title: 'Admin Dashboard',
                            desc: 'Mở command center dành cho Admin / Staff',
                            url: '/Admin/Index',
                            icon: 'bi-command',
                            tone: 'orange',
                            tag: 'Admin',
                            keys: 'admin dashboard command center'
                        },
                        {
                            group: 'Devices',
                            title: 'Assign Devices',
                            desc: 'Gán thiết bị cho tài khoản user',
                            url: '/Admin/AssignDevices',
                            icon: 'bi-diagram-3-fill',
                            tone: 'orange',
                            tag: 'Assign',
                            keys: 'assign bind gán thiết bị user account'
                        }
                    );
                }

                if (isRealAdmin) {
                    pages.push(
                        {
                            group: 'Accounts',
                            title: 'Accounts Management',
                            desc: 'Quản lý Admin / Staff / User',
                            url: '/Admin/Accounts',
                            icon: 'bi-people-fill',
                            tone: 'green',
                            tag: 'Accounts',
                            keys: 'account accounts user staff admin tài khoản quản lý'
                        },
                        {
                            group: 'Accounts',
                            title: 'Login Sessions',
                            desc: 'Kiểm tra và revoke phiên đăng nhập',
                            url: '/Admin/Sessions',
                            icon: 'bi-shield-lock-fill',
                            tone: 'blue',
                            tag: 'Security',
                            keys: 'session login bảo mật revoke đăng nhập security'
                        },
                        {
                            group: 'Alerts',
                            title: 'SMS Subscriptions',
                            desc: 'Quản lý đăng ký SMS cảnh báo',
                            url: '/Admin/SmsSubscriptions',
                            icon: 'bi-chat-dots-fill',
                            tone: 'orange',
                            tag: 'SMS',
                            keys: 'sms subscription activation đăng ký cảnh báo phone otp'
                        }
                    );
                }

                function normalize(value) {
                    return String(value ?? '')
                        .trim()
                        .toLowerCase()
                        .normalize('NFD')
                        .replace(/[̀-ͯ]/g, '');
                }

                function escapeHtml(value) {
                    return String(value ?? '').replace(/[&<>"']/g, ch => ({
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#039;'
                    }[ch]));
                }

                function matchItem(item, q) {
                    const blob = normalize(`${item.title} ${item.desc} ${item.keys || ''} ${item.tag || ''}`);
                    return !q || blob.includes(q);
                }

                async function safeFetchJson(url) {
                    try {
                        const res = await fetch(url, {
                            method: 'GET',
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' }
                        });

                        if (!res.ok) return null;
                        return await res.json();
                    } catch {
                        return null;
                    }
                }

                function normalizeDeviceEntry(raw) {
                    if (typeof raw === 'string') {
                        const guid = raw.trim();
                        return guid ? { guid, name: 'Device' } : null;
                    }

                    if (!raw || typeof raw !== 'object') return null;

                    const guid = String(raw.deviceGuid ?? raw.DeviceGuid ?? raw.serialNumber ?? raw.SerialNumber ?? raw.serial ?? raw.Serial ?? raw.guid ?? raw.Guid ?? '').trim();
                    const name = String(raw.deviceName ?? raw.DeviceName ?? raw.name ?? raw.Name ?? raw.notes ?? raw.Notes ?? raw.label ?? raw.Label ?? 'Device').trim();

                    if (!guid) return null;
                    return { guid, name: name || 'Device' };
                }

                async function searchDevices(q) {
                    if (!q || q.length < 2) return [];

                    const sources = await Promise.all([
                        safeFetchJson('/api/elitech/device-guids'),
                        safeFetchJson('/api/user/my-serials')
                    ]);

                    const rows = [];

                    sources.forEach(json => {
                        const data = Array.isArray(json?.data) ? json.data
                            : Array.isArray(json?.Data) ? json.Data
                                : Array.isArray(json) ? json
                                    : [];

                        data.forEach(item => {
                            const d = normalizeDeviceEntry(item);
                            if (d) rows.push(d);
                        });
                    });

                    const seen = new Set();
                    return rows
                        .filter(d => {
                            const key = d.guid.toUpperCase();
                            if (seen.has(key)) return false;
                            seen.add(key);

                            const blob = normalize(`${d.guid} ${d.name}`);
                            return blob.includes(q);
                        })
                        .slice(0, 8)
                        .map(d => ({
                            group: 'Devices',
                            title: d.name && d.name !== 'Device' ? d.name : d.guid,
                            desc: d.name && d.name !== 'Device' ? `GUID / Serial: ${d.guid}` : 'Device GUID / Serial',
                            url: `/ElitechRealtime/Index?deviceGuids=${encodeURIComponent(d.guid)}`,
                            icon: 'bi-cpu-fill',
                            tone: 'blue',
                            tag: 'Realtime',
                            keys: d.guid
                        }));
                }

                async function searchAccounts(q) {
                    if (!isRealAdmin || !q || q.length < 2) return [];

                    const json = await safeFetchJson('/api/admin/accounts');
                    const arr = Array.isArray(json?.data) ? json.data : Array.isArray(json?.Data) ? json.Data : [];

                    return arr
                        .filter(a => {
                            const blob = normalize(`${a.username || ''} ${a.email || ''} ${a.role || ''} ${a.name || ''}`);
                            return blob.includes(q);
                        })
                        .slice(0, 8)
                        .map(a => ({
                            group: 'Accounts',
                            title: a.username || a.email || 'Account',
                            desc: `${a.email || 'No email'} • Role: ${a.role ?? '-'}`,
                            url: '/Admin/Accounts',
                            icon: 'bi-person-fill-gear',
                            tone: 'green',
                            tag: a.isActive === false ? 'Disabled' : 'Active',
                            keys: `${a.username || ''} ${a.email || ''}`
                        }));
                }

                function groupBy(items) {
                    return items.reduce((acc, item) => {
                        const g = item.group || 'Results';
                        if (!acc[g]) acc[g] = [];
                        acc[g].push(item);
                        return acc;
                    }, {});
                }

                function render(items) {
                    flatResults = items || [];
                    activeIndex = Math.min(activeIndex, Math.max(flatResults.length - 1, 0));

                    if (!flatResults.length) {
                        results.innerHTML = '<div class="elx-cmdk-empty">Không tìm thấy kết quả phù hợp.</div>';
                        return;
                    }

                    const grouped = groupBy(flatResults);
                    let html = '';

                    Object.keys(grouped).forEach(group => {
                        html += '<div class="elx-cmdk-group">';
                        html += `<div class="elx-cmdk-group-title">${escapeHtml(group)}</div>`;

                        grouped[group].forEach(item => {
                            const index = flatResults.indexOf(item);
                            html += `
                                                        <button type="button"
                                                                class="elx-cmdk-item ${escapeHtml(item.tone || 'blue')} ${index === activeIndex ? 'is-active' : ''}"
                                                                data-index="${index}">
                                                            <span class="elx-cmdk-icon"><i class="bi ${escapeHtml(item.icon || 'bi-search')}"></i></span>
                                                            <span class="elx-cmdk-main">
                                                                <b>${escapeHtml(item.title)}</b>
                                                                <span>${escapeHtml(item.desc)}</span>
                                                            </span>
                                                            <span class="elx-cmdk-tag">${escapeHtml(item.tag || group)}</span>
                                                        </button>
                                                    `;
                        });

                        html += '</div>';
                    });

                    results.innerHTML = html;

                    results.querySelectorAll('[data-index]').forEach(btn => {
                        btn.addEventListener('click', () => {
                            const idx = Number(btn.getAttribute('data-index'));
                            openResult(idx);
                        });
                    });
                }

                function renderLoading(local) {
                    render(local);
                    if (!local.length) {
                        results.innerHTML = '<div class="elx-cmdk-loading"><i class="bi bi-arrow-repeat"></i>Đang tìm trong thiết bị và tài khoản...</div>';
                    }
                }

                async function doSearch() {
                    const seq = ++requestSeq;
                    const q = normalize(input.value);

                    const local = pages
                        .filter(x => matchItem(x, q))
                        .slice(0, q ? 10 : 8);

                    if (!q) {
                        render(local);
                        return;
                    }

                    renderLoading(local);

                    const [devices, accounts] = await Promise.all([
                        searchDevices(q),
                        searchAccounts(q)
                    ]);

                    if (seq !== requestSeq) return;

                    render([
                        ...local,
                        ...devices,
                        ...accounts
                    ]);
                }

                function scheduleSearch() {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(doSearch, 160);
                }

                function openModal() {
                    backdrop.hidden = false;
                    document.body.style.overflow = 'hidden';
                    input.value = '';
                    activeIndex = 0;
                    requestSeq++;
                    render(pages.slice(0, 8));
                    setTimeout(() => input.focus(), 30);
                }

                function closeModal() {
                    backdrop.hidden = true;
                    document.body.style.overflow = '';
                }

                function openResult(index) {
                    const item = flatResults[index];
                    if (!item?.url) return;
                    window.location.href = item.url;
                }

                function moveActive(step) {
                    if (!flatResults.length) return;

                    activeIndex += step;
                    if (activeIndex < 0) activeIndex = flatResults.length - 1;
                    if (activeIndex >= flatResults.length) activeIndex = 0;

                    render(flatResults);
                    results.querySelector('.elx-cmdk-item.is-active')?.scrollIntoView({ block: 'nearest' });
                }

                openBtn?.addEventListener('click', openModal);
                closeBtn?.addEventListener('click', closeModal);

                backdrop.addEventListener('click', e => {
                    if (e.target === backdrop) closeModal();
                });

                input.addEventListener('input', scheduleSearch);

                document.addEventListener('keydown', e => {
                    const key = (e.key || '').toLowerCase();

                    if ((e.ctrlKey || e.metaKey) && key === 'k') {
                        e.preventDefault();
                        openModal();
                        return;
                    }

                    if (backdrop.hidden) return;

                    if (e.key === 'Escape') {
                        e.preventDefault();
                        closeModal();
                        return;
                    }

                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        moveActive(1);
                        return;
                    }

                    if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        moveActive(-1);
                        return;
                    }

                    if (e.key === 'Enter') {
                        e.preventDefault();
                        openResult(activeIndex);
                    }
                });
            })();
    </script>

    <script>
            (function() {
                const host = document.getElementById('elitechToastHost');
                if (!host) return;

                const LS_KEY = 'elitech_seen_alert_ids_v1';

                function loadSeen() {
                    try {
                        const raw = localStorage.getItem(LS_KEY);
                        const arr = raw ? JSON.parse(raw) : [];
                        return new Set(Array.isArray(arr) ? arr.filter(x => typeof x === 'string') : []);
                    } catch {
                        return new Set();
                    }
                }

                function saveSeen(set) {
                    try {
                        const arr = Array.from(set);
                        const trimmed = arr.length > 300 ? arr.slice(arr.length - 300) : arr;
                        localStorage.setItem(LS_KEY, JSON.stringify(trimmed));
                    } catch { }
                }

                const seen = loadSeen();

                const AUDIO_KEY = 'elitech_audio_unlocked_v2';
                let audioUnlocked = false;

                const audioHigh = new Audio('/sounds/alarm.mp3');
                const audioWarn = new Audio('/sounds/alarm.mp3');

                audioHigh.preload = 'auto';
                audioWarn.preload = 'auto';
                audioHigh.loop = true;
                audioWarn.loop = true;
                audioHigh.volume = 0.88;
                audioWarn.volume = 0.62;

                let activeHighCount = 0;
                let activeWarnCount = 0;
                let pendingLevel = null;

                function normalizeLevel(level) {
                    const lv = String(level || '').toLowerCase();
                    if (lv === 'warn' || lv === 'warning') return 'warn';
                    return 'high';
                }

            function ensureUnlockButton() {
    let btn = document.getElementById('elitechAudioUnlockBtn');
    if (btn) return btn;

    btn = document.createElement('button');
    btn.id = 'elitechAudioUnlockBtn';
    btn.type = 'button';

    btn.innerHTML =
        '<i class="bi bi-volume-up-fill"></i>' +
        '<span>Bấm để cho phép âm thanh cảnh báo</span>';

    btn.style.cssText = `
        position:fixed;
        left:18px;
        bottom:18px;
        z-index:100000;
        min-height:46px;
        padding:0 16px;
        border-radius:999px;
        border:1px solid rgba(255,255,255,.20);
        background:linear-gradient(135deg,#f58220,#ffb25b);
        color:#111827;
        font-weight:1000;
        box-shadow:0 18px 44px rgba(15,23,42,.24);
        display:none;
        align-items:center;
        gap:9px;
        cursor:pointer;
    `;

    btn.addEventListener('click', async function(e) {
        e.preventDefault();
        await unlockAudio();
    });

    document.body.appendChild(btn);

    return btn;
}
                function showUnlockButton() {
                    const btn = ensureUnlockButton();
                    btn.style.display = 'inline-flex';
                }

                function hideUnlockButton() {
                    const btn = document.getElementById('elitechAudioUnlockBtn');
                    if (btn) btn.style.display = 'none';
                }

                function stopAllAudio() {
                    try { audioHigh.pause(); audioHigh.currentTime = 0; } catch { }
                    try { audioWarn.pause(); audioWarn.currentTime = 0; } catch { }
                }

                function markAudioBlocked(err) {
                    audioUnlocked = false;
                    attachAudioUnlockEvents();
                    showUnlockButton();
                    console.warn('⛔ Alarm audio blocked, waiting for user gesture:', err);
                }

                function playAudio(audio, lv) {
                    audio.currentTime = 0;
                    const promise = audio.play();
                    if (promise && typeof promise.catch === 'function') {
                        promise.catch(err => {
                            pendingLevel = lv;
                            markAudioBlocked(err);
                        });
                    }
                }

                function syncAudio() {

                    // Audio hệ thống đang OFF thì không phát.
                    // Hiện tại mặc định audioEnabled = true.
                    if (!audioEnabled) {
                        stopAllAudio();
                        return;
                    }

                    const needHigh = activeHighCount > 0;
                    const needWarn = !needHigh && activeWarnCount > 0;

                    if (!needHigh && !needWarn) {
                        stopAllAudio();
                        return;
                    }

                    // Browser chưa unlock audio.
                    // Alert vẫn đang ON, chỉ đang chờ quyền browser.
                    if (!audioUnlocked) {

                        pendingLevel = needHigh
                            ? 'high'
                            : 'warn';

                        attachAudioUnlockEvents();

                        // Thử unlock luôn.
                        unlockAudio().catch(() => {
                            // Chỉ khi browser thực sự chặn mới hiện nút.
                            showUnlockButton();
                        });

                        return;
                    }

                    if (needHigh) {

                        if (!audioWarn.paused) {
                            audioWarn.pause();
                            audioWarn.currentTime = 0;
                        }

                        if (audioHigh.paused) {
                            playAudio(
                                audioHigh,
                                'high'
                            );
                        }

                        return;
                    }

                    if (!audioHigh.paused) {
                        audioHigh.pause();
                        audioHigh.currentTime = 0;
                    }

                    if (audioWarn.paused) {
                        playAudio(
                            audioWarn,
                            'warn'
                        );
                    }
                }
                async function unlockAudio() {
                    try {
                        await audioHigh.play();
                        audioHigh.pause(); audioHigh.currentTime = 0;

                        await audioWarn.play();
                        audioWarn.pause(); audioWarn.currentTime = 0;

                        audioUnlocked = true;
                        pendingLevel = pendingLevel || null;
                        try { localStorage.setItem(AUDIO_KEY, '1'); } catch { }

                        detachAudioUnlockEvents();
                        hideUnlockButton();
                        syncAudio();
                        console.log('✅ Alarm audio unlocked');
                    } catch (e) {
                        markAudioBlocked(e);
                    }
                }

                function attachAudioUnlockEvents() {
                    window.addEventListener('pointerdown', unlockAudio, { passive: true });
                    window.addEventListener('click', unlockAudio);
                    window.addEventListener('keydown', unlockAudio);
                    window.addEventListener('touchstart', unlockAudio, { passive: true });
                }

                function detachAudioUnlockEvents() {
                    window.removeEventListener('pointerdown', unlockAudio);
                    window.removeEventListener('click', unlockAudio);
                    window.removeEventListener('keydown', unlockAudio);
                    window.removeEventListener('touchstart', unlockAudio);
                }

                attachAudioUnlockEvents();

                window.elitechUnlockAlarmAudio = unlockAudio;
                window.elitechPlayAlarmSound = function(level, durationMs) {
                    const lv = normalizeLevel(level || 'high');
                    beginSound(lv);
                    const ms = Number(durationMs || 0);
                    if (Number.isFinite(ms) && ms > 0) {
                        setTimeout(() => endSound(lv), ms);
                    }
                };
                window.elitechStopAlarmSound = function(level) {
                    endSound(level || 'high');
                };
                window.elitechStopAllAlarmSound = function() {
                    activeHighCount = 0;
                    activeWarnCount = 0;
                    pendingLevel = null;
                    stopAllAudio();
                };

                document.addEventListener('elitech:alarm', function(e) {
                    window.elitechPlayAlarmSound(e?.detail?.level || 'high', e?.detail?.durationMs || 9000);
                });

                function beginSound(level) {
                    const lv = normalizeLevel(level);

                    if (lv === 'warn') activeWarnCount++;
                    else activeHighCount++;

                    syncAudio();
                }

                function endSound(level) {
                    const lv = normalizeLevel(level);

                    if (lv === 'warn') activeWarnCount = Math.max(0, activeWarnCount - 1);
                    else activeHighCount = Math.max(0, activeHighCount - 1);

                    syncAudio();
                }

                function stableKey(a) {
                    const raw = a?.id ?? a?._id ?? a?.Id ?? a?.ID;
                    if (typeof raw === 'string' && raw.trim()) return raw.trim();

                    const dg = (a?.deviceGuid ?? a?.DeviceGuid ?? '').toString().trim();
                    const ts = (a?.occurredAtUtc ?? a?.OccurredAtUtc ?? a?.ts ?? a?.alarmTimeStamp ?? '').toString().trim();
                    return (dg && ts) ? (dg + '|' + ts) : (dg || ts || JSON.stringify(a));
                }

                function toastAlert(a) {
                    const key = stableKey(a);

                    if (seen.has(key)) return;
                    seen.add(key);
                    saveSeen(seen);

                    const dev = (a?.deviceName ?? a?.DeviceName ?? 'Device').toString();
                    const reasons = (a?.reasons ?? a?.Reasons ?? a?.message ?? a?.Message ?? 'ALARM').toString();
                    const whenRaw = a?.occurredAtUtc ?? a?.OccurredAtUtc ?? a?.ts;
                    const when = whenRaw ? new Date(whenRaw).toLocaleString() : '';
                    const level = (a?.level ?? a?.Level ?? 'high');

                    const el = document.createElement('div');
                    el.setAttribute('data-level', normalizeLevel(level));
                    el.setAttribute('data-alert-key', key);

                    el.style.cssText = `
                                                                    background:linear-gradient(135deg,#111827,#020617);color:#fff;border-radius:18px;padding:14px 15px;margin-bottom:10px;
                                                                    box-shadow:0 22px 52px rgba(0,0,0,.22);cursor:pointer;border:1px solid rgba(255,255,255,.12)
                                                                `;
                    el.innerHTML = `
                                                                    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
                                                                        <div style="font-weight:1000">⚠️ ${dev}</div>
                                                                        <div style="opacity:.7;font-size:12px;font-weight:800">${when}</div>
                                                                    </div>
                                                                    <div style="opacity:.9;margin-top:7px;font-size:13px;font-weight:760;line-height:1.4">${reasons}</div>
                                                                    <a href="/ElitechAlertHistoryPage/Index"
                                                                       style="opacity:.82;margin-top:8px;font-size:12px;display:inline-block;text-decoration:none;color:#93c5fd;font-weight:900;">
                                                                        Bấm để xem chi tiết
                                                                    </a>
                                                                `;

                    el.addEventListener('click', async () => {
                        try {
                            const oid = a?.id ?? a?._id ?? a?.Id ?? a?.ID;
                            if (typeof oid === 'string' && oid.trim()) {
                                await fetch('/api/elitech/alerts/mark-read?id=' + encodeURIComponent(oid.trim()), { method: 'POST' });
                            }
                        } catch { }

                        window.location.href = '/realtime';
                    });

                    host.appendChild(el);
                    beginSound(level);

                    setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity .25s'; }, 9000);
                    setTimeout(() => {
                        endSound(level);
                        el.remove();
                    }, 9400);
                }

                async function pollUnread() {
                    try {
                        const res = await fetch('/api/elitech/alerts/unread?take=5', { cache: 'no-store' });
                        if (!res.ok) return;
                        const json = await res.json();
                        const list = json?.data ?? [];
                        list.reverse().forEach(toastAlert);
                    } catch { }
                }

                pollUnread();
                setInterval(pollUnread, 15000);
            })();

            (function() {
                const box = document.getElementById('smsBox');
                const closeBtn = document.getElementById('smsClose');

                const stepPhone = document.getElementById('smsStepPhone');
                const stepOtp = document.getElementById('smsStepOtp');

                const phoneInput = document.getElementById('smsPhone');
                const otpInput = document.getElementById('smsOtp');

                const msg1 = document.getElementById('smsMsg1');
                const msg2 = document.getElementById('smsMsg2');

                const btnNext = document.getElementById('smsNext');
                const btnBack = document.getElementById('smsBack');
                const btnSend = document.getElementById('smsSendOtp');
                const btnVerify = document.getElementById('smsVerify');

                if (!box || !closeBtn || !stepPhone || !stepOtp || !phoneInput || !otpInput || !msg1 || !msg2 || !btnNext || !btnBack || !btnSend || !btnVerify) return;

                function getToken() {
                    const el = document.querySelector('#smsAntiForgeryForm input[name="__RequestVerificationToken"]');
                    return el ? el.value : "";
                }

                window.openSmsSubscribe = function(prefillPhone) {
                    box.style.display = 'block';
                    stepPhone.style.display = '';
                    stepOtp.style.display = 'none';
                    msg1.textContent = '';
                    msg2.textContent = '';
                    otpInput.value = '';
                    if (prefillPhone) phoneInput.value = prefillPhone;
                    phoneInput.focus();
                }

                function showStepOtp() {
                    stepPhone.style.display = 'none';
                    stepOtp.style.display = '';
                    msg2.textContent = 'Bấm "Gửi mã OTP" để nhận tin nhắn.';
                }

                closeBtn.addEventListener('click', () => box.style.display = 'none');

                btnNext.addEventListener('click', () => {
                    const p = (phoneInput.value || '').trim();
                    if (!p) { msg1.textContent = 'Vui lòng nhập số điện thoại.'; return; }
                    msg1.textContent = '';
                    showStepOtp();
                });

                btnBack.addEventListener('click', () => {
                    stepPhone.style.display = '';
                    stepOtp.style.display = 'none';
                    msg1.textContent = '';
                });

                btnSend.addEventListener('click', async () => {
                    msg2.textContent = 'Đang gửi OTP...';
                    const phone = (phoneInput.value || '').trim();

                    const res = await fetch('/Sms/send-code', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': getToken()
                        },
                        body: new URLSearchParams({ phone })
                    });

                    const data = await res.json().catch(() => ({ ok: false, message: 'Lỗi parse' }));
                    msg2.textContent = data.message || (data.ok ? 'Đã gửi OTP.' : 'Gửi OTP thất bại.');
                });

                btnVerify.addEventListener('click', async () => {
                    msg2.textContent = 'Đang xác thực...';
                    const code = (otpInput.value || '').trim();

                    const res = await fetch('/Sms/verify', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': getToken()
                        },
                        body: new URLSearchParams({ code })
                    });

                    const data = await res.json().catch(() => ({ ok: false, message: 'Lỗi parse' }));
                    if (!data.ok) {
                        msg2.textContent = data.message || 'OTP sai.';
                        return;
                    }

                    msg2.textContent = '✅ Xác thực thành công. Đã bật SMS cảnh báo.';
                    setTimeout(() => location.href = '/Profile', 600);
                });
            })();
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
