                        <span><kbd>Esc</kbd> Đóng</span>
                        <span><kbd>Ctrl</kbd><kbd>K</kbd> Tìm nhanh</span>
                    </div>

                    <div class="elx-cmdk-body" id="elxCmdkResults">
