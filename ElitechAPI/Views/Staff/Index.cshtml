<!-- Floating quick buttons -->
<div class="floating-quick">
    <a href="/ElitechRealtime" title="Realtime">
        <i class="bi bi-lightning-charge-fill"></i>
    </a>
    <a href="/ElitechHistoryPage" title="History">
        <i class="bi bi-graph-up-arrow"></i>
    </a>
    <a href="/ElitechAlertRulesPage" title="Alert Rules">
        <i class="bi bi-bell-fill"></i>
    </a>
</div>

<script>
    const STAFF_DEVICE_GUIDS = "@guidString";

    async function loadRealtime() {
        try {
            const guids = STAFF_DEVICE_GUIDS;

            if (!guids) {
                document.getElementById("onlineCount").innerText = "0";
                document.getElementById("alertCount").innerText = "0";
                return;
            }

            const res = await fetch(`/api/elitech/realtime?deviceGuids=${encodeURIComponent(guids)}`, {
                cache: "no-store"
            });

            const json = await res.json();

            let online = 0;
            let alert = 0;

            if (json && json.data && Array.isArray(json.data)) {
                json.data.forEach(d => {
                    if (Number(d.signal || 0) > 0) online++;
                    if (d.alarmState === true || d.alarmState === 1 || d.alarmState === "true") alert++;
                });
            }

            document.getElementById("onlineCount").innerText = online;
            document.getElementById("alertCount").innerText = alert;

        } catch (e) {
            console.error("Realtime load failed:", e);
        }
    }

    setInterval(loadRealtime, 5000);
    loadRealtime();
</script>
