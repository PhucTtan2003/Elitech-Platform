@{
    ViewData["Title"] = "Staff Dashboard";

    var devicesRaw = ViewBag.Devices as IEnumerable<Elitech.Models.ElitechDeviceAssignment>;
    var devices = devicesRaw?.ToList() ?? new List<Elitech.Models.ElitechDeviceAssignment>();

    var deviceCount = ViewBag.DeviceCount ?? devices.Count;
    var username = User.Identity?.Name ?? "Staff";

    var guidString = string.Join(",", devices.Select(x => x.DeviceGuid));
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    :root {
        --staff-navy-950: #071226;
        --staff-navy-900: #0b1833;
        --staff-navy-850: #10204a;
        --staff-navy-800: #142b63;
        --staff-blue: #2563eb;
        --staff-blue-2: #38bdf8;
        --staff-orange: #f58220;
        --staff-orange-2: #ffb25b;
        --staff-green: #22c55e;
        --staff-red: #ef4444;
        --staff-yellow: #f59e0b;
        --staff-text: #0f172a;
        --staff-muted: #64748b;
        --staff-card: rgba(255,255,255,.78);
        --staff-border: rgba(255,255,255,.65);
        --staff-shadow: 0 28px 80px rgba(15, 23, 42, .18);
    }

    body {
        background: radial-gradient(900px 420px at 8% 0%, rgba(37, 99, 235, .20), transparent 55%), radial-gradient(900px 460px at 92% 8%, rgba(245, 130, 32, .18), transparent 55%), linear-gradient(180deg, #eef4ff 0%, #f8fafc 46%, #eef3fb 100%) !important;
    }

    .staff-page {
        position: relative;
        overflow: hidden;
        padding-bottom: 34px;
    }

        .staff-page::before {
            content: "";
            position: absolute;
            inset: -120px -80px auto auto;
            width: 420px;
            height: 420px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(245,130,32,.26), transparent 68%);
            filter: blur(4px);
            pointer-events: none;
        }

        .staff-page::after {
            content: "";
            position: absolute;
            left: -160px;
            top: 180px;
            width: 380px;
            height: 380px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(56,189,248,.22), transparent 70%);
            filter: blur(6px);
            pointer-events: none;
        }

    .staff-shell {
        position: relative;
        z-index: 2;
    }

    .staff-hero {
        position: relative;
        overflow: hidden;
        border-radius: 34px;
        min-height: 285px;
        padding: 30px;
        background: radial-gradient(900px 380px at 85% 0%, rgba(245,130,32,.36), transparent 48%), radial-gradient(720px 380px at 5% 0%, rgba(56,189,248,.28), transparent 58%), linear-gradient(135deg, rgba(7,18,38,.98), rgba(16,43,99,.96));
        color: #fff;
        box-shadow: 0 34px 95px rgba(7,18,38,.34);
        border: 1px solid rgba(255,255,255,.16);
    }

        .staff-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.045) 1px, transparent 1px);
            background-size: 44px 44px;
            mask-image: linear-gradient(90deg, rgba(0,0,0,.85), transparent 92%);
            pointer-events: none;
        }

        .staff-hero::after {
            content: "";
            position: absolute;
            width: 360px;
            height: 360px;
            right: -120px;
            top: -120px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,.20);
            box-shadow: inset 0 0 0 28px rgba(255,255,255,.035), inset 0 0 0 58px rgba(255,255,255,.025), 0 0 80px rgba(245,130,32,.28);
            pointer-events: none;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .staff-kicker {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        color: rgba(255,255,255,.88);
        font-weight: 800;
        font-size: .82rem;
        letter-spacing: .04em;
        backdrop-filter: blur(16px);
    }

        .staff-kicker i {
            color: var(--staff-orange-2);
        }

    .hero-title {
        max-width: 760px;
        margin-top: 18px;
        font-size: clamp(2.1rem, 4vw, 4.4rem);
        font-weight: 950;
        line-height: .98;
        letter-spacing: -0.06em;
    }

        .hero-title span {
            background: linear-gradient(90deg, #fff, #dbeafe 42%, #ffb25b 78%, #f58220);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .hero-sub {
        max-width: 690px;
        margin-top: 16px;
        color: rgba(226,232,240,.86);
        font-size: 1rem;
        line-height: 1.75;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 22px;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        text-decoration: none;
        border-radius: 999px;
        padding: 11px 16px;
        font-weight: 900;
        border: 1px solid rgba(255,255,255,.16);
        transition: .22s ease;
    }

    .hero-btn-primary {
        background: linear-gradient(135deg, var(--staff-orange), #ffba6a);
        color: #111827;
        box-shadow: 0 18px 38px rgba(245,130,32,.28);
    }

    .hero-btn-ghost {
        background: rgba(255,255,255,.10);
        color: #fff;
        backdrop-filter: blur(16px);
    }

    .hero-btn:hover {
        transform: translateY(-3px);
        color: inherit;
    }

    .hero-orb {
        position: absolute;
        right: 34px;
        bottom: 26px;
        width: 270px;
        height: 160px;
        border-radius: 28px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(18px);
        box-shadow: 0 22px 60px rgba(0,0,0,.22);
        z-index: 2;
        overflow: hidden;
        padding: 18px;
    }

        .hero-orb::before {
            content: "";
            position: absolute;
            inset: -60px -40px auto auto;
            width: 150px;
            height: 150px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(245,130,32,.8), transparent 66%);
        }

    .signal-grid {
        position: relative;
        z-index: 2;
        height: 78px;
        display: flex;
        align-items: end;
        gap: 8px;
        margin-top: 14px;
    }

    .signal-bar {
        flex: 1;
        min-width: 12px;
        border-radius: 999px 999px 8px 8px;
        background: linear-gradient(180deg, rgba(56,189,248,.95), rgba(37,99,235,.42));
        box-shadow: 0 0 22px rgba(56,189,248,.26);
        animation: staffWave 2.2s ease-in-out infinite;
    }

        .signal-bar:nth-child(2) {
            animation-delay: .14s;
        }

        .signal-bar:nth-child(3) {
            animation-delay: .28s;
            background: linear-gradient(180deg, #ffb25b, rgba(245,130,32,.45));
        }

        .signal-bar:nth-child(4) {
            animation-delay: .42s;
        }

        .signal-bar:nth-child(5) {
            animation-delay: .56s;
        }

        .signal-bar:nth-child(6) {
            animation-delay: .70s;
            background: linear-gradient(180deg, #ffb25b, rgba(245,130,32,.45));
        }

        .signal-bar:nth-child(7) {
            animation-delay: .84s;
        }

    @@keyframes staffWave {
        0%, 100% {
            transform: scaleY(.78);
            opacity: .74;
        }

        50% {
            transform: scaleY(1.08);
            opacity: 1;
        }
    }

    .orb-title {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: rgba(255,255,255,.92);
        font-weight: 900;
        font-size: .9rem;
    }

    .live-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #22c55e;
        box-shadow: 0 0 0 0 rgba(34,197,94,.75);
        animation: livePulse 1.4s infinite;
    }

    @@keyframes livePulse {
        70% {
            box-shadow: 0 0 0 11px rgba(34,197,94,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(34,197,94,0);
        }
    }

    .metric-strip {
        margin-top: -42px;
        position: relative;
        z-index: 4;
    }

    .metric-card {
        min-height: 155px;
        border-radius: 28px;
        padding: 22px;
        background: var(--staff-card);
        border: 1px solid var(--staff-border);
        box-shadow: var(--staff-shadow);
        backdrop-filter: blur(20px) saturate(170%);
        transition: .25s ease;
        position: relative;
        overflow: hidden;
    }

        .metric-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 34px 80px rgba(15, 23, 42, .22);
        }

        .metric-card::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -62px;
            bottom: -76px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(37,99,235,.22), transparent 70%);
        }

        .metric-card.orange::after {
            background: radial-gradient(circle, rgba(245,130,32,.26), transparent 70%);
        }

        .metric-card.green::after {
            background: radial-gradient(circle, rgba(34,197,94,.22), transparent 70%);
        }

    .metric-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .metric-icon {
        width: 48px;
        height: 48px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #38bdf8);
        box-shadow: 0 14px 30px rgba(37,99,235,.24);
        font-size: 1.25rem;
    }

    .metric-card.orange .metric-icon {
        background: linear-gradient(135deg, #f58220, #ffb25b);
        box-shadow: 0 14px 30px rgba(245,130,32,.24);
    }

    .metric-card.green .metric-icon {
        background: linear-gradient(135deg, #16a34a, #86efac);
        box-shadow: 0 14px 30px rgba(22,163,74,.24);
    }

    .metric-label {
        color: var(--staff-muted);
        font-weight: 800;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .metric-number {
        position: relative;
        z-index: 2;
        margin-top: 16px;
        font-size: 2.6rem;
        line-height: 1;
        font-weight: 950;
        letter-spacing: -.05em;
        color: var(--staff-text);
    }

    .metric-foot {
        position: relative;
        z-index: 2;
        margin-top: 10px;
        color: #64748b;
        font-weight: 700;
        font-size: .86rem;
    }

    .section-title-row {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 16px;
        margin: 30px 0 14px;
    }

    .section-kicker {
        color: var(--staff-orange);
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .12em;
        font-size: .74rem;
    }

    .section-title {
        margin: 4px 0 0;
        font-size: 1.55rem;
        font-weight: 950;
        letter-spacing: -.04em;
        color: var(--staff-text);
    }

    .staff-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 9px 13px;
        background: rgba(255,255,255,.72);
        border: 1px solid rgba(226,232,240,.95);
        color: #334155;
        font-weight: 850;
        box-shadow: 0 14px 30px rgba(15,23,42,.08);
        backdrop-filter: blur(16px);
    }

    .action-card {
        position: relative;
        display: block;
        min-height: 190px;
        padding: 22px;
        border-radius: 30px;
        overflow: hidden;
        text-decoration: none;
        color: #fff;
        background: radial-gradient(260px 150px at 80% 0%, rgba(255,255,255,.18), transparent 62%), linear-gradient(145deg, #0b1833, #142b63);
        border: 1px solid rgba(255,255,255,.13);
        box-shadow: 0 24px 65px rgba(15,23,42,.18);
        transition: .25s ease;
    }

        .action-card:hover {
            transform: translateY(-8px) scale(1.01);
            color: #fff;
            box-shadow: 0 34px 90px rgba(15,23,42,.24);
        }

        .action-card.orange {
            background: radial-gradient(260px 150px at 80% 0%, rgba(255,255,255,.20), transparent 62%), linear-gradient(145deg, #7c2d12, #f58220);
        }

        .action-card.blue {
            background: radial-gradient(260px 150px at 80% 0%, rgba(255,255,255,.20), transparent 62%), linear-gradient(145deg, #0f2e6e, #2563eb);
        }

        .action-card.cyan {
            background: radial-gradient(260px 150px at 80% 0%, rgba(255,255,255,.20), transparent 62%), linear-gradient(145deg, #164e63, #0891b2);
        }

        .action-card.dark {
            background: radial-gradient(260px 150px at 80% 0%, rgba(245,130,32,.25), transparent 62%), linear-gradient(145deg, #071226, #111827);
        }

    .action-icon {
        width: 54px;
        height: 54px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(16px);
        font-size: 1.55rem;
        margin-bottom: 18px;
    }

    .action-title {
        font-size: 1.05rem;
        font-weight: 950;
        margin-bottom: 8px;
    }

    .action-desc {
        color: rgba(255,255,255,.76);
        font-weight: 600;
        font-size: .86rem;
        line-height: 1.55;
        max-width: 250px;
    }

    .action-arrow {
        position: absolute;
        right: 18px;
        bottom: 18px;
        width: 38px;
        height: 38px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.16);
        transition: .22s ease;
    }

    .action-card:hover .action-arrow {
        transform: translateX(4px);
        background: rgba(255,255,255,.25);
    }

    .panel-card {
        border-radius: 32px;
        background: rgba(255,255,255,.78);
        border: 1px solid rgba(255,255,255,.72);
        box-shadow: var(--staff-shadow);
        backdrop-filter: blur(22px) saturate(170%);
        overflow: hidden;
    }

    .panel-head {
        padding: 22px 24px;
        border-bottom: 1px solid rgba(226,232,240,.9);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        background: radial-gradient(500px 180px at 100% 0%, rgba(245,130,32,.13), transparent 55%), rgba(255,255,255,.55);
    }

        .panel-head h5 {
            margin: 0;
            font-weight: 950;
            letter-spacing: -.03em;
            color: var(--staff-text);
        }

    .panel-body {
        padding: 18px;
    }

    .device-item {
        display: grid;
        grid-template-columns: 46px 1fr auto;
        gap: 14px;
        align-items: center;
        padding: 15px;
        border-radius: 24px;
        background: rgba(248,250,252,.86);
        border: 1px solid rgba(226,232,240,.9);
        transition: .2s ease;
        margin-bottom: 12px;
    }

        .device-item:hover {
            transform: translateY(-3px);
            background: #fff;
            box-shadow: 0 18px 42px rgba(15,23,42,.10);
        }

    .device-avatar {
        width: 46px;
        height: 46px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #0f2e6e, #38bdf8);
        color: #fff;
        box-shadow: 0 14px 28px rgba(37,99,235,.20);
    }

    .device-name {
        font-weight: 950;
        color: var(--staff-text);
        line-height: 1.2;
    }

    .device-guid {
        color: #64748b;
        font-weight: 700;
        font-size: .78rem;
        margin-top: 4px;
        word-break: break-all;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        padding: 8px 11px;
        font-weight: 950;
        font-size: .78rem;
        background: rgba(34,197,94,.12);
        color: #15803d;
        border: 1px solid rgba(34,197,94,.25);
    }

        .status-pill::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: #22c55e;
            box-shadow: 0 0 0 4px rgba(34,197,94,.13);
        }

    .insight-card {
        min-height: 100%;
        border-radius: 32px;
        background: radial-gradient(420px 220px at 100% 0%, rgba(37,99,235,.12), transparent 58%), rgba(255,255,255,.78);
        border: 1px solid rgba(255,255,255,.72);
        box-shadow: var(--staff-shadow);
        backdrop-filter: blur(22px) saturate(170%);
        padding: 24px;
    }

    .mini-map {
        height: 195px;
        border-radius: 26px;
        background: linear-gradient(90deg, rgba(37,99,235,.10) 1px, transparent 1px), linear-gradient(180deg, rgba(37,99,235,.10) 1px, transparent 1px), radial-gradient(circle at 30% 40%, rgba(245,130,32,.28), transparent 8%), radial-gradient(circle at 68% 62%, rgba(56,189,248,.32), transparent 9%), linear-gradient(135deg, #f8fafc, #eaf1ff);
        background-size: 24px 24px, 24px 24px, auto, auto, auto;
        border: 1px solid rgba(226,232,240,.9);
        position: relative;
        overflow: hidden;
    }

    .map-route {
        position: absolute;
        inset: 40px 48px;
        border: 3px dashed rgba(37,99,235,.32);
        border-left-color: transparent;
        border-bottom-color: rgba(245,130,32,.38);
        border-radius: 46% 54% 51% 49%;
        transform: rotate(-8deg);
    }

    .map-pin {
        position: absolute;
        width: 18px;
        height: 18px;
        border-radius: 999px;
        background: var(--staff-orange);
        box-shadow: 0 0 0 8px rgba(245,130,32,.17), 0 12px 28px rgba(245,130,32,.34);
    }

        .map-pin.one {
            left: 30%;
            top: 38%;
        }

        .map-pin.two {
            right: 26%;
            bottom: 31%;
            background: #2563eb;
            box-shadow: 0 0 0 8px rgba(37,99,235,.16), 0 12px 28px rgba(37,99,235,.26);
        }

    .empty-state {
        padding: 46px 20px;
        text-align: center;
        border-radius: 28px;
        background: rgba(248,250,252,.76);
        border: 1px dashed rgba(148,163,184,.65);
    }

    .empty-icon {
        width: 74px;
        height: 74px;
        margin: 0 auto 14px;
        border-radius: 26px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, rgba(37,99,235,.14), rgba(245,130,32,.16));
        color: #0f2e6e;
        font-size: 2rem;
    }

    .empty-title {
        font-weight: 950;
        color: var(--staff-text);
        margin-bottom: 6px;
    }

    .empty-sub {
        color: #64748b;
        font-weight: 700;
    }

    .floating-quick {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 20;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .floating-quick a {
            width: 52px;
            height: 52px;
            border-radius: 20px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, #0b1833, #142b63);
            color: #fff;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,.18);
            box-shadow: 0 18px 42px rgba(15,23,42,.28);
            transition: .2s ease;
        }

            .floating-quick a:hover {
                transform: translateY(-4px);
                color: #fff;
            }

            .floating-quick a:first-child {
                background: linear-gradient(135deg, #f58220, #ffb25b);
                color: #111827;
            }

    @@media (max-width: 1199.98px) {
        .hero-orb {
            position: relative;
            right: auto;
            bottom: auto;
            margin-top: 24px;
            width: 100%;
            max-width: 360px;
        }

        .metric-strip {
            margin-top: 18px;
        }
    }

    @@media (max-width: 767.98px) {
        .staff-hero {
            border-radius: 26px;
            padding: 24px;
        }

        .hero-title {
            font-size: 2.35rem;
        }

        .section-title-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .device-item {
            grid-template-columns: 42px 1fr;
        }

            .device-item .status-pill {
                grid-column: 1 / -1;
                width: fit-content;
            }

        .floating-quick {
            right: 14px;
            bottom: 14px;
        }
    }
</style>

<div class="staff-page">
    <div class="staff-shell">

        <!-- HERO -->
        <section class="staff-hero">
            <div class="hero-content">
                <div class="staff-kicker">
                    <i class="bi bi-shield-check"></i>
                    ELITECH STAFF CONTROL CENTER
                </div>

                <h1 class="hero-title">
                    Xin chào, <span>@username</span>
                </h1>

                <p class="hero-sub">
                    Trung tâm vận hành dành cho Staff: theo dõi thiết bị, kiểm tra realtime, xem lịch sử dữ liệu,
                    xử lý cảnh báo và giám sát hệ thống theo phong cách nhanh, gọn, trực quan.
                </p>

                <div class="hero-actions">
                    <a href="/ElitechRealtime" class="hero-btn hero-btn-primary">
                        <i class="bi bi-lightning-charge-fill"></i>
                        Mở Realtime
                    </a>

                    <a href="/ElitechHistoryPage" class="hero-btn hero-btn-ghost">
                        <i class="bi bi-graph-up-arrow"></i>
                        Xem biểu đồ
                    </a>

                    <a href="/ElitechAlertRulesPage" class="hero-btn hero-btn-ghost">
                        <i class="bi bi-sliders"></i>
                        Cài ngưỡng
                    </a>
                </div>
            </div>

            <div class="hero-orb">
                <div class="orb-title">
                    <span>Live Signal</span>
                    <span class="live-dot"></span>
                </div>

                <div class="signal-grid">
                    <div class="signal-bar" style="height:42%;"></div>
                    <div class="signal-bar" style="height:72%;"></div>
                    <div class="signal-bar" style="height:56%;"></div>
                    <div class="signal-bar" style="height:88%;"></div>
                    <div class="signal-bar" style="height:64%;"></div>
