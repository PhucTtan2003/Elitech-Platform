        mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 70%, transparent 100%);
        -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 70%, transparent 100%);
        opacity: .52;
    }

    .hf-max-hero::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
