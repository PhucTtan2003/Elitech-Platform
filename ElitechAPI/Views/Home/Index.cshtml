@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_Layout";
    var isLoggedIn = User?.Identity?.IsAuthenticated == true;
}

<style>
    /* =========================================================
                   ELITECH HOME - CLEAN COMMAND CENTER FIX
                   Sửa lỗi bản trước: không còn nền chia 52%, không còn chữ tối nằm trên nền đen,
                   card gọn hơn, bố cục rõ hơn, vẫn giữ vibe Apple / Command Center.
                   ========================================================= */

    :root {
        --hf-orange: #f58220;
        --hf-orange-2: #ffb25b;
        --hf-blue: #0a84ff;
        --hf-blue-2: #38bdf8;
        --hf-green: #22c55e;
        --hf-dark: #05070b;
        --hf-dark-2: #0b1220;
        --hf-text: #0f172a;
        --hf-muted: #64748b;
        --hf-line: rgba(226,232,240,.92);
        --hf-shadow: 0 22px 60px rgba(15,23,42,.14);
        --hf-soft-shadow: 0 12px 30px rgba(15,23,42,.08);
    }

    body {
        background: #f5f7fb !important;
        color: var(--hf-text);
        overflow-x: hidden;
    }

    .home-fix {
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        background: #f5f7fb;
        color: var(--hf-text);
        overflow: hidden;
    }

    .hf-hero-zone {
        position: relative;
        color: #fff;
        background: radial-gradient(980px 560px at 12% 0%, rgba(245,130,32,.30), transparent 62%), radial-gradient(980px 560px at 88% 0%, rgba(10,132,255,.30), transparent 58%), linear-gradient(180deg, #070a10 0%, #04060a 100%);
        border-bottom: 1px solid rgba(255,255,255,.10);
    }

        .hf-hero-zone::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.04) 1px, transparent 1px);
            background-size: 72px 72px;
            pointer-events: none;
            opacity: .7;
        }

    .hf-shell {
        position: relative;
        z-index: 2;
        max-width: 1420px;
        margin: 0 auto;
        padding: 68px 22px;
    }

    .hf-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.04fr) minmax(420px, .8fr);
        gap: 46px;
        align-items: center;
        min-height: 610px;
    }

    .hf-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 9px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.16);
        color: rgba(255,255,255,.88);
        font-size: .78rem;
        font-weight: 1000;
        text-transform: uppercase;
        letter-spacing: .13em;
    }

        .hf-eyebrow i {
            color: var(--hf-orange-2);
        }

    .hf-title {
        max-width: 880px;
        margin: 24px 0 0;
        color: #fff;
        font-size: clamp(3.6rem, 7vw, 8rem);
        line-height: .88;
        font-weight: 1000;
        letter-spacing: -.08em;
    }

        .hf-title span {
            background: linear-gradient(90deg, #fff 0%, #dbeafe 36%, #ffb25b 72%, #f58220 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .hf-lead {
        max-width: 780px;
        margin: 24px 0 0;
        color: rgba(226,232,240,.80);
        font-size: clamp(1rem, 1.35vw, 1.18rem);
        line-height: 1.72;
        font-weight: 760;
    }

    .hf-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 13px;
        margin-top: 28px;
    }

    .hf-btn {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 22px;
        border-radius: 999px;
        text-decoration: none !important;
        font-weight: 1000;
        border: 1px solid rgba(255,255,255,.16);
        transition: .18s ease;
    }

        .hf-btn:hover {
            transform: translateY(-3px);
        }

        .hf-btn.blue {
            color: #fff;
            background: linear-gradient(135deg, #0a84ff, #38bdf8);
            border: 0;
            box-shadow: 0 20px 52px rgba(10,132,255,.28);
        }

        .hf-btn.white {
            color: #06111f;
            background: linear-gradient(135deg, #fff, #f8fafc);
            box-shadow: 0 18px 48px rgba(255,255,255,.12);
        }

        .hf-btn.dark {
            color: #fff;
            background: rgba(255,255,255,.09);
        }

    .hf-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 26px;
    }

    .hf-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.14);
        color: rgba(226,232,240,.78);
        font-size: .82rem;
        font-weight: 900;
    }

        .hf-pill i {
            color: var(--hf-orange-2);
        }

    .hf-deck-wrap {
        position: relative;
    }

    .hf-deck {
        position: relative;
        border-radius: 40px;
        padding: 24px;
        background: radial-gradient(560px 260px at 100% 0%, rgba(245,130,32,.28), transparent 62%), linear-gradient(145deg, rgba(255,255,255,.16), rgba(255,255,255,.055));
        border: 1px solid rgba(255,255,255,.20);
        box-shadow: 0 30px 90px rgba(2,6,23,.32);
        overflow: hidden;
    }

        .hf-deck::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 42px 42px;
            opacity: .5;
            pointer-events: none;
        }

    .hf-deck-inner {
        position: relative;
        z-index: 2;
    }

    .hf-deck-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(255,255,255,.13);
    }

    .hf-mark {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .hf-logo-dot {
        width: 52px;
        height: 52px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: #08111f;
        background: linear-gradient(135deg, var(--hf-orange), var(--hf-orange-2));
        box-shadow: 0 18px 35px rgba(245,130,32,.28);
        font-size: 1.35rem;
    }

    .hf-deck-name {
        color: #fff;
        font-size: 1.18rem;
        font-weight: 1000;
        letter-spacing: -.04em;
    }

    .hf-deck-sub {
        margin-top: 3px;
        color: rgba(226,232,240,.62);
        font-size: .82rem;
        font-weight: 850;
    }

    .hf-live {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        border-radius: 999px;
        color: rgba(255,255,255,.9);
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.14);
        font-weight: 1000;
        font-size: .82rem;
    }

    .hf-live-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--hf-green);
        box-shadow: 0 0 0 8px rgba(34,197,94,.14);
    }

    .hf-deck-grid {
        display: grid;
        grid-template-columns: 1.16fr .84fr;
        gap: 14px;
        margin-top: 18px;
    }

    .hf-status-card,
    .hf-side-card,
    .hf-tile {
        border-radius: 28px;
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.13);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.05);
    }

    .hf-status-card {
        min-height: 250px;
        padding: 22px;
    }

    .hf-kicker {
        color: rgba(226,232,240,.62);
        font-size: .72rem;
        font-weight: 1000;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .hf-temp-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 10px;
    }

    .hf-temp {
        color: #fff;
        font-size: 3rem;
        line-height: 1;
        font-weight: 1000;
        letter-spacing: -.06em;
    }

        .hf-temp small {
            font-size: 1rem;
            color: rgba(226,232,240,.7);
        }

    .hf-stable {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 10px;
        border-radius: 999px;
        color: #dcfce7;
        background: rgba(34,197,94,.18);
        border: 1px solid rgba(34,197,94,.20);
        font-size: .78rem;
        font-weight: 1000;
    }

    .hf-chart {
        height: 128px;
        margin-top: 20px;
        border-radius: 22px;
        padding: 16px 12px 11px;
        display: flex;
        align-items: end;
        gap: 8px;
        background: linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.055) 1px, transparent 1px), linear-gradient(180deg, rgba(10,132,255,.22), rgba(10,132,255,.05));
        background-size: 28px 28px, 28px 28px, auto;
    }

    .hf-bar {
        flex: 1;
        min-width: 18px;
        border-radius: 999px 999px 8px 8px;
        background: linear-gradient(180deg, #e5eef8, #0a84ff);
        box-shadow: 0 8px 24px rgba(10,132,255,.22);
    }

        .hf-bar.orange {
            background: linear-gradient(180deg, #ffb25b, #f58220);
        }

    .hf-side-stack {
        display: grid;
        gap: 14px;
    }

    .hf-side-card {
        min-height: 76px;
        padding: 18px;
    }

        .hf-side-card b {
            display: block;
            color: #fff;
            font-size: 1.25rem;
            font-weight: 1000;
            letter-spacing: -.04em;
        }

        .hf-side-card span {
            display: block;
            margin-top: 4px;
            color: rgba(226,232,240,.62);
            font-size: .82rem;
            font-weight: 850;
        }

        .hf-side-card.hot {
            background: linear-gradient(135deg, rgba(245,130,32,.34), rgba(255,255,255,.07));
        }

    .hf-bottom-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-top: 14px;
    }

    .hf-tile {
        min-height: 94px;
        padding: 18px;
    }

        .hf-tile i {
            color: var(--hf-orange-2);
            font-size: 1.15rem;
        }

        .hf-tile b {
            display: block;
            margin-top: 12px;
            color: #fff;
            font-size: 1rem;
            font-weight: 1000;
        }

        .hf-tile span {
            display: block;
            margin-top: 4px;
            color: rgba(226,232,240,.62);
            font-size: .75rem;
            font-weight: 850;
        }

    .hf-light-zone {
        background: #f5f7fb;
        color: var(--hf-text);
    }

    .hf-light-shell {
        max-width: 1420px;
        margin: 0 auto;
        padding: 38px 22px 62px;
    }

    .hf-kpi-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-top: -72px;
        margin-bottom: 38px;
        position: relative;
        z-index: 5;
    }

    .hf-kpi {
        border-radius: 26px;
        padding: 22px;
        background: #fff;
        border: 1px solid var(--hf-line);
        box-shadow: var(--hf-shadow);
        overflow: hidden;
        position: relative;
    }

        .hf-kpi::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -80px;
            bottom: -86px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(10,132,255,.15), transparent 72%);
        }

        .hf-kpi.orange::after {
            background: radial-gradient(circle, rgba(245,130,32,.20), transparent 72%);
        }

    .hf-kpi-label {
        position: relative;
        z-index: 2;
        color: var(--hf-muted);
        font-size: .74rem;
        font-weight: 1000;
        text-transform: uppercase;
        letter-spacing: .12em;
    }

    .hf-kpi-num {
        position: relative;
        z-index: 2;
        margin-top: 8px;
        font-size: 2.25rem;
        line-height: 1;
        font-weight: 1000;
        letter-spacing: -.055em;
    }

    .hf-kpi-sub {
        position: relative;
        z-index: 2;
        margin-top: 8px;
        color: var(--hf-muted);
        font-size: .86rem;
        font-weight: 780;
    }

    .hf-section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 18px;
        margin: 42px 0 18px;
    }

    .hf-section-eyebrow {
        color: var(--hf-orange);
        font-size: .76rem;
        font-weight: 1000;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .hf-section-title {
        margin: 5px 0 0;
        max-width: 760px;
        font-size: clamp(2rem, 3.6vw, 4rem);
        line-height: .98;
        font-weight: 1000;
        letter-spacing: -.065em;
        color: var(--hf-text);
    }

    .hf-section-desc {
        max-width: 500px;
        color: var(--hf-muted);
        font-weight: 760;
        line-height: 1.64;
    }

    .hf-feature-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .hf-feature {
        min-height: 218px;
        border-radius: 28px;
        padding: 22px;
        background: #fff;
        border: 1px solid var(--hf-line);
        box-shadow: var(--hf-soft-shadow);
        transition: .18s ease;
        overflow: hidden;
        position: relative;
    }

        .hf-feature:hover {
            transform: translateY(-4px);
            box-shadow: 0 24px 56px rgba(15,23,42,.14);
        }

        .hf-feature::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: -110px;
            top: -110px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(10,132,255,.14), transparent 72%);
        }

        .hf-feature:nth-child(2)::after,
        .hf-feature:nth-child(5)::after {
            background: radial-gradient(circle, rgba(245,130,32,.18), transparent 72%);
        }

    .hf-feature-icon {
        position: relative;
        z-index: 2;
        width: 54px;
        height: 54px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: #fff;
        background: linear-gradient(135deg, #0f172a, #2563eb);
        box-shadow: 0 14px 30px rgba(37,99,235,.18);
        font-size: 1.3rem;
    }

    .hf-feature:nth-child(2) .hf-feature-icon,
    .hf-feature:nth-child(5) .hf-feature-icon {
        color: #08111f;
        background: linear-gradient(135deg, var(--hf-orange), var(--hf-orange-2));
    }

    .hf-feature h3 {
        position: relative;
        z-index: 2;
        margin: 22px 0 0;
        font-size: 1.18rem;
        font-weight: 1000;
        letter-spacing: -.035em;
        color: var(--hf-text);
    }

    .hf-feature p {
        position: relative;
        z-index: 2;
        margin: 10px 0 0;
        color: var(--hf-muted);
        line-height: 1.58;
        font-weight: 760;
    }

    .hf-flow {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
    }

    .hf-step {
        border-radius: 24px;
        padding: 19px;
        background: #fff;
        border: 1px solid var(--hf-line);
        box-shadow: 0 12px 30px rgba(15,23,42,.07);
    }

    .hf-step-num {
        width: 40px;
        height: 40px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        color: #fff;
        background: #0f172a;
        font-weight: 1000;
        margin-bottom: 16px;
    }

    .hf-step b {
        display: block;
        color: var(--hf-text);
        font-size: .98rem;
        font-weight: 1000;
    }

    .hf-step span {
        display: block;
        margin-top: 7px;
        color: var(--hf-muted);
        font-size: .84rem;
        line-height: 1.48;
        font-weight: 760;
    }

    .hf-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-top: 34px;
    }

    .hf-panel {
        min-height: 330px;
        border-radius: 32px;
        padding: 28px;
        overflow: hidden;
        position: relative;
        box-shadow: var(--hf-shadow);
    }

        .hf-panel.dark {
            color: #fff;
            background: radial-gradient(600px 260px at 88% 0%, rgba(245,130,32,.28), transparent 60%), linear-gradient(145deg, #070a10, #101827);
            border: 1px solid rgba(255,255,255,.14);
        }

        .hf-panel.light {
            color: var(--hf-text);
            background: #fff;
            border: 1px solid var(--hf-line);
        }

    .hf-panel-title {
        font-size: clamp(1.9rem, 3.5vw, 3.5rem);
        line-height: .98;
        font-weight: 1000;
        letter-spacing: -.065em;
        margin: 0;
    }

    .hf-panel-text {
        max-width: 560px;
        margin: 16px 0 0;
        color: inherit;
        opacity: .72;
        line-height: 1.62;
        font-weight: 760;
    }

    .hf-list {
        display: grid;
        gap: 10px;
        margin-top: 24px;
    }

    .hf-list-item {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 13px;
        border-radius: 19px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.12);
    }

    .hf-panel.light .hf-list-item {
        background: #f8fafc;
        border-color: rgba(226,232,240,.92);
    }

    .hf-list-item i {
        color: var(--hf-orange-2);
        margin-top: 3px;
    }

    .hf-list-item b {
        display: block;
        font-weight: 1000;
    }

    .hf-list-item span {
        display: block;
        margin-top: 3px;
        opacity: .68;
        font-size: .86rem;
        font-weight: 760;
    }

    .hf-cta {
        margin-top: 40px;
        border-radius: 36px;
        padding: clamp(34px, 5vw, 66px);
        text-align: center;
        color: #fff;
        background: radial-gradient(760px 330px at 10% 0%, rgba(10,132,255,.34), transparent 60%), radial-gradient(760px 330px at 90% 100%, rgba(245,130,32,.34), transparent 62%), linear-gradient(145deg, #06111f, #111827);
        border: 1px solid rgba(255,255,255,.14);
        box-shadow: 0 28px 80px rgba(2,6,23,.22);
    }

        .hf-cta h2 {
            max-width: 860px;
            margin: 0 auto;
            font-size: clamp(2.2rem, 4.8vw, 5rem);
            line-height: .94;
            font-weight: 1000;
            letter-spacing: -.07em;
        }

        .hf-cta p {
            max-width: 720px;
            margin: 18px auto 0;
            color: rgba(226,232,240,.72);
            font-weight: 760;
            line-height: 1.66;
        }

        .hf-cta .hf-actions {
            justify-content: center;
        }



    /* =========================================================
               APPLE STYLE VIDEO HERO - HOME PAGE
               Video đặt tại: wwwroot/videos/home-hero.mp4
               Poster đặt tại: wwwroot/videos/home-hero-poster.jpg
               ========================================================= */

    .hf-video-hero-zone {
        min-height: calc(100vh - 56px);
        overflow: hidden;
        isolation: isolate;
        background: #000 !important;
        display: flex;
        align-items: center;
    }

    .hf-hero-video {
        position: absolute;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.015);
        filter: saturate(1.05) contrast(1.03);
    }

    .hf-video-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: radial-gradient(900px 560px at 72% 38%, rgba(10,132,255,.24), transparent 64%), radial-gradient(820px 520px at 22% 32%, rgba(245,130,32,.22), transparent 62%), linear-gradient(90deg, rgba(0,0,0,.78) 0%, rgba(0,0,0,.50) 42%, rgba(0,0,0,.32) 100%), linear-gradient(180deg, rgba(0,0,0,.18) 0%, rgba(0,0,0,.42) 58%, rgba(0,0,0,.86) 100%);
    }

    .hf-video-hero-zone::before {
        z-index: 1;
        opacity: .42;
        background: linear-gradient(90deg, rgba(255,255,255,.075) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.070) 1px, transparent 1px);
        background-size: 72px 72px;
        mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 68%, transparent 100%);
        -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 68%, transparent 100%);
    }

    .hf-video-hero-zone::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 190px;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(180deg, transparent 0%, rgba(245,247,251,.62) 68%, #f5f7fb 100%);
    }

    .hf-video-hero-zone .hf-shell {
        width: 100%;
        padding-top: clamp(54px, 7vw, 96px);
        padding-bottom: clamp(108px, 12vw, 150px);
    }

    .hf-video-hero-zone .hf-hero {
        min-height: calc(100vh - 240px);
    }

    .hf-video-hero-zone .hf-eyebrow,
    .hf-video-hero-zone .hf-pill,
    .hf-video-hero-zone .hf-btn.dark {
        backdrop-filter: blur(18px) saturate(140%);
        -webkit-backdrop-filter: blur(18px) saturate(140%);
        background: rgba(255,255,255,.105);
        border-color: rgba(255,255,255,.17);
    }

    .hf-video-hero-zone .hf-title {
        text-shadow: 0 24px 80px rgba(0,0,0,.48);
    }

    .hf-video-hero-zone .hf-lead {
        color: rgba(245,245,247,.84);
        text-shadow: 0 14px 40px rgba(0,0,0,.42);
