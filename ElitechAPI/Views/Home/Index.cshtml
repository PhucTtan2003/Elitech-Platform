@section Scripts {

    <script>
        // Chỉ điều khiển video hero homepage, không đụng layout/audio alarm.
        (function() {
            const video = document.getElementById("hfHomeHeroVideo");
            const btn = document.getElementById("hfHomeVideoToggle");
            if (!video || !btn) return;

            const icon = btn.querySelector("i");

            function syncIcon() {
                if (!icon) return;
                icon.classList.toggle("bi-pause-fill", !video.paused);
                icon.classList.toggle("bi-play-fill", video.paused);
                btn.setAttribute("aria-label", video.paused ? "Play video" : "Pause video");
            }

            btn.addEventListener("click", function() {
                if (video.paused) {
                    video.play().catch(() => { });
                } else {
                    video.pause();
                }
                setTimeout(syncIcon, 40);
            });

            video.addEventListener("play", syncIcon);
            video.addEventListener("pause", syncIcon);
            syncIcon();
        })();
    </script>

    <script>
        // Counter số động khi lướt tới KPI
        (function() {
            const els = document.querySelectorAll("[data-counter]");
            if (!els.length) return;

            const ease = t => 1 - Math.pow(1 - t, 3);

            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (!entry.isIntersecting) return;

                    const el = entry.target;
                    const target = parseFloat(el.dataset.counter || "0");
                    const duration = 850;
                    const start = performance.now();

                    function tick(now) {
                        const p = Math.min((now - start) / duration, 1);
                        const val = ease(p) * target;
                        const hasDecimal = String(target).includes(".");
                        el.textContent = hasDecimal
                            ? (Math.round(val * 10) / 10).toFixed(1)
                            : Math.round(val).toString();

                        if (p < 1) requestAnimationFrame(tick);
                        else el.textContent = hasDecimal ? target.toString() : Math.round(target).toString();
                    }

                    requestAnimationFrame(tick);
                    observer.unobserve(el);
                });
            }, { threshold: 0.32 });

            els.forEach(el => {
                el.textContent = "0";
                observer.observe(el);
            });
        })();
    </script>
}
