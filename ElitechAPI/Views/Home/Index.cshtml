        background: radial-gradient(900px 520px at 68% 46%, rgba(10,132,255,.16), transparent 64%), radial-gradient(760px 480px at 12% 48%, rgba(245,130,32,.20), transparent 62%), linear-gradient(90deg, rgba(0,0,0,.86) 0%, rgba(0,0,0,.58) 38%, rgba(0,0,0,.34) 72%, rgba(0,0,0,.72) 100%), linear-gradient(180deg, rgba(0,0,0,.08) 0%, rgba(0,0,0,.34) 58%, rgba(0,0,0,.78) 100%);
    }

    .hf-max-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px), linear-gradient(180deg, rgba(255,255,255,.050) 1px, transparent 1px);
